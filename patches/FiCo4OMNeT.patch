+
+bool CanBusLogic::winsArbitration(const CanID *candidate, const CanID *current) {
+    if (candidate->getExtendedId() == current->getExtendedId()) {
+        if (candidate->getCanID() != current->getCanID())
+            return candidate->getCanID() < current->getCanID();
+        return !candidate->getRtr() && current->getRtr();
+    }
+    const unsigned int candidateBaseId = candidate->getExtendedId() ? candidate->getCanID() >> 18 : candidate->getCanID();
+    const unsigned int currentBaseId = current->getExtendedId() ? current->getCanID() >> 18 : current->getCanID();
+    if (candidateBaseId != currentBaseId)
+        return candidateBaseId < currentBaseId;
+    // A base-format frame wins the SRR/IDE arbitration bits over an extended frame.
+    return !candidate->getExtendedId();
+}
 

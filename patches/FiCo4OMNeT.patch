diff --git a/src/fico4omnet/linklayer/can/CanFrameTiming.h b/src/fico4omnet/linklayer/can/CanFrameTiming.h
new file mode 100644
index 0000000..402c4e1
--- /dev/null
+++ b/src/fico4omnet/linklayer/can/CanFrameTiming.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// CAN and CAN FD timing helpers.  FiCo4OMNeT models stuffing with the existing
+// configurable percentage approximation; it is not a bit-exact CAN PHY model.
+
+#ifndef FICO4OMNET_CANFRAMETIMING_H_
+#define FICO4OMNET_CANFRAMETIMING_H_
+
+#include "fico4omnet/base/FiCo4OMNeT_Defs.h"
+#include "fico4omnet/linklayer/can/messages/CanDataFrame_m.h"
+
+namespace FiCo4OMNeT {
+
+class CanFrameTiming {
+public:
+    static unsigned int payloadLengthForDlc(unsigned int dlc) {
+        static const unsigned int lengths[] = {0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 24, 32, 48, 64};
+        if (dlc > 15)
+            throw omnetpp::cRuntimeError("Invalid CAN DLC %u; permitted values are 0..15.", dlc);
+        return lengths[dlc];
+    }
+
+    static unsigned int dlcForPayloadLength(unsigned int length) {
+        static const unsigned int lengths[] = {0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 24, 32, 48, 64};
+        for (unsigned int dlc = 0; dlc < 16; ++dlc)
+            if (lengths[dlc] == length)
+                return dlc;
+        throw omnetpp::cRuntimeError("Invalid CAN FD payload length %u; permitted lengths are 0..8, 12, 16, 20, 24, 32, 48, and 64 bytes.", length);
+    }
+
+    static void validateFrame(const CanDataFrame& frame) {
+        const unsigned int maxId = frame.getExtendedId() ? 0x1fffffffU : 0x7ffU;
+        if (frame.getCanID() > maxId)
+            throw omnetpp::cRuntimeError("CAN identifier %u exceeds the %s identifier range.", frame.getCanID(), frame.getExtendedId() ? "29-bit" : "11-bit");
+        if (frame.getFd()) {
+            if (frame.getRtr())
+                throw omnetpp::cRuntimeError("CAN FD remote frames are not supported.");
+            if (frame.getPayloadLength() != payloadLengthForDlc(frame.getDlc()))
+                throw omnetpp::cRuntimeError("CAN FD DLC %u does not encode payload length %u.", frame.getDlc(), frame.getPayloadLength());
+        }
+        else {
+            if (frame.getBrs())
+                throw omnetpp::cRuntimeError("Bit-rate switching requires a CAN FD frame.");
+            if (frame.getPayloadLength() > 8 || frame.getDlc() > 8 || frame.getDlc() != frame.getPayloadLength())
+                throw omnetpp::cRuntimeError("Classical CAN requires DLC and payload length from 0 through 8 bytes.");
+        }
+        if (frame.getPayloadBytesArraySize() != (frame.getRtr() ? 0 : frame.getPayloadLength()))
+            throw omnetpp::cRuntimeError("CAN payload byte array size does not match payloadLength.");
+    }
+
+    static unsigned int frameBitLength(const CanDataFrame& frame, double stuffingPercentage) {
+        validateStuffing(stuffingPercentage);
+        validateFrame(frame);
+        const unsigned int payloadBits = frame.getRtr() ? 0 : frame.getPayloadLength() * 8;
+        if (!frame.getFd()) {
+            const unsigned int arbitrationExtension = frame.getExtendedId() ? 20 : 0;
+            const unsigned int base = 47 + arbitrationExtension + payloadBits;
+            const unsigned int stuffable = 34 + arbitrationExtension + payloadBits;
+            return base + stuffingBits(stuffable, stuffingPercentage);
+        }
+        // CAN FD uses CRC-17 through 16 bytes and CRC-21 for 20..64 bytes.
+        // ISO CRC stuff-count/parity and fixed stuff bits are not represented separately.
+        // This is a fixed-overhead performance approximation, not an ISO wire encoder.
+        const unsigned int crcBits = frame.getPayloadLength() <= 16 ? 17 : 21;
+        const unsigned int arbitrationExtension = frame.getExtendedId() ? 20 : 0;
+        const unsigned int base = 54 + arbitrationExtension + payloadBits + (crcBits - 17);
+        // Approximate stuffing over SOF through CRC sequence, consistent with legacy FiCo.
+        const unsigned int stuffable = 39 + arbitrationExtension + payloadBits + crcBits;
+        return base + stuffingBits(stuffable, stuffingPercentage);
+    }
+
+    static unsigned int frameOverheadBits(const CanDataFrame& frame, double stuffingPercentage) {
+        return frameBitLength(frame, stuffingPercentage) - (frame.getRtr() ? 0 : frame.getPayloadLength() * 8);
+    }
+
+    static double transmissionTime(const CanDataFrame& frame, double arbitrationBitrate,
+                                   double dataBitrate, double stuffingPercentage) {
+        if (arbitrationBitrate <= 0 || dataBitrate <= 0)
+            throw omnetpp::cRuntimeError("CAN arbitration and data bitrates must be greater than zero.");
+        const unsigned int total = frameBitLength(frame, stuffingPercentage);
+        if (!frame.getFd() || !frame.getBrs())
+            return static_cast<double>(total) / arbitrationBitrate;
+        // The BRS data phase starts after the BRS bit and ends before ACK.  Stuffing is
+        // apportioned by raw bits, which is an explicit approximation rather than PHY simulation.
+        const unsigned int crcBits = frame.getPayloadLength() <= 16 ? 17 : 21;
+        const unsigned int rawTotal = 54 + (frame.getExtendedId() ? 20 : 0)
+                + frame.getPayloadLength() * 8 + (crcBits - 17);
+        const unsigned int nominalRaw = (frame.getExtendedId() ? 40 : 20) + 12;
+        const unsigned int stuffing = total - rawTotal;
+        const unsigned int nominalBits = nominalRaw + static_cast<unsigned int>(
+                (static_cast<unsigned long long>(stuffing) * nominalRaw) / rawTotal);
+        return static_cast<double>(nominalBits) / arbitrationBitrate
+                + static_cast<double>(total - nominalBits) / dataBitrate;
+    }
+
+private:
+    static void validateStuffing(double stuffingPercentage) {
+        if (stuffingPercentage < 0 || stuffingPercentage > 1)
+            throw omnetpp::cRuntimeError("bitStuffingPercentage must be in [0, 1].");
+    }
+    static unsigned int stuffingBits(unsigned int stuffableBits, double percentage) {
+        return static_cast<unsigned int>(((stuffableBits - 1) / 4) * percentage);
+    }
+};
+
+} // namespace FiCo4OMNeT
+
+#endif

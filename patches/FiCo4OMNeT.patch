+void CanBusLogic::grantSendingPermission() {
+    currentSendingID = INT_MAX;
+    currentSendingExtendedId = false;
+    sendingNode = nullptr;
+    auto selected = ids.end();
+    for (auto it = ids.begin(); it != ids.end(); ++it)
+        if (selected == ids.end() || winsArbitration(*it, *selected))
+            selected = it;
+    if (selected == ids.end()) {
+        idle = true;
+        getDisplayString().setTagArg("tt", 0, "state: idle");
+        return;
+    }
+    CanID *winner = *selected;
+    // Multiple queued frames in one controller are normal under load. Only
+    // competing data transmitters with the same identifier need collision PHY.
+    for (auto candidate : ids)
+        if (!winner->getRtr() && !candidate->getRtr()
+                && candidate->getCanID() == winner->getCanID()
+                && candidate->getExtendedId() == winner->getExtendedId()
+                && candidate->getNode() != winner->getNode())
+            throw cRuntimeError("Multiple nodes requested the same CAN arbitration identifier and format; collision modeling is not implemented.");
+    currentSendingID = winner->getCanID();
+    currentSendingExtendedId = winner->getExtendedId();
+    sendingNode = check_and_cast<CanOutputBuffer *>(winner->getNode());
+    currsit = winner->getSignInTime();
+    eraseids.push_back(selected);
+    check_and_cast<CanOutputBuffer *>(sendingNode)->receiveSendingPermission(currentSendingID, currentSendingExtendedId, winner->getRtr());
+}

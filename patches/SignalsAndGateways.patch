diff --git a/Makefile.inet4 b/Makefile.inet4
new file mode 100644
index 0000000..fbc5e93
--- /dev/null
+++ b/Makefile.inet4
@@ -0,0 +1,9 @@
+# Focused native FiCo CAN adapters + INET4 packet gateway; legacy modules excluded.
+INET_ROOT ?= $(abspath ../inet)
+FICO_ROOT ?= $(abspath ../FiCo4OMNeT)
+AUTOSAR_ROOT ?= $(abspath ../../autosar)
+.PHONY: all makefiles
+all: makefiles
+	$(MAKE) -C src-inet4 MODE=release
+makefiles:
+	cd src-inet4 && opp_makemake -f --deep --make-so -o SignalsAndGateways_INET4 -O out -I. -I../src -I../src/signalsandgateways/applications/can -I$(INET_ROOT)/src -I$(FICO_ROOT)/src -I$(AUTOSAR_ROOT)/src -L$(INET_ROOT)/src -lINET -L$(FICO_ROOT)/src -lFiCo4OMNeT -L$(AUTOSAR_ROOT)/src -lAutosarProtection
diff --git a/src-inet4/signalsandgateways/inet4/CanEthernetApp.ned b/src-inet4/signalsandgateways/inet4/CanEthernetApp.ned
new file mode 100644
index 0000000..a98731a
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/CanEthernetApp.ned
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+package signalsandgateways.inet4;
+import inet.applications.contract.IApp;
+import inet.applications.ethernet.EthernetSocketIo;
+import fico4omnet.applications.ISinkApplication;
+
+simple CanEthernetBridge {
+    parameters:
+        double processingDelay @unit(s) = default(5us);
+        double bitStuffingPercentage = default(0);
+        @signal[canToEthernet](type=omnetpp::cPacket);
+        @signal[ethernetToCan](type=omnetpp::cPacket);
+        @signal[gatewayLatency](type=simtime_t);
+        @statistic[gatewayLatency](record=vector,stats);
+    gates:
+        input canIn;
+        output canOut;
+        input ethernetIn;
+        output ethernetOut;
+}
+module CanEthernetApp like IApp {
+    parameters:
+        string interfaceTableModule;
+        string localAddress;
+        string remoteAddress;
+        string interface = default("eth0");
+        double processingDelay @unit(s) = default(5us);
+        double bitStuffingPercentage = default(0);
+        @display("i=block/app");
+    gates:
+        input socketIn;
+        output socketOut;
+        input canIn;
+        output canOut;
+    submodules:
+        bridge: CanEthernetBridge {
+            processingDelay = parent.processingDelay;
+            bitStuffingPercentage = parent.bitStuffingPercentage;
+            @display("p=150,100");
+        }
+        io: EthernetSocketIo {
+            interfaceTableModule = absPath(parent.interfaceTableModule);
+            interface = parent.interface;
+            localAddress = parent.localAddress;
+            remoteAddress = parent.remoteAddress;
+            @display("p=150,230");
+        }
+    connections:
+        canIn --> bridge.canIn;
+        bridge.canOut --> canOut;
+        bridge.ethernetOut --> io.trafficIn;
+        io.trafficOut --> bridge.ethernetIn;
+        socketIn --> io.socketIn;
+        io.socketOut --> socketOut;
+}
+simple AuditCanSink like ISinkApplication {
+    parameters:
+        bool verifyPattern = default(true);
+        @signal[received](type=omnetpp::cPacket);
+        @signal[canId](type=long);
+        @signal[endToEndDelay](type=simtime_t);
+        @statistic[canId](record=vector);
+        @statistic[endToEndDelay](record=vector,stats);
+    gates:
+        input controllerIn @directIn;
+        input dataIn @directIn;
+}
diff --git a/src-inet4/signalsandgateways/inet4/CanEthernetBridge.cc b/src-inet4/signalsandgateways/inet4/CanEthernetBridge.cc
new file mode 100644
index 0000000..6c12b54
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/CanEthernetBridge.cc
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Local INET4 gateway boundary; native FiCo bus/ports remain in use.
+#include <omnetpp.h>
+#include <map>
+#include "inet/common/packet/Packet.h"
+#include "CanEthernetPayload_m.h"
+#include "fico4omnet/linklayer/can/messages/CanDataFrame_m.h"
+#include "fico4omnet/linklayer/can/CanFrameTiming.h"
+using namespace omnetpp;
+using namespace inet;
+using namespace FiCo4OMNeT;
+namespace SignalsAndGateways {
+class CanEthernetBridge : public cSimpleModule {
+    long sent = 0, received = 0;
+    uint64_t sequence = 0;
+    simsignal_t txSignal, rxSignal, latencySignal;
+    virtual void initialize() override {
+        txSignal = registerSignal("canToEthernet");
+        rxSignal = registerSignal("ethernetToCan");
+        latencySignal = registerSignal("gatewayLatency");
+        if (par("processingDelay").doubleValue() < 0)
+            throw cRuntimeError("processingDelay must be nonnegative");
+    }
+    virtual void handleMessage(cMessage *msg) override {
+        if (msg->arrivedOn("canIn")) {
+            auto frame = check_and_cast<CanDataFrame *>(msg);
+            CanFrameTiming::validateFrame(*frame);
+            if (frame->getRtr())
+                throw cRuntimeError("CAN-over-Ethernet adapter supports data frames only");
+            if (frame->getPayloadBytesArraySize() != frame->getPayloadLength())
+                throw cRuntimeError("CAN payload bytes/length mismatch");
+            auto chunk = makeShared<CanEthernetPayload>();
+            // Logical tunnel header: identifier/flags/DLC/length/sequence/time (24B).
+            // This is a simulation protocol, not an automotive wire standard.
+            chunk->setChunkLength(B(24 + frame->getPayloadLength()));
+            chunk->setCanId(frame->getCanID());
+            chunk->setFd(frame->getFd());
+            chunk->setBrs(frame->getBrs());
+            chunk->setExtendedId(frame->getExtendedId());
+            chunk->setRtr(frame->getRtr());
+            chunk->setDlc(frame->getDlc());
+            chunk->setPayloadLength(frame->getPayloadLength());
+            chunk->setSequence(sequence++);
+            chunk->setSourceTime(frame->getTimestamp());
+            chunk->setPayloadBytesArraySize(frame->getPayloadBytesArraySize());
+            for (size_t i=0; i<frame->getPayloadBytesArraySize(); ++i)
+                chunk->setPayloadBytes(i, frame->getPayloadBytes(i));
+            auto packet = new Packet("CAN-over-Ethernet");
+            packet->insertAtBack(chunk);
+            emit(txSignal, frame);
+            ++sent;
+            delete frame;
+            sendDelayed(packet, par("processingDelay"), "ethernetOut");
+        }
+        else if (msg->arrivedOn("ethernetIn")) {
+            auto packet = check_and_cast<Packet *>(msg);
+            const auto& chunk = packet->peekAtFront<CanEthernetPayload>();
+            auto frame = new CanDataFrame("CAN-from-Ethernet");
+            frame->setCanID(chunk->getCanId());
+            frame->setFd(chunk->getFd());
+            frame->setBrs(chunk->getBrs());
+            frame->setExtendedId(chunk->getExtendedId());
+            frame->setRtr(chunk->getRtr());
+            frame->setDlc(chunk->getDlc());
+            frame->setPayloadLength(chunk->getPayloadLength());
+            frame->setTimestamp(chunk->getSourceTime());
+            frame->setPayloadBytesArraySize(chunk->getPayloadBytesArraySize());
+            for (size_t i=0; i<chunk->getPayloadBytesArraySize(); ++i)
+                frame->setPayloadBytes(i, chunk->getPayloadBytes(i));
+            CanFrameTiming::validateFrame(*frame);
+            if (frame->getRtr())
+                throw cRuntimeError("CAN-over-Ethernet adapter supports data frames only");
+            if (frame->getPayloadBytesArraySize() != frame->getPayloadLength())
+                throw cRuntimeError("Ethernet tunnel payload bytes/length mismatch");
+            auto payload = new cPacket("CAN-payload");
+            payload->setByteLength(frame->getPayloadLength());
+            payload->setTimestamp(frame->getTimestamp());
+            frame->encapsulate(payload);
+            frame->setBitLength(CanFrameTiming::frameBitLength(*frame, par("bitStuffingPercentage")));
+            emit(rxSignal, frame);
+            emit(latencySignal, simTime() - frame->getTimestamp());
+            ++received;
+            delete packet;
+            sendDelayed(frame, par("processingDelay"), "canOut");
+        }
+        else throw cRuntimeError("Unexpected gateway input: %s", msg->getName());
+    }
+    virtual void finish() override {
+        recordScalar("canToEthernet", sent);
+        recordScalar("ethernetToCan", received);
+    }
+};
+Define_Module(CanEthernetBridge);
+
+// Audit receiving ECUs: verifies actual modeled bytes after both CAN buses.
+class AuditCanSink : public cSimpleModule {
+    long received = 0, bytes = 0;
+    std::map<unsigned int, cStdDev> delays;
+    simsignal_t rxSignal, idSignal, latencySignal;
+    virtual void initialize() override {
+        rxSignal=registerSignal("received");
+        idSignal=registerSignal("canId");
+        latencySignal=registerSignal("endToEndDelay");
+    }
+    virtual void handleMessage(cMessage *message) override {
+        auto frame=check_and_cast<CanDataFrame *>(message);
+        CanFrameTiming::validateFrame(*frame);
+        if(frame->getPayloadBytesArraySize()!=frame->getPayloadLength())
+            throw cRuntimeError("End-to-end payload length mismatch");
+        if(par("verifyPattern").boolValue())
+            for(size_t i=0; i<frame->getPayloadBytesArraySize(); ++i)
+                if(frame->getPayloadBytes(i)!=((frame->getCanID()+i)&255))
+                    throw cRuntimeError("End-to-end CAN payload corrupted");
+        ++received; bytes+=frame->getPayloadLength();
+        delays[frame->getCanID()].collect((simTime()-frame->getTimestamp()).dbl());
+        emit(rxSignal, frame); emit(idSignal, static_cast<long>(frame->getCanID()));
+        emit(latencySignal, simTime()-frame->getTimestamp());
+        delete frame;
+    }
+    virtual void finish() override {
+        recordScalar("receivedFrames",received);
+        recordScalar("receivedPayloadBytes",bytes);
+        for (auto& entry : delays) {
+            const std::string name="id_"+std::to_string(entry.first);
+            recordScalar((name+"_delayMean").c_str(),entry.second.getMean());
+            recordScalar((name+"_received").c_str(),entry.second.getCount());
+        }
+    }
+};
+Define_Module(AuditCanSink);
+}

new file mode 100644
index 0000000..12bd55c
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/CanEthernetPayload.msg
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+import inet.common.INETDefs;
+import inet.common.packet.chunk.Chunk;
+namespace SignalsAndGateways;
+class CanEthernetPayload extends inet::FieldsChunk
+{
+    unsigned int canId;
+    bool fd;
+    bool brs;
+    bool extendedId;
+    bool rtr;
+    unsigned int dlc;
+    unsigned int payloadLength;
+    uint64_t sequence;
+    simtime_t sourceTime;
+    uint8_t payloadBytes[];
+}

+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// Byte-exact serializers for the IEEE 1722 chunks in Avtp.msg (network byte order).
+#include "inet/common/packet/serializer/ChunkSerializerRegistry.h"
+#include "inet/common/packet/serializer/FieldsChunkSerializer.h"
+#include "signalsandgateways/inet4/avtp/Avtp_m.h"
+
+using namespace inet;
+
+namespace SignalsAndGateways {
+
+class AvtpNtscfHeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& header = staticPtrCast<const AvtpNtscfHeader>(chunk);
+        if (header->getNtscfDataLength() > 0x7ff)
+            throw cRuntimeError("ntscf_data_length %u exceeds 11 bits", header->getNtscfDataLength());
+        stream.writeUint8(header->getSubtype());
+        stream.writeUint16Be((header->getSv() ? 0x8000 : 0) | ((header->getVersion() & 0x07) << 12)
+                             | (header->getNtscfDataLength() & 0x7ff));
+        stream.writeUint8(header->getSequenceNum());
+        stream.writeUint64Be(header->getStreamId());
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto header = makeShared<AvtpNtscfHeader>();
+        header->setSubtype(stream.readUint8());
+        uint16_t word = stream.readUint16Be();
+        header->setSv(word & 0x8000);
+        header->setVersion((word >> 12) & 0x07);
+        header->setNtscfDataLength(word & 0x7ff);
+        header->setSequenceNum(stream.readUint8());
+        header->setStreamId(stream.readUint64Be());
+        return header;
+    }
+};
+
+class AvtpTscfHeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& header = staticPtrCast<const AvtpTscfHeader>(chunk);
+        stream.writeUint8(header->getSubtype());
+        stream.writeUint8((header->getSv() ? 0x80 : 0) | ((header->getVersion() & 0x07) << 4)
+                          | (header->getMr() ? 0x08 : 0) | (header->getTv() ? 0x01 : 0));
+        stream.writeUint8(header->getSequenceNum());
+        stream.writeUint8(header->getTu() ? 0x01 : 0);
+        stream.writeUint64Be(header->getStreamId());
+        stream.writeUint32Be(header->getAvtpTimestamp());
+        stream.writeUint32Be(0);
+        stream.writeUint16Be(header->getStreamDataLength());
+        stream.writeUint16Be(0);
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto header = makeShared<AvtpTscfHeader>();
+        header->setSubtype(stream.readUint8());
+        uint8_t flags = stream.readUint8();
+        header->setSv(flags & 0x80);
+        header->setVersion((flags >> 4) & 0x07);
+        header->setMr(flags & 0x08);
+        header->setTv(flags & 0x01);
+        header->setSequenceNum(stream.readUint8());
+        header->setTu(stream.readUint8() & 0x01);
+        header->setStreamId(stream.readUint64Be());
+        header->setAvtpTimestamp(stream.readUint32Be());
+        stream.readUint32Be();
+        header->setStreamDataLength(stream.readUint16Be());
+        stream.readUint16Be();
+        return header;
+    }
+};
+
+class AcfCanMessageSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& message = staticPtrCast<const AcfCanMessage>(chunk);
+        const bool brief = message->getAcfMsgType() == ACF_MSG_TYPE_CAN_BRIEF;
+        const size_t headerLength = brief ? ACF_CAN_BRIEF_HEADER_BYTES : ACF_CAN_HEADER_BYTES;
+        const size_t total = headerLength + message->getPayloadArraySize() + message->getPad();
+        if (message->getAcfMsgLength() > 0x1ff || total != message->getAcfMsgLength() * 4u || total % 4 != 0)
+            throw cRuntimeError("ACF CAN message length/pad is inconsistent with its payload");
+        stream.writeUint16Be(((message->getAcfMsgType() & 0x7f) << 9) | (message->getAcfMsgLength() & 0x1ff));
+        stream.writeUint8(((message->getPad() & 0x03) << 6) | (message->getMtv() ? 0x20 : 0)
+                          | (message->getRtr() ? 0x10 : 0) | (message->getEff() ? 0x08 : 0)
+                          | (message->getBrs() ? 0x04 : 0) | (message->getFdf() ? 0x02 : 0)
+                          | (message->getEsi() ? 0x01 : 0));
+        stream.writeUint8(message->getCanBusId() & 0x1f);
+        if (!brief)
+            stream.writeUint64Be(message->getMessageTimestamp());
+        stream.writeUint32Be(message->getCanIdentifier() & 0x1fffffffU);
+        for (size_t i = 0; i < message->getPayloadArraySize(); ++i)
+            stream.writeUint8(message->getPayload(i));
+        stream.writeByteRepeatedly(0, message->getPad());
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto message = makeShared<AcfCanMessage>();
+        uint16_t word = stream.readUint16Be();
+        message->setAcfMsgType(word >> 9);
+        message->setAcfMsgLength(word & 0x1ff);
+        uint8_t flags = stream.readUint8();
+        message->setPad(flags >> 6);
+        message->setMtv(flags & 0x20);
+        message->setRtr(flags & 0x10);
+        message->setEff(flags & 0x08);
+        message->setBrs(flags & 0x04);
+        message->setFdf(flags & 0x02);
+        message->setEsi(flags & 0x01);
+        message->setCanBusId(stream.readUint8() & 0x1f);
+        const bool brief = message->getAcfMsgType() == ACF_MSG_TYPE_CAN_BRIEF;
+        const size_t headerLength = brief ? ACF_CAN_BRIEF_HEADER_BYTES : ACF_CAN_HEADER_BYTES;
+        if (!brief)
+            message->setMessageTimestamp(stream.readUint64Be());
+        message->setCanIdentifier(stream.readUint32Be() & 0x1fffffffU);
+        const size_t total = message->getAcfMsgLength() * 4u;
+        if (total < headerLength + message->getPad()) {
+            message->markIncorrect();
+            message->setChunkLength(B(headerLength));
+            return message;
+        }
+        const size_t payloadLength = total - headerLength - message->getPad();
+        message->setPayloadArraySize(payloadLength);
+        for (size_t i = 0; i < payloadLength; ++i)
+            message->setPayload(i, stream.readUint8());
+        for (size_t i = 0; i < message->getPad(); ++i)
+            stream.readUint8();
+        message->setChunkLength(B(total));
+        return message;
+    }
+};
+
+Register_Serializer(AvtpNtscfHeader, AvtpNtscfHeaderSerializer);
+Register_Serializer(AvtpTscfHeader, AvtpTscfHeaderSerializer);
+Register_Serializer(AcfCanMessage, AcfCanMessageSerializer);
+
+} // namespace SignalsAndGateways
diff --git a/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.msg b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.msg
new file mode 100644
index 0000000..c7af3e3
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.msg
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// IEEE 1722-2016 media stream formats: AAF PCM audio (subtype 0x02), Clock Reference
+// Format (CRF, 0x04) and IEC 61883-4 MPEG-2 transport streams (61883/IIDC, 0x00).
+// Field layout per the standard's tables (cross-checked with COVESA Open1722, the
+// Wireshark IEEE 1722 dissector and the OpenAvnu MPEG2-TS mapping).
+import inet.common.INETDefs;
+import inet.common.packet.chunk.Chunk;
+import inet.common.TagBase;
+
+namespace SignalsAndGateways;
+
+cplusplus {{
+static const uint8_t AVTP_SUBTYPE_61883_IIDC = 0x00;
+static const uint8_t AVTP_SUBTYPE_AAF = 0x02;
+static const uint8_t AVTP_SUBTYPE_CRF = 0x04;
+static const int AVTP_AAF_HEADER_BYTES = 24;
+static const int AVTP_CRF_HEADER_BYTES = 20;
+static const int AVTP_61883_HEADER_BYTES = 24;
+static const int AVTP_CIP_HEADER_BYTES = 8;
+static const int IEC61883_4_SOURCE_PACKET_BYTES = 192;   // 4-byte source packet header + TS packet
+static const int MPEG_TS_PACKET_BYTES = 188;
+}}
+
+// AAF with a PCM format (24 bytes).
+class AvtpAafPcmHeader extends inet::FieldsChunk
+{
+    chunkLength = inet::B(24);
+    uint8_t subtype = AVTP_SUBTYPE_AAF;
+    bool sv = true;
+    uint8_t version = 0;
+    bool mr = false;            // media clock restart
+    bool tv = true;             // avtp_timestamp valid
+    uint8_t sequenceNum;
+    bool tu = false;
+    uint64_t streamId;
+    uint32_t avtpTimestamp;     // presentation time of the first sample, gPTP ns mod 2^32
+    uint8_t format;             // 0x02 INT_32BIT, 0x03 INT_24BIT, 0x04 INT_16BIT
+    uint8_t nsr;                // nominal sample rate code (4 bits)
+    uint16_t channelsPerFrame;  // 10 bits
+    uint8_t bitDepth;
+    uint16_t streamDataLength;
+    bool sp = false;            // sparse timestamp mode
+    uint8_t evt = 0;            // 4 bits
+}
+
+// CRF header (20 bytes) followed by crf_data (64-bit timestamps).
+class AvtpCrfPdu extends inet::FieldsChunk
+{
+    uint8_t subtype = AVTP_SUBTYPE_CRF;
+    bool sv = true;
+    uint8_t version = 0;
+    bool mr = false;
+    bool fs = false;            // frame sync
+    bool tu = false;
+    uint8_t sequenceNum;
+    uint8_t type;               // 0x01 audio sample, 0x02 video frame, ...
+    uint64_t streamId;
+    uint8_t pull;               // 3 bits, base_frequency multiplier
+    uint32_t baseFrequency;     // 29 bits, Hz
+    uint16_t crfDataLength;
+    uint16_t timestampInterval; // media clock events between two timestamps
+    uint64_t crfTimestamp[];    // gPTP ns
+}
+
+// 61883/IIDC header (24 bytes) with the IEC 61883-1 CIP header (8 bytes) for
+// IEC 61883-4 (MPEG-2 TS). The source packets (192 bytes each) follow as bytes.
+class Avtp61883Header extends inet::FieldsChunk
+{
+    chunkLength = inet::B(32);
+    uint8_t subtype = AVTP_SUBTYPE_61883_IIDC;
+    bool sv = true;
+    uint8_t version = 0;
+    bool mr = false;
+    bool gv = false;            // gateway_info valid
+    bool tv = true;
+    uint8_t sequenceNum;
+    bool tu = false;
+    uint64_t streamId;
+    uint32_t avtpTimestamp;     // presentation time of the first source packet
+    uint32_t gatewayInfo = 0;
+    uint16_t streamDataLength;  // CIP header + source packets
+    uint8_t tag = 1;            // 2 bits: 01 = CIP header included
+    uint8_t channel = 31;       // 6 bits: 31 = native AVTP
+    uint8_t tcode = 0x0A;       // 4 bits
+    uint8_t sy = 0;             // 4 bits
+    // CIP header, quadlet 1: 00 | SID | DBS | FN QPC SPH rsv | DBC
+    uint8_t sid = 63;           // 63 = no 1394 source node
+    uint8_t dbs = 6;            // data block size in quadlets
+    uint8_t fn = 3;             // 3 = 8 data blocks per source packet
+    uint8_t qpc = 0;
+    bool sph = true;            // source packet headers present
+    uint8_t dbc;                // data block counter of the first data block
+    // CIP header, quadlet 2: 10 | FMT | FDF
+    uint8_t fmt = 0x20;         // IEC 61883-4 MPEG2-TS
+    bool tsf = false;           // time shift flag
+}
+
+// Simulation-only metadata (not on the wire): creation time at the talker and the
+// instant (simulation time) at which the talker's own gPTP clock reaches the
+// presentation time, to measure the listener's presentation error.
+class AvtpMediaOriginTag extends inet::TagBase
+{
+    simtime_t sourceTime;
+    simtime_t intendedPresentationTime = -1;
+}
diff --git a/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.ned b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.ned
new file mode 100644
index 0000000..42f419a
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMedia.ned
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+package signalsandgateways.inet4.avtp.media;
+
+import inet.applications.contract.IApp;
+import inet.common.SimpleModule;
+
+// A media stream endpoint (talker or listener) inside AvtpMediaEndpoint.
+moduleinterface IAvtpMediaStream
+{
+    parameters:
+        @display("i=block/app");
+    gates:
+        input in;
+        output out;
+}
+
+// Registers EtherType 0x22F0 once for the node and connects the streams.
+simple AvtpStreamMux extends SimpleModule
+{
+    parameters:
+        @class(AvtpStreamMux);
+        @display("i=block/join");
+    gates:
+        input socketIn;
+        output socketOut;
+        input talkerIn[];
+        output listenerOut[];
+}
+
+// Parameters shared by all media talkers and listeners.
+simple AvtpMediaStreamBase extends SimpleModule
+{
+    parameters:
+        @lifecycleSupport;
+        string interfaceTableModule;
+        string interface = default("eth0");
+        string clockModule = default("");        // gPTP clock (e.g. "^.^.clock"); "" = simulation time
+        // talker
+        string destAddress = default("");        // stream destination MAC; "" = not a talker
+        string streamId = default("");           // 64-bit; default interface MAC << 16 | streamUniqueId
+        int streamUniqueId = default(1);
+        double maxTransitTime @unit(s) = default(2ms);   // presentation time offset (SR class A: 2 ms)
+        double startTime @unit(s) = default(10ms);
+        double stopTime @unit(s) = default(-1s);  // -1 = until the end of the simulation
+        double mediaClockPpm = default(0);        // media clock rate offset against the talker's gPTP clock
+        // listener
+        string listenAddress = default("");      // stream MAC to receive; "" = not a listener
+        string listenStreamId = default("");     // accept only this stream ID; "" = any
+        string latePresentationPolicy @enum("play","drop") = default("play");
+        double processingDelay @unit(s) = default(5us);
+        @signal[presentationSlack](type=simtime_t);
+        @signal[presentationLateness](type=simtime_t);
+        @signal[presentationError](type=simtime_t);
+        @signal[avtpPduLength](type=long);
+        @statistic[presentationSlack](record=stats);         // presentation time - earliest possible release
+        @statistic[presentationLateness](record=stats,vector);
+        @statistic[presentationError](record=stats,vector);  // listener release - talker's intended instant
+        @statistic[avtpPduLength](record=stats);
+    gates:
+        input in;
+        output out;
+}
+
+//
+// AAF PCM talker (IEEE 1722 subtype 0x02): 'channels' interleaved samples per frame,
+// 'samplesPerPdu' frames per PDU, big-endian, bitDepth valid bits left-justified in
+// the container. avtp_timestamp = capture time of the first sample + maxTransitTime.
+// Content: synthetic test pattern (AvtpMediaCodec.h, pcmPatternSample).
+// Class A at 48 kHz: 6 samples per PDU (8000 PDUs/s).
+//
+simple AafTalker extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(AafTalker);
+        string format @enum("int16","int24","int32") = default("int16");
+        int bitDepth = default(-1);             // -1 = container size
+        int sampleRate @unit(Hz) = default(48000Hz);
+        int channels = default(2);
+        int samplesPerPdu = default(6);
+        int patternStep = default(331);         // odd
+}
+
+// AAF PCM listener: plays each PDU at its presentation time, checks the sample
+// pattern and continuity, and recovers the sample rate from the timestamps.
+simple AafListener extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(AafListener);
+        int patternStep = default(331);
+        @signal[samplesPlayed](type=long);
+        @statistic[samplesPlayed](record=sum,vector);
+}
+
+//
+// IEC 61883-4 MPEG-2 TS talker (subtype 0x00 with CIP header, FMT 0x20). A synthetic
+// transport stream at 'bitrate' (PAT, PMT, H.264 video PID 0x100 with PCR, AAC audio
+// PID 0x110) is packed every pduInterval into up to maxSourcePacketsPerPdu source
+// packets; each source packet header holds that packet's presentation time.
+// SR class B: pduInterval 250us, maxTransitTime 50ms.
+//
+simple Iec61883TsTalker extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(Iec61883TsTalker);
+        double bitrate @unit(bps) = default(16Mbps);
+        double pduInterval @unit(s) = default(250us);
+        int maxSourcePacketsPerPdu = default(7);
+        int psiIntervalPackets = default(1000);  // PAT/PMT repetition (about 94 ms at 16 Mbps)
+        int pcrIntervalPackets = default(397);   // PCR repetition (about 37 ms at 16 Mbps; not a multiple of 300 ticks)
+        int audioEveryPackets = default(10);
+        maxTransitTime = default(50ms);
+}
+
+// IEC 61883-4 listener: outputs every TS packet at its source packet presentation
+// time; checks CIP DBC, TS sync, continuity counters, PAT/PMT CRC, payload, and
+// measures PCR jitter and the recovered 27 MHz system clock.
+simple Iec61883TsListener extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(Iec61883TsListener);
+        @signal[tsPacketOutput](type=long);
+        @statistic[tsPacketOutput](record=count);
+}
+
+//
+// CRF talker (subtype 0x04): every timestampInterval media clock events one 64-bit
+// gPTP timestamp (event time + timestampOffset), timestampsPerPdu per PDU. A PDU is
+// sent at its first event (the talker is the clock source and predicts the others).
+// Audio sample clock 48 kHz: interval 160, 6 timestamps per PDU (50 PDUs/s).
+//
+simple CrfTalker extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(CrfTalker);
+        int crfType = default(1);                // 1 = audio sample
+        int baseFrequency @unit(Hz) = default(48000Hz);
+        int pull = default(0);                   // 0 = x1
+        int timestampInterval = default(160);
+        int timestampsPerPdu = default(6);
+        double timestampOffset @unit(s) = default(-1s);   // -1 = maxTransitTime
+}
+
+// CRF listener: recovers the media clock frequency and timestamp jitter.
+simple CrfListener extends AvtpMediaStreamBase like IAvtpMediaStream
+{
+    parameters:
+        @class(CrfListener);
+        @signal[crfTimestampSlack](type=simtime_t);
+        @statistic[crfTimestampSlack](record=stats);     // timestamp - reception time
+}
+
+//
+// Application for an INET host (StandardHost or TsnDevice): any number of media
+// talkers and listeners sharing one AVTP (EtherType 0x22F0) registration.
+//
+module AvtpMediaEndpoint like IApp
+{
+    parameters:
+        string interfaceTableModule;
+        string clockModule = default("");       // relative to this module, e.g. "^.clock"
+        int numTalkers = default(0);
+        int numListeners = default(0);
+        @display("i=block/app");
+    gates:
+        input socketIn;
+        output socketOut;
+    submodules:
+        mux: AvtpStreamMux {
+            @display("p=200,100");
+        }
+        talker[numTalkers]: <> like IAvtpMediaStream {
+            interfaceTableModule = default(absPath(parent.interfaceTableModule));
+            clockModule = default(parent.clockModule == "" ? "" : "^." + parent.clockModule);
+            @display("p=100,200,row,100");
+        }
+        listener[numListeners]: <> like IAvtpMediaStream {
+            interfaceTableModule = default(absPath(parent.interfaceTableModule));
+            clockModule = default(parent.clockModule == "" ? "" : "^." + parent.clockModule);
+            @display("p=100,300,row,100");
+        }
+    connections allowunconnected:
+        socketIn --> mux.socketIn;
+        mux.socketOut --> socketOut;
+        for i=0..numTalkers-1 {
+            talker[i].out --> mux.talkerIn++;
+        }
+        for i=0..numListeners-1 {
+            mux.listenerOut++ --> listener[i].in;
+        }
+}
+
+// Deterministic codec checks: golden byte vectors, serializer round trips, rejection
+// of malformed PDUs, MPEG-2 TS / PCR / CRC helpers and the PCM test pattern.
+simple AvtpMediaSelfTest extends SimpleModule
+{
+    parameters:
+        @class(AvtpMediaSelfTest);
+}
diff --git a/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaApps.cc b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaApps.cc
new file mode 100644
index 0000000..bd9205e
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaApps.cc
@@ -0,0 +1,947 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// IEEE 1722 media streams for digital radio / TV transport: AAF PCM audio,
+// IEC 61883-4 MPEG-2 TS and CRF media clock reference. Talkers generate synthetic,
+// verifiable content on a media clock (nominal rate x (1 + mediaClockPpm) in the
+// talker's gPTP time); listeners decode the received bytes with the validating
+// decoder, release data at the presentation time on their own gPTP clock and
+// verify content, continuity and clock recovery.
+//
+// AvtpStreamMux registers EtherType 0x22F0 once per node (INET allows one
+// registration per protocol) and connects any number of talkers and listeners.
+#include <cmath>
+#include <deque>
+#include <memory>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "inet/applications/base/ApplicationBase.h"
+#include "inet/common/IProtocolRegistrationListener.h"
+#include "inet/common/ModuleAccess.h"
+#include "inet/common/Protocol.h"
+#include "inet/common/ProtocolTag_m.h"
+#include "inet/common/clock/ClockUserModuleMixin.h"
+#include "inet/common/packet/Packet.h"
+#include "inet/common/packet/chunk/BytesChunk.h"
+#include "inet/linklayer/common/InterfaceTag_m.h"
+#include "inet/linklayer/common/MacAddressTag_m.h"
+#include "inet/networklayer/common/NetworkInterface.h"
+#include "inet/networklayer/contract/IInterfaceTable.h"
+#include "signalsandgateways/inet4/avtp/media/AvtpMedia_m.h"
+#include "signalsandgateways/inet4/avtp/media/AvtpMediaCodec.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SignalsAndGateways {
+
+using namespace avtp::media;
+
+// ---- mux -------------------------------------------------------------------------
+
+class AvtpStreamMux : public cSimpleModule
+{
+    long forwarded = 0, delivered = 0;
+
+  protected:
+    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
+
+    virtual void initialize(int stage) override
+    {
+        if (stage == INITSTAGE_LINK_LAYER)
+            registerProtocol(Protocol::tsn, gate("socketOut"), gate("socketIn"));
+    }
+
+    virtual void handleMessage(cMessage *message) override
+    {
+        if (message->arrivedOn("talkerIn")) {
+            ++forwarded;
+            send(message, "socketOut");
+            return;
+        }
+        // Every listener filters by destination address and stream ID itself.
+        auto packet = check_and_cast<Packet *>(message);
+        const int listeners = gateSize("listenerOut");
+        for (int i = 0; i < listeners; ++i)
+            send(i + 1 == listeners ? packet : packet->dup(), "listenerOut", i);
+        delivered += listeners;
+        if (listeners == 0)
+            delete packet;
+    }
+
+    virtual void finish() override
+    {
+        recordScalar("talkerPdusForwarded", forwarded);
+        recordScalar("listenerDeliveries", delivered);
+    }
+};
+
+Define_Module(AvtpStreamMux);
+
+// ---- common stream base ---------------------------------------------------------
+
+class AvtpMediaStreamBase : public ClockUserModuleMixin<ApplicationBase>
+{
+  protected:
+    NetworkInterface *networkInterface = nullptr;
+    MacAddress destAddress, listenAddress;
+    uint64_t streamId = 0;
+    bool hasListenStreamId = false;
+    uint64_t listenStreamId = 0;
+    simtime_t maxTransitTime, processingDelay, startTime, stopTime;
+    bool dropLate = false;
+    double mediaClockPpm = 0;
+    clocktime_t mediaStart;
+    uint8_t sequenceNum = 0;
+    bool haveSequence = false;
+    uint8_t expectedSequence = 0;
+    cMessage *timer = nullptr;
+
+    long pdusSent = 0, pdusReceived = 0, sequenceLost = 0, sequenceOutOfOrder = 0;
+    long droppedMalformed = 0, droppedStreamId = 0, droppedSubtype = 0, ignoredOtherDestinations = 0;
+    long latePresentations = 0, droppedLate = 0;
+    simsignal_t slackSignal, latenessSignal, presentationErrorSignal, pduLengthSignal;
+
+    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
+    virtual uint8_t expectedSubtype() const = 0;
+    virtual void startStreaming() {}
+
+    static uint64_t parseStreamId(const char *text)
+    {
+        try {
+            size_t used = 0;
+            const std::string value(text);
+            const uint64_t id = std::stoull(value, &used, 0);
+            if (used != value.size())
+                throw cRuntimeError("trailing characters");
+            return id;
+        }
+        catch (const std::exception&) {
+            throw cRuntimeError("Invalid stream ID '%s'; use e.g. \"0x0200000000010001\"", text);
+        }
+    }
+
+    virtual void initialize(int stage) override
+    {
+        ClockUserModuleMixin::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            if (*par("destAddress").stringValue())
+                destAddress = MacAddress(par("destAddress").stringValue());
+            if (*par("listenAddress").stringValue())
+                listenAddress = MacAddress(par("listenAddress").stringValue());
+            const char *listenStream = par("listenStreamId");
+            hasListenStreamId = *listenStream != '\0';
+            if (hasListenStreamId)
+                listenStreamId = parseStreamId(listenStream);
+            maxTransitTime = par("maxTransitTime");
+            processingDelay = par("processingDelay");
+            startTime = par("startTime");
+            stopTime = par("stopTime");
+            mediaClockPpm = par("mediaClockPpm");
+            const std::string latePolicy = par("latePresentationPolicy").stdstringValue();
+            if (latePolicy != "play" && latePolicy != "drop")
+                throw cRuntimeError("latePresentationPolicy must be \"play\" or \"drop\"");
+            dropLate = latePolicy == "drop";
+            if (maxTransitTime < 0 || processingDelay < 0 || startTime < 0)
+                throw cRuntimeError("maxTransitTime, processingDelay and startTime must be nonnegative");
+            timer = new cMessage("mediaTimer");
+            slackSignal = registerSignal("presentationSlack");
+            latenessSignal = registerSignal("presentationLateness");
+            presentationErrorSignal = registerSignal("presentationError");
+            pduLengthSignal = registerSignal("avtpPduLength");
+        }
+    }
+
+    virtual void handleStartOperation(LifecycleOperation *operation) override
+    {
+        auto interfaceTable = getModuleFromPar<IInterfaceTable>(par("interfaceTableModule"), this);
+        networkInterface = interfaceTable->findInterfaceByName(par("interface"));
+        if (networkInterface == nullptr)
+            throw cRuntimeError("Cannot find network interface '%s'", par("interface").stringValue());
+        const char *configuredStream = par("streamId");
+        const int uniqueId = par("streamUniqueId");
+        if (uniqueId < 0 || uniqueId > 0xffff)
+            throw cRuntimeError("streamUniqueId must be 0..65535");
+        streamId = *configuredStream != '\0' ? parseStreamId(configuredStream)
+                : (networkInterface->getMacAddress().getInt() << 16) | uint64_t(uniqueId);
+        if (listenAddress.isMulticast())
+            networkInterface->addMulticastMacAddress(listenAddress);
+        if (!destAddress.isUnspecified())
+            scheduleAt(std::max(simTime(), startTime), timer);
+    }
+
+    virtual void handleStopOperation(LifecycleOperation *operation) override { cancelEvent(timer); }
+    virtual void handleCrashOperation(LifecycleOperation *operation) override { cancelEvent(timer); }
+
+    virtual void handleMessageWhenUp(cMessage *message) override
+    {
+        if (message == timer) {
+            if (mediaStart == CLOCKTIME_ZERO && pdusSent == 0) {
+                // Media clock epoch on a whole microsecond of the talker's gPTP clock.
+                const int64_t now = getClockTime().inUnit(SIMTIME_US) + 1;
+                mediaStart = ClockTime(now, SIMTIME_US);
+                startStreaming();
+            }
+            else
+                onTimer();
+        }
+        else if (message->isSelfMessage())
+            onPresentation(message);
+        else
+            handleListenedPacket(check_and_cast<Packet *>(message));
+    }
+
+    virtual void onTimer() {}
+    virtual void onPresentation(cMessage *message) { delete message; }
+    virtual void onPdu(const DecodedMediaPdu& pdu, Packet *packet) = 0;
+
+    // Nanoseconds after mediaStart (gPTP) of a media event 'seconds' of media time
+    // later: the media clock runs at (1 + mediaClockPpm) of the gPTP rate.
+    int64_t mediaOffsetNs(double seconds) const { return std::llround(seconds * 1e9 / (1 + mediaClockPpm * 1e-6)); }
+    clocktime_t mediaClock(double seconds) const { return mediaStart + ClockTime(mediaOffsetNs(seconds), SIMTIME_NS); }
+
+    // Simulation time of a clock instant; INET only converts future instants, a past
+    // one is extrapolated back from now (the clock rate error is negligible here).
+    simtime_t simTimeOf(clocktime_t when) const
+    {
+        const clocktime_t now = getClockTime();
+        return when >= now ? computeSimTimeFromClockTime(when) : simTime() - (now - when).asSimTime();
+    }
+
+    // Schedules the timer at a gPTP instant (never in the past).
+    void scheduleTimerAt(clocktime_t when)
+    {
+        simtime_t at = simTimeOf(when);
+        if (at < simTime())
+            at = simTime();
+        if (stopTime < SIMTIME_ZERO || at <= stopTime)
+            scheduleAt(at, timer);
+    }
+
+    static uint32_t low32(clocktime_t time) { return uint32_t(time.inUnit(SIMTIME_NS)); }
+
+    void sendPdu(Packet *packet)
+    {
+        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::tsn);
+        packet->addTag<MacAddressReq>()->setDestAddress(destAddress);
+        packet->addTag<InterfaceReq>()->setInterfaceId(networkInterface->getInterfaceId());
+        packet->addTag<DispatchProtocolReq>()->setProtocol(networkInterface->getProtocol() ? networkInterface->getProtocol() : &Protocol::ethernetMac);
+        emit(pduLengthSignal, packet->getByteLength());
+        ++pdusSent;
+        ++sequenceNum;
+        send(packet, "out");
+    }
+
+    void tagOrigin(Packet *packet, b offset, b length, clocktime_t capture, clocktime_t presentation)
+    {
+        auto tag = packet->addRegionTag<AvtpMediaOriginTag>(offset, length);
+        tag->setSourceTime(simTimeOf(capture));
+        tag->setIntendedPresentationTime(simTimeOf(presentation));
+    }
+
+    // Intended presentation instants of the tagged regions, by byte offset in the PDU.
+    static std::map<size_t, simtime_t> intendedTimes(Packet *packet)
+    {
+        std::map<size_t, simtime_t> times;
+        const b front = packet->getFrontOffset();
+        for (const auto& region : packet->getAllRegionTags<AvtpMediaOriginTag>())
+            if (region.getOffset() >= front)
+                times[B(region.getOffset() - front).get()] = region.getTag()->getIntendedPresentationTime();
+        return times;
+    }
+
+    void handleListenedPacket(Packet *packet)
+    {
+        const auto& protocolTag = packet->findTag<PacketProtocolTag>();
+        const auto& macAddressInd = packet->findTag<MacAddressInd>();
+        if (listenAddress.isUnspecified() || protocolTag == nullptr || protocolTag->getProtocol() != &Protocol::tsn
+                || macAddressInd == nullptr || macAddressInd->getDestAddress() != listenAddress) {
+            ++ignoredOtherDestinations;
+            delete packet;
+            return;
+        }
+        ++pdusReceived;
+        const DecodedMediaPdu pdu = decodeMediaPdu(packet->peekDataAsBytes()->getBytes());
+        if (pdu.error != MediaError::NONE) {
+            EV_WARN << "Dropping malformed AVTPDU: " << toString(pdu.error) << endl;
+            ++droppedMalformed;
+        }
+        else if (pdu.subtype != expectedSubtype())
+            ++droppedSubtype;
+        else if (hasListenStreamId && pdu.streamId != listenStreamId)
+            ++droppedStreamId;
+        else {
+            if (haveSequence) {
+                const uint8_t delta = pdu.sequenceNum - expectedSequence;
+                if (delta != 0 && delta < 128)
+                    sequenceLost += delta;
+                else if (delta >= 128)
+                    ++sequenceOutOfOrder;
+            }
+            haveSequence = true;
+            expectedSequence = pdu.sequenceNum + 1;
+            onPdu(pdu, packet);
+        }
+        delete packet;
+    }
+
+    // avtp_timestamp (gPTP ns mod 2^32) as the instant nearest to now on this clock.
+    clocktime_t reconstructTimestamp(uint32_t timestamp) const
+    {
+        const int64_t now = getClockTime().inUnit(SIMTIME_NS);
+        return ClockTime(now + int32_t(timestamp - uint32_t(now)), SIMTIME_NS);
+    }
+
+    // Simulation time at which data with this presentation time is released, or -1
+    // if it arrived too late and the policy drops it.
+    simtime_t releaseTime(uint32_t timestamp, simtime_t intended)
+    {
+        const clocktime_t ready = getClockTime() + ClockTime::from(processingDelay);
+        const clocktime_t presentation = reconstructTimestamp(timestamp);
+        if (presentation >= ready) {
+            emit(slackSignal, (presentation - ready).asSimTime());
+            const simtime_t release = computeSimTimeFromClockTime(presentation);
+            if (intended >= SIMTIME_ZERO)
+                emit(presentationErrorSignal, release - intended);
+            return release;
+        }
+        ++latePresentations;
+        emit(latenessSignal, (ready - presentation).asSimTime());
+        if (dropLate) {
+            ++droppedLate;
+            return -1;
+        }
+        return simTime() + processingDelay;
+    }
+
+    virtual void finish() override
+    {
+        recordScalar("avtpPdusSent", pdusSent);
+        recordScalar("avtpPdusReceived", pdusReceived);
+        recordScalar("sequenceLost", sequenceLost);
+        recordScalar("sequenceOutOfOrder", sequenceOutOfOrder);
+        recordScalar("droppedMalformedPdus", droppedMalformed);
+        recordScalar("droppedStreamId", droppedStreamId);
+        recordScalar("droppedSubtype", droppedSubtype);
+        recordScalar("ignoredOtherDestinations", ignoredOtherDestinations);
+        recordScalar("latePresentations", latePresentations);
+        recordScalar("droppedLate", droppedLate);
+        ApplicationBase::finish();
+    }
+
+  public:
+    virtual ~AvtpMediaStreamBase() { cancelAndDelete(timer); }
+};
+
+// Least-squares fit y = a + b x; reports slope and the largest residual.
+struct LinearFit {
+    std::vector<double> xs, ys;
+    void add(double x, double y) { xs.push_back(x); ys.push_back(y); }
+    bool valid() const { return xs.size() >= 3; }
+    void solve(double& slope, double& maxResidual) const
+    {
+        const double n = xs.size();
+        double mx = 0, my = 0;
+        for (size_t i = 0; i < xs.size(); ++i) { mx += xs[i]; my += ys[i]; }
+        mx /= n; my /= n;
+        double sxx = 0, sxy = 0;
+        for (size_t i = 0; i < xs.size(); ++i) { sxx += (xs[i] - mx) * (xs[i] - mx); sxy += (xs[i] - mx) * (ys[i] - my); }
+        slope = sxy / sxx;
+        maxResidual = 0;
+        for (size_t i = 0; i < xs.size(); ++i)
+            maxResidual = std::max(maxResidual, std::fabs(ys[i] - (my + slope * (xs[i] - mx))));
+    }
+};
+
+// Rate in ppm against 'nominal' units per second from a fit of simulation time (ns)
+// over media units: the physical rate, independent of any node clock.
+static void recordPhysicalRate(cComponent *owner, const char *name, const LinearFit& fit, double nominal)
+{
+    if (!fit.valid())
+        return;
+    double slope, residual;
+    fit.solve(slope, residual);
+    owner->recordScalar(name, (1e9 / slope / nominal - 1) * 1e6);
+}
+
+// ---- AAF PCM audio --------------------------------------------------------------
+
+class AafTalker : public AvtpMediaStreamBase
+{
+    uint8_t format = AAF_INT_16BIT, nsr = 0;
+    size_t container = 2;
+    unsigned bitDepth = 16, channels = 2, samplesPerPdu = 6;
+    uint32_t sampleRate = 48000, step = 331;
+    uint64_t pduIndex = 0;
+    LinearFit production;   // sample index -> simulation time of capture
+
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_AAF; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            const std::string name = par("format").stdstringValue();
+            format = name == "int16" ? AAF_INT_16BIT : name == "int24" ? AAF_INT_24BIT : name == "int32" ? AAF_INT_32BIT : 0;
+            if (format == 0)
+                throw cRuntimeError("format must be int16, int24 or int32");
+            container = aafContainerBytes(format);
+            const int depth = par("bitDepth");
+            bitDepth = depth < 0 ? 8 * container : depth;
+            sampleRate = par("sampleRate");
+            nsr = hzToNsr(sampleRate);
+            channels = par("channels");
+            samplesPerPdu = par("samplesPerPdu");
+            step = par("patternStep");
+            if (bitDepth < 1 || bitDepth > 8 * container || nsr == 0 || channels < 1 || channels > 1023
+                    || samplesPerPdu < 1 || step % 2 == 0)
+                throw cRuntimeError("invalid AAF talker parameters (bit depth, nominal sample rate, channels, samples per PDU, odd pattern step)");
+            if (AVTP_AAF_HEADER_BYTES + samplesPerPdu * channels * container > 1500)
+                throw cRuntimeError("AAF PDU exceeds a 1500-byte Ethernet payload");
+        }
+    }
+
+    double sampleTime(uint64_t n) const { return double(n) / sampleRate; }
+
+    virtual void startStreaming() override
+    {
+        // PDU k is sent once its last sample is captured.
+        scheduleTimerAt(mediaClock(sampleTime(samplesPerPdu)) + ClockTime::from(processingDelay));
+    }
+
+    virtual void onTimer() override
+    {
+        const uint64_t first = pduIndex * samplesPerPdu;
+        const clocktime_t capture = mediaClock(sampleTime(first));
+        const clocktime_t presentation = capture + ClockTime::from(maxTransitTime);
+        Bytes samples;
+        for (uint64_t n = first; n < first + samplesPerPdu; ++n)
+            for (unsigned c = 0; c < channels; ++c)
+                putPcmSample(samples, pcmPatternSample(n, c, bitDepth, step), container, bitDepth);
+        auto header = makeShared<AvtpAafPcmHeader>();
+        header->setSequenceNum(sequenceNum);
+        header->setStreamId(streamId);
+        header->setAvtpTimestamp(low32(presentation));
+        header->setFormat(format);
+        header->setNsr(nsr);
+        header->setChannelsPerFrame(channels);
+        header->setBitDepth(bitDepth);
+        header->setStreamDataLength(samples.size());
+        auto packet = new Packet("AVTP-AAF");
+        packet->insertAtBack(header);
+        packet->insertAtBack(makeShared<BytesChunk>(samples));
+        tagOrigin(packet, B(AVTP_AAF_HEADER_BYTES), B(samples.size()), capture, presentation);
+        production.add(double(first), simTimeOf(capture).inUnit(SIMTIME_NS));
+        sendPdu(packet);
+        ++pduIndex;
+        scheduleTimerAt(mediaClock(sampleTime((pduIndex + 1) * samplesPerPdu)) + ClockTime::from(processingDelay));
+    }
+
+    virtual void onPdu(const DecodedMediaPdu&, Packet *) override {}
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordPhysicalRate(this, "productionRatePpm", production, sampleRate);
+    }
+};
+
+Define_Module(AafTalker);
+
+class AafListener : public AvtpMediaStreamBase
+{
+    struct Playout {
+        Bytes samples;
+        uint8_t format, bitDepth;
+        uint16_t channels;
+        int64_t presentationNs;
+    };
+    uint32_t step = 331;
+    bool haveFormat = false, haveIndex = false;
+    uint8_t format = 0, nsr = 0, bitDepth = 0;
+    uint16_t channels = 0;
+    uint64_t nextIndex = 0, unwrappedBase = 0, lastRaw = 0;
+    long samplesPlayed = 0, sampleErrors = 0, sampleGaps = 0, formatChanges = 0, timestampInvalid = 0;
+    LinearFit fit, playoutFit;   // sample index -> presentation time (listener clock) / simulation time
+    simsignal_t playedSignal;
+
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_AAF; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            step = par("patternStep");
+            playedSignal = registerSignal("samplesPlayed");
+        }
+    }
+
+    virtual void onPdu(const DecodedMediaPdu& pdu, Packet *packet) override
+    {
+        if (!pdu.tv) {
+            ++timestampInvalid;
+            return;
+        }
+        if (haveFormat && (pdu.format != format || pdu.channelsPerFrame != channels || pdu.bitDepth != bitDepth || pdu.nsr != nsr))
+            ++formatChanges;
+        haveFormat = true;
+        format = pdu.format;
+        channels = pdu.channelsPerFrame;
+        bitDepth = pdu.bitDepth;
+        nsr = pdu.nsr;
+        const auto intended = intendedTimes(packet);
+        const simtime_t release = releaseTime(pdu.avtpTimestamp, intended.empty() ? -1 : intended.begin()->second);
+        if (release < SIMTIME_ZERO)
+            return;
+        auto playout = new Playout{pdu.samples, pdu.format, pdu.bitDepth, pdu.channelsPerFrame,
+                                   reconstructTimestamp(pdu.avtpTimestamp).inUnit(SIMTIME_NS)};
+        auto message = new cMessage("aafPlayout");
+        message->setContextPointer(playout);
+        scheduleAt(release, message);
+    }
+
+    virtual void onPresentation(cMessage *message) override
+    {
+        auto playout = static_cast<Playout *>(message->getContextPointer());
+        delete message;
+        const size_t container = aafContainerBytes(playout->format);
+        const size_t frames = playout->samples.size() / (container * playout->channels);
+        const unsigned depth = playout->bitDepth;
+        const uint64_t modulus = 1ull << depth;
+        if (frames > 0) {
+            const uint64_t raw = pcmPatternIndex(getPcmSample(playout->samples.data(), container, depth), depth, step);
+            // Unwrap the pattern index (mod 2^bitDepth) into a running sample count.
+            if (haveIndex) {
+                if (raw != nextIndex % modulus) {
+                    const uint64_t gap = (raw + modulus - nextIndex % modulus) % modulus;
+                    if (gap < modulus / 2)
+                        sampleGaps += gap;
+                }
+                unwrappedBase += (raw + modulus - lastRaw) % modulus;
+            }
+            else
+                unwrappedBase = raw;
+            haveIndex = true;
+            lastRaw = raw;
+            for (size_t f = 0; f < frames; ++f)
+                for (unsigned c = 0; c < playout->channels; ++c) {
+                    const uint8_t *s = playout->samples.data() + (f * playout->channels + c) * container;
+                    if (getPcmSample(s, container, depth) != pcmPatternSample(raw + f, c, depth, step))
+                        ++sampleErrors;
+                }
+            nextIndex = raw + frames;
+            fit.add(double(unwrappedBase), double(playout->presentationNs));
+            playoutFit.add(double(unwrappedBase), simTime().inUnit(SIMTIME_NS));
+            samplesPlayed += frames;
+            emit(playedSignal, long(frames));
+        }
+        delete playout;
+    }
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordScalar("samplesPlayed", samplesPlayed);
+        recordScalar("sampleErrors", sampleErrors);
+        recordScalar("sampleGaps", sampleGaps);
+        recordScalar("formatChanges", formatChanges);
+        recordScalar("timestampInvalid", timestampInvalid);
+        if (fit.valid() && nsrToHz(nsr) > 0) {
+            double slope, residual;
+            fit.solve(slope, residual);   // ns per sample on the listener's gPTP clock
+            recordScalar("recoveredSampleRate", 1e9 / slope);
+            recordScalar("recoveredRatePpm", (1e9 / slope / nsrToHz(nsr) - 1) * 1e6);
+            recordScalar("timestampJitterMax", residual * 1e-9, "s");
+            recordPhysicalRate(this, "playoutRatePpm", playoutFit, nsrToHz(nsr));
+        }
+    }
+};
+
+Define_Module(AafListener);
+
+// ---- IEC 61883-4 MPEG-2 transport stream -------------------------------------------
+
+class Iec61883TsTalker : public AvtpMediaStreamBase
+{
+    double bitrate = 16e6;
+    simtime_t pduInterval;
+    int maxSourcePackets = 7;
+    uint64_t packetIndex = 0, tick = 0;
+    uint8_t dbc = 0;
+    long backlogTicks = 0;
+    std::unique_ptr<TsGenerator> generator;
+    LinearFit production;   // PCR (27 MHz ticks) -> simulation time of capture
+
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_61883_IIDC; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            bitrate = par("bitrate").doubleValue();
+            pduInterval = par("pduInterval");
+            maxSourcePackets = par("maxSourcePacketsPerPdu");
+            TsGeneratorConfig config;
+            config.psiIntervalPackets = par("psiIntervalPackets");
+            config.pcrIntervalPackets = par("pcrIntervalPackets");
+            config.audioEveryPackets = par("audioEveryPackets");
+            if (bitrate <= 0 || pduInterval <= 0 || maxSourcePackets < 1
+                    || AVTP_61883_HEADER_BYTES + AVTP_CIP_HEADER_BYTES + maxSourcePackets * IEC61883_4_SOURCE_PACKET_BYTES > 1500
+                    || config.psiIntervalPackets < 3 || config.pcrIntervalPackets < 3 || config.audioEveryPackets < 2)
+                throw cRuntimeError("invalid 61883-4 talker parameters (bitrate, pduInterval, maxSourcePacketsPerPdu <= 7, intervals)");
+            generator = std::make_unique<TsGenerator>(config);
+        }
+    }
+
+    // Media time of TS packet i at the nominal transport rate.
+    double packetTime(uint64_t i) const { return i * MPEG_TS_PACKET_BYTES * 8 / bitrate; }
+    // PCR in 27 MHz ticks of the (media) system clock, exact for integer bit rates.
+    uint64_t pcr27(uint64_t i) const { return i * MPEG_TS_PACKET_BYTES * 8 * 27000000ull / uint64_t(bitrate); }
+
+    virtual void startStreaming() override { scheduleTimerAt(mediaStart + ClockTime::from(pduInterval)); }
+
+    virtual void onTimer() override
+    {
+        ++tick;
+        const clocktime_t now = mediaStart + ClockTime::from(pduInterval * int64_t(tick));
+        std::vector<Bytes> sourcePackets;
+        std::vector<std::pair<clocktime_t, clocktime_t>> times;
+        while ((int)sourcePackets.size() < maxSourcePackets && mediaClock(packetTime(packetIndex)) <= now) {
+            const clocktime_t capture = mediaClock(packetTime(packetIndex));
+            const clocktime_t presentation = capture + ClockTime::from(maxTransitTime);
+            Bytes sp;
+            const uint32_t sph = low32(presentation);
+            for (int shift = 24; shift >= 0; shift -= 8)
+                sp.push_back(uint8_t(sph >> shift));
+            const Bytes ts = generator->packet(packetIndex, pcr27(packetIndex));
+            sp.insert(sp.end(), ts.begin(), ts.end());
+            sourcePackets.push_back(sp);
+            times.push_back({capture, presentation});
+            if (packetIndex % 100 == 0)
+                production.add(double(pcr27(packetIndex)), simTimeOf(capture).inUnit(SIMTIME_NS));
+            ++packetIndex;
+        }
+        if (mediaClock(packetTime(packetIndex)) <= now)
+            ++backlogTicks;     // more packets due than one PDU carries
+        if (!sourcePackets.empty()) {
+            auto header = makeShared<Avtp61883Header>();
+            header->setSequenceNum(sequenceNum);
+            header->setStreamId(streamId);
+            header->setAvtpTimestamp(low32(times.front().second));
+            header->setStreamDataLength(AVTP_CIP_HEADER_BYTES + sourcePackets.size() * IEC61883_4_SOURCE_PACKET_BYTES);
+            header->setDbc(dbc);
+            dbc += 8 * sourcePackets.size();    // 8 data blocks of 24 bytes per source packet
+            auto packet = new Packet("AVTP-61883-4-TS");
+            packet->insertAtBack(header);
+            for (size_t i = 0; i < sourcePackets.size(); ++i) {
+                const b offset = packet->getTotalLength();
+                packet->insertAtBack(makeShared<BytesChunk>(sourcePackets[i]));
+                tagOrigin(packet, offset, B(IEC61883_4_SOURCE_PACKET_BYTES), times[i].first, times[i].second);
+            }
+            sendPdu(packet);
+        }
+        scheduleTimerAt(mediaStart + ClockTime::from(pduInterval * int64_t(tick + 1)));
+    }
+
+    virtual void onPdu(const DecodedMediaPdu&, Packet *) override {}
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordScalar("tsPacketsSent", packetIndex);
+        recordScalar("backlogTicks", backlogTicks);
+        recordPhysicalRate(this, "productionSystemClockPpm", production, 27e6);
+    }
+};
+
+Define_Module(Iec61883TsTalker);
+
+class Iec61883TsListener : public AvtpMediaStreamBase
+{
+    struct Output {
+        Bytes ts;
+        int64_t presentationNs;
+    };
+    TsGeneratorConfig config;
+    bool haveDbc = false;
+    uint8_t expectedDbc = 0;
+    std::map<uint16_t, uint8_t> lastCc;
+    long tsPackets = 0, syncErrors = 0, ccErrors = 0, psiCrcErrors = 0, patCount = 0, pmtCount = 0;
+    long payloadErrors = 0, dbcErrors = 0, pcrCount = 0, unknownPid = 0;
+    LinearFit pcrFit, outputFit;   // PCR against the listener clock / simulation time at output
+    simsignal_t tsSignal;
+
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_61883_IIDC; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL)
+            tsSignal = registerSignal("tsPacketOutput");
+    }
+
+    virtual void onPdu(const DecodedMediaPdu& pdu, Packet *packet) override
+    {
+        if (haveDbc && pdu.dbc != expectedDbc)
+            ++dbcErrors;
+        haveDbc = true;
+        expectedDbc = pdu.dbc + 8 * pdu.sourcePackets.size();
+        const auto intended = intendedTimes(packet);
+        for (size_t i = 0; i < pdu.sourcePackets.size(); ++i) {
+            const auto& sp = pdu.sourcePackets[i];
+            const auto it = intended.find(AVTP_61883_HEADER_BYTES + AVTP_CIP_HEADER_BYTES + i * IEC61883_4_SOURCE_PACKET_BYTES);
+            const simtime_t release = releaseTime(sp.timestamp, it != intended.end() ? it->second : simtime_t(-1));
+            if (release < SIMTIME_ZERO)
+                continue;
+            auto message = new cMessage("tsOutput");
+            message->setContextPointer(new Output{sp.tsPacket, reconstructTimestamp(sp.timestamp).inUnit(SIMTIME_NS)});
+            scheduleAt(release, message);
+        }
+    }
+
+    bool checkSection(const Bytes& ts, const TsPacketInfo& info)
+    {
+        // pointer_field 0, then one section: table_id, section_length, ..., CRC_32.
+        const size_t start = info.payloadOffset + 1 + ts[info.payloadOffset];
+        if (start + 3 > ts.size())
+            return false;
+        const size_t length = ((ts[start + 1] & 0x0f) << 8) | ts[start + 2];
+        if (start + 3 + length > ts.size() || length < 4)
+            return false;
+        // The CRC over the whole section including CRC_32 is zero.
+        return crc32Mpeg2(ts.data() + start, 3 + length) == 0;
+    }
+
+    virtual void onPresentation(cMessage *message) override
+    {
+        auto output = static_cast<Output *>(message->getContextPointer());
+        delete message;
+        const Bytes& ts = output->ts;
+        const TsPacketInfo info = parseTsPacket(ts.data());
+        ++tsPackets;
+        emit(tsSignal, long(info.pid));
+        if (!info.syncOk || info.tei) {
+            ++syncErrors;
+            delete output;
+            return;
+        }
+        if (info.adaptationFieldControl & 1) {
+            auto it = lastCc.find(info.pid);
+            if (it != lastCc.end() && info.continuityCounter != ((it->second + 1) & 0x0f) && !info.discontinuity)
+                ++ccErrors;
+            lastCc[info.pid] = info.continuityCounter;
+        }
+        if (info.hasPcr && info.pid == config.videoPid) {
+            ++pcrCount;
+            pcrFit.add(double(output->presentationNs), double(info.pcr27));
+            outputFit.add(double(info.pcr27), simTime().inUnit(SIMTIME_NS));
+        }
+        if (info.pid == 0x0000 || info.pid == config.pmtPid) {
+            (info.pid == 0 ? patCount : pmtCount)++;
+            const Bytes expected = info.pid == 0 ? TsGenerator::patSection(config) : TsGenerator::pmtSection(config);
+            const size_t start = info.payloadOffset + 1;
+            if (!checkSection(ts, info))
+                ++psiCrcErrors;
+            else if (!std::equal(expected.begin(), expected.end(), ts.begin() + start))
+                ++payloadErrors;
+        }
+        else if (info.pid == config.videoPid || info.pid == config.audioPid) {
+            const uint8_t *p = ts.data() + info.payloadOffset;
+            const uint32_t index = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+            for (size_t j = info.payloadOffset + 4; j < ts.size(); ++j)
+                if (ts[j] != uint8_t(index + j)) {
+                    ++payloadErrors;
+                    break;
+                }
+        }
+        else
+            ++unknownPid;
+        delete output;
+    }
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordScalar("tsPacketsOutput", tsPackets);
+        recordScalar("syncErrors", syncErrors);
+        recordScalar("continuityErrors", ccErrors);
+        recordScalar("psiCrcErrors", psiCrcErrors);
+        recordScalar("patReceived", patCount);
+        recordScalar("pmtReceived", pmtCount);
+        recordScalar("payloadErrors", payloadErrors);
+        recordScalar("unknownPid", unknownPid);
+        recordScalar("dbcErrors", dbcErrors);
+        recordScalar("pcrReceived", pcrCount);
+        if (pcrFit.valid()) {
+            // PCR ticks per ns of the listener clock -> recovered 27 MHz rate; jitter
+            // is the largest PCR deviation from the fitted line (PCR accuracy).
+            double slope, residual;
+            pcrFit.solve(slope, residual);
+            recordScalar("recoveredSystemClockPpm", (slope * 1e9 / 27e6 - 1) * 1e6);
+            recordScalar("pcrJitterMax", residual / 27e6, "s");
+            recordPhysicalRate(this, "outputSystemClockPpm", outputFit, 27e6);
+        }
+    }
+};
+
+Define_Module(Iec61883TsListener);
+
+// ---- CRF media clock reference ----------------------------------------------------
+
+class CrfTalker : public AvtpMediaStreamBase
+{
+    uint32_t baseFrequency = 48000;
+    uint8_t pull = 0, type = CRF_AUDIO_SAMPLE;
+    unsigned timestampInterval = 160, timestampsPerPdu = 6;
+    simtime_t timestampOffset;
+    uint64_t pduIndex = 0;
+    LinearFit production;   // media clock events -> simulation time
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_CRF; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL) {
+            baseFrequency = par("baseFrequency");
+            pull = par("pull");
+            type = par("crfType");
+            timestampInterval = par("timestampInterval");
+            timestampsPerPdu = par("timestampsPerPdu");
+            timestampOffset = par("timestampOffset");
+            if (timestampOffset < 0)
+                timestampOffset = maxTransitTime;
+            if (baseFrequency == 0 || baseFrequency > 0x1fffffff || pull > 5 || timestampInterval < 1
+                    || timestampInterval > 0xffff || timestampsPerPdu < 1 || timestampsPerPdu > 185)
+                throw cRuntimeError("invalid CRF talker parameters");
+        }
+    }
+
+    double eventTime(uint64_t j) const { return double(j) * timestampInterval / baseFrequency; }
+
+    virtual void startStreaming() override
+    {
+        // The talker is the media clock source and knows its future edges: PDU k is
+        // sent at its first event, so every timestamp reaches the listener in advance.
+        scheduleTimerAt(mediaClock(eventTime(0)) + ClockTime::from(processingDelay));
+    }
+
+    virtual void onTimer() override
+    {
+        const uint64_t first = pduIndex * timestampsPerPdu;
+        auto pdu = makeShared<AvtpCrfPdu>();
+        pdu->setSequenceNum(sequenceNum);
+        pdu->setType(type);
+        pdu->setStreamId(streamId);
+        pdu->setPull(pull);
+        pdu->setBaseFrequency(baseFrequency);
+        pdu->setTimestampInterval(timestampInterval);
+        pdu->setCrfTimestampArraySize(timestampsPerPdu);
+        for (unsigned i = 0; i < timestampsPerPdu; ++i) {
+            const clocktime_t event = mediaClock(eventTime(first + i));
+            pdu->setCrfTimestamp(i, (event + ClockTime::from(timestampOffset)).inUnit(SIMTIME_NS));
+            production.add(double((first + i) * timestampInterval), simTimeOf(event).inUnit(SIMTIME_NS));
+        }
+        pdu->setCrfDataLength(8 * timestampsPerPdu);
+        pdu->setChunkLength(B(AVTP_CRF_HEADER_BYTES + 8 * timestampsPerPdu));
+        auto packet = new Packet("AVTP-CRF");
+        packet->insertAtBack(pdu);
+        sendPdu(packet);
+        ++pduIndex;
+        scheduleTimerAt(mediaClock(eventTime(pduIndex * timestampsPerPdu)) + ClockTime::from(processingDelay));
+    }
+
+    virtual void onPdu(const DecodedMediaPdu&, Packet *) override {}
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordPhysicalRate(this, "productionMediaClockPpm", production, baseFrequency);
+    }
+};
+
+Define_Module(CrfTalker);
+
+class CrfListener : public AvtpMediaStreamBase
+{
+    bool haveLast = false;
+    uint64_t lastTimestamp = 0, eventCount = 0;
+    long timestampsReceived = 0, nonMonotonic = 0, parameterChanges = 0, lateTimestamps = 0;
+    uint32_t baseFrequency = 0;
+    uint16_t interval = 0;
+    uint8_t pull = 0;
+    LinearFit fit, regenerated;   // events -> timestamp / simulation time at which this clock reaches it
+    simsignal_t slackToTimestamp;
+
+  protected:
+    virtual uint8_t expectedSubtype() const override { return AVTP_SUBTYPE_CRF; }
+
+    virtual void initialize(int stage) override
+    {
+        AvtpMediaStreamBase::initialize(stage);
+        if (stage == INITSTAGE_LOCAL)
+            slackToTimestamp = registerSignal("crfTimestampSlack");
+    }
+
+    static double pullFactor(uint8_t pull)
+    {
+        static const double factors[] = {1.0, 1.0 / 1.001, 1.001, 24.0 / 25.0, 25.0 / 24.0, 1.0 / 8.0};
+        return factors[pull];
+    }
+
+    virtual void onPdu(const DecodedMediaPdu& pdu, Packet *) override
+    {
+        if (baseFrequency != 0 && (pdu.baseFrequency != baseFrequency || pdu.timestampInterval != interval || pdu.pull != pull))
+            ++parameterChanges;
+        baseFrequency = pdu.baseFrequency;
+        interval = pdu.timestampInterval;
+        pull = pdu.pull;
+        const int64_t now = getClockTime().inUnit(SIMTIME_NS);
+        for (uint64_t timestamp : pdu.crfTimestamps) {
+            ++timestampsReceived;
+            if (haveLast && timestamp <= lastTimestamp)
+                ++nonMonotonic;
+            // Media clock events between consecutive timestamps (robust to lost PDUs).
+            if (haveLast) {
+                const double nominal = 1e9 * interval / (baseFrequency * pullFactor(pull));
+                eventCount += std::max<int64_t>(1, std::llround((double(timestamp) - double(lastTimestamp)) / nominal));
+            }
+            haveLast = true;
+            lastTimestamp = timestamp;
+            fit.add(double(eventCount), double(timestamp));
+            // The regenerated media clock ticks when the local gPTP clock reaches the timestamp.
+            regenerated.add(double(eventCount) * interval, simTimeOf(ClockTime(int64_t(timestamp), SIMTIME_NS)).inUnit(SIMTIME_NS));
+            const int64_t slack = int64_t(timestamp) - now;
+            if (slack < 0)
+                ++lateTimestamps;
+            emit(slackToTimestamp, SimTime(slack, SIMTIME_NS));
+        }
+    }
+
+    virtual void finish() override
+    {
+        AvtpMediaStreamBase::finish();
+        recordScalar("crfTimestampsReceived", timestampsReceived);
+        recordScalar("crfNonMonotonic", nonMonotonic);
+        recordScalar("crfParameterChanges", parameterChanges);
+        recordScalar("crfLateTimestamps", lateTimestamps);
+        if (fit.valid() && baseFrequency > 0) {
+            double slope, residual;   // ns per 'interval' media clock events
+            fit.solve(slope, residual);
+            const double frequency = 1e9 * interval / slope;
+            recordScalar("recoveredMediaClock", frequency);
+            recordScalar("recoveredMediaClockPpm", (frequency / (baseFrequency * pullFactor(pull)) - 1) * 1e6);
+            recordScalar("crfTimestampJitterMax", residual * 1e-9, "s");
+            recordPhysicalRate(this, "regeneratedMediaClockPpm", regenerated, baseFrequency * pullFactor(pull));
+        }
+    }
+};
+
+Define_Module(CrfListener);
+
+} // namespace SignalsAndGateways

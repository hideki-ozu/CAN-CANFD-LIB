new file mode 100644
index 0000000..670c0c6
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaCodec.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// Validating byte-level decoder for IEEE 1722-2016 AAF (PCM), CRF and 61883/IIDC
+// (IEC 61883-4 MPEG-2 TS) PDUs, independent of the chunk serializers, plus the
+// synthetic media content used by the talkers and checked by the listeners:
+// a PCM test pattern and an MPEG-2 transport stream (PAT, PMT, PCR, video/audio PIDs).
+#ifndef SIGNALSANDGATEWAYS_AVTPMEDIACODEC_H_
+#define SIGNALSANDGATEWAYS_AVTPMEDIACODEC_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <vector>
+
+namespace SignalsAndGateways {
+namespace avtp {
+namespace media {
+
+using Bytes = std::vector<uint8_t>;
+
+enum class MediaError {
+    NONE,
+    PDU_TOO_SHORT,
+    UNSUPPORTED_SUBTYPE,
+    UNSUPPORTED_VERSION,
+    STREAM_ID_NOT_VALID,
+    DATA_LENGTH_EXCEEDS_PDU,
+    AAF_FORMAT_NOT_PCM,
+    AAF_CHANNELS_ZERO,
+    AAF_BIT_DEPTH_INVALID,
+    AAF_PARTIAL_FRAME,
+    CRF_DATA_LENGTH_INVALID,
+    CRF_BASE_FREQUENCY_ZERO,
+    CRF_PULL_RESERVED,
+    IEC61883_NO_CIP,
+    IEC61883_CHANNEL_NOT_AVTP,
+    IEC61883_TCODE,
+    IEC61883_CIP_QUADLET_INDICATOR,
+    IEC61883_SID_NOT_AVTP,
+    IEC61883_FORMAT_UNSUPPORTED,
+    IEC61883_4_CIP_PARAMETERS,
+    IEC61883_4_DATA_LENGTH,
+};
+
+const char *toString(MediaError error);
+
+enum AafFormat : uint8_t { AAF_USER = 0x00, AAF_FLOAT_32BIT = 0x01, AAF_INT_32BIT = 0x02, AAF_INT_24BIT = 0x03, AAF_INT_16BIT = 0x04 };
+enum CrfType : uint8_t { CRF_USER = 0x00, CRF_AUDIO_SAMPLE = 0x01, CRF_VIDEO_FRAME = 0x02, CRF_VIDEO_LINE = 0x03, CRF_MACHINE_CYCLE = 0x04 };
+
+// Container bytes of an AAF PCM sample (0 for the user format).
+size_t aafContainerBytes(uint8_t format);
+// Nominal sample rate code (nsr) <-> Hz; 0 = user-specified / unknown.
+uint32_t nsrToHz(uint8_t nsr);
+uint8_t hzToNsr(uint32_t hz);
+
+struct SourcePacket {
+    uint32_t timestamp = 0;     // source packet header: presentation time, gPTP ns mod 2^32
+    Bytes tsPacket;             // 188 bytes
+};
+
+struct DecodedMediaPdu {
+    MediaError error = MediaError::NONE;
+    uint8_t subtype = 0;
+    uint8_t sequenceNum = 0;
+    uint64_t streamId = 0;
+    bool mr = false, tv = false, tu = false;
+    uint32_t avtpTimestamp = 0;
+    // AAF
+    uint8_t format = 0, nsr = 0, bitDepth = 0, evt = 0;
+    uint16_t channelsPerFrame = 0;
+    bool sp = false;
+    Bytes samples;
+    // CRF
+    uint8_t crfType = 0, pull = 0;
+    bool fs = false;
+    uint32_t baseFrequency = 0;
+    uint16_t timestampInterval = 0;
+    std::vector<uint64_t> crfTimestamps;
+    // IEC 61883-4
+    bool gv = false;
+    uint32_t gatewayInfo = 0;
+    uint8_t dbs = 0, fn = 0, qpc = 0, dbc = 0, fmt = 0, sid = 0;
+    bool sph = false, tsf = false;
+    std::vector<SourcePacket> sourcePackets;
+};
+
+// Decodes one AAF, CRF or 61883/IIDC PDU; bytes beyond the declared data length
+// (Ethernet padding) are ignored.
+DecodedMediaPdu decodeMediaPdu(const uint8_t *data, size_t size);
+inline DecodedMediaPdu decodeMediaPdu(const Bytes& b) { return decodeMediaPdu(b.data(), b.size()); }
+
+// ---- synthetic content ---------------------------------------------------------
+
+// PCM test pattern: sample n of channel c is ((n + 1000 c) * step) mod 2^bitDepth as a
+// signed two's complement value. With an odd step, n mod 2^bitDepth can be recovered.
+int32_t pcmPatternSample(uint64_t n, unsigned channel, unsigned bitDepth, uint32_t step);
+// Big-endian container encoding, the bitDepth valid bits left-justified.
+void putPcmSample(Bytes& out, int32_t value, size_t containerBytes, unsigned bitDepth);
+int32_t getPcmSample(const uint8_t *in, size_t containerBytes, unsigned bitDepth);
+// Sample index (mod 2^bitDepth) whose channel-0 pattern value is 'value'.
+uint64_t pcmPatternIndex(int32_t value, unsigned bitDepth, uint32_t step);
+
+// CRC-32/MPEG-2 (poly 0x04C11DB7, init 0xFFFFFFFF, not reflected, no final XOR).
+uint32_t crc32Mpeg2(const uint8_t *data, size_t length);
+
+struct TsPacketInfo {
+    bool syncOk = false, tei = false, pusi = false, discontinuity = false, hasPcr = false;
+    uint16_t pid = 0;
+    uint8_t scrambling = 0, adaptationFieldControl = 0, continuityCounter = 0;
+    uint64_t pcr27 = 0;         // PCR in 27 MHz ticks (base * 300 + extension)
+    size_t payloadOffset = 188;
+};
+TsPacketInfo parseTsPacket(const uint8_t *packet);
+
+struct TsGeneratorConfig {
+    uint16_t transportStreamId = 1;
+    uint16_t programNumber = 1;
+    uint16_t pmtPid = 0x1000;
+    uint16_t videoPid = 0x0100;             // also the PCR PID
+    uint16_t audioPid = 0x0110;
+    uint8_t videoStreamType = 0x1B;         // H.264
+    uint8_t audioStreamType = 0x0F;         // AAC (ADTS)
+    unsigned psiIntervalPackets = 1000;     // PAT at index % interval == 0, PMT at 1
+    unsigned pcrIntervalPackets = 397;      // PCR on the first video packet at or after each due index (2, 2 + n, ...)
+    unsigned audioEveryPackets = 10;        // audio packet at index % n == n - 1
+};
+
+// Synthetic MPEG-2 TS: call packet() with consecutive indices. Elementary stream
+// packets carry the packet index in their first 4 payload bytes followed by the
+// pattern (index + byte) & 0xFF; PAT and PMT are complete sections with CRC.
+class TsGenerator {
+public:
+    explicit TsGenerator(const TsGeneratorConfig& config) : config(config) {}
+    Bytes packet(uint64_t index, uint64_t pcr27);
+    static Bytes patSection(const TsGeneratorConfig& config);
+    static Bytes pmtSection(const TsGeneratorConfig& config);
+    const TsGeneratorConfig& getConfig() const { return config; }
+private:
+    TsGeneratorConfig config;
+    std::map<uint16_t, uint8_t> continuity;
+    uint64_t nextPcr = 2;
+};
+
+} // namespace media
+} // namespace avtp
+} // namespace SignalsAndGateways
+
+#endif
diff --git a/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSelfTest.cc b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSelfTest.cc
new file mode 100644
index 0000000..ca54e60
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSelfTest.cc
@@ -0,0 +1,287 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// Golden vectors for AAF PCM, CRF and IEC 61883-4 were written by hand from the
+// IEEE 1722-2016 field tables (cross-checked with Open1722, the Wireshark dissector
+// and OpenAvnu); they are independent of the serializer code. Also: serializer
+// round trips, decoder rejection of malformed PDUs, MPEG-2 TS / PCR / CRC helpers
+// and the PCM test pattern.
+#include <string>
+
+#include "inet/common/packet/Packet.h"
+#include "inet/common/packet/chunk/BytesChunk.h"
+#include "signalsandgateways/inet4/avtp/media/AvtpMedia_m.h"
+#include "signalsandgateways/inet4/avtp/media/AvtpMediaCodec.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SignalsAndGateways {
+
+using namespace avtp::media;
+
+class AvtpMediaSelfTest : public cSimpleModule
+{
+    int passed = 0, failed = 0;
+
+    void check(const std::string& name, bool condition)
+    {
+        condition ? ++passed : ++failed;
+        EV_INFO << "CHECK " << name << (condition ? " PASS" : " FAIL") << endl;
+        if (!condition)
+            std::cout << "AVTP media self-test FAILED: " << name << endl;
+    }
+
+    static Bytes hex(const std::string& text)
+    {
+        Bytes out;
+        for (size_t i = 0; i + 1 < text.size();) {
+            if (text[i] == ' ') { ++i; continue; }
+            out.push_back(uint8_t(std::stoul(text.substr(i, 2), nullptr, 16)));
+            i += 2;
+        }
+        return out;
+    }
+
+    static Bytes serialize(const std::vector<Ptr<const Chunk>>& chunks)
+    {
+        Packet packet("golden");
+        for (const auto& chunk : chunks)
+            packet.insertAtBack(chunk);
+        return packet.peekAllAsBytes()->getBytes();
+    }
+
+    static const uint64_t STREAM = 0x0200000001010001ull;
+
+    void testAaf()
+    {
+        auto h = makeShared<AvtpAafPcmHeader>();
+        h->setSequenceNum(0x12);
+        h->setStreamId(STREAM);
+        h->setAvtpTimestamp(0x11223344);
+        h->setFormat(AAF_INT_16BIT);
+        h->setNsr(hzToNsr(48000));
+        h->setChannelsPerFrame(2);
+        h->setBitDepth(16);
+        h->setStreamDataLength(4);
+        Bytes samples;
+        putPcmSample(samples, pcmPatternSample(0, 0, 16, 331), 2, 16);
+        putPcmSample(samples, pcmPatternSample(0, 1, 16, 331), 2, 16);   // 1000 * 331 mod 2^16 = 0x0CF8
+        const Bytes wire = serialize({h, makeShared<BytesChunk>(samples)});
+        check("aaf-golden", wire == hex("02 81 12 00 0200000001010001 11223344 04 5002 10 0004 00 00 0000 0cf8"));
+        const DecodedMediaPdu d = decodeMediaPdu(wire);
+        check("aaf-decode", d.error == MediaError::NONE && d.subtype == 0x02 && d.sequenceNum == 0x12
+                && d.streamId == STREAM && d.tv && d.avtpTimestamp == 0x11223344 && d.format == AAF_INT_16BIT
+                && d.nsr == 5 && d.channelsPerFrame == 2 && d.bitDepth == 16 && d.samples == samples);
+        Packet packet("roundtrip", makeShared<BytesChunk>(wire));
+        const auto& back = packet.peekAtFront<AvtpAafPcmHeader>();
+        check("aaf-deserialize", back->getSequenceNum() == 0x12 && back->getNsr() == 5 && back->getChannelsPerFrame() == 2
+                && back->getBitDepth() == 16 && back->getStreamDataLength() == 4 && back->getTv() && !back->getSp());
+        auto flags = makeShared<AvtpAafPcmHeader>(*h);
+        flags->setMr(true);
+        flags->setTu(true);
+        flags->setSp(true);
+        flags->setEvt(0x0a);
+        flags->setChannelsPerFrame(0x3ff);
+        flags->setNsr(0x0a);
+        check("aaf-flags", serialize({flags, makeShared<BytesChunk>(samples)}) ==
+              hex("02 89 12 01 0200000001010001 11223344 04 a3ff 10 0004 1a 00 0000 0cf8"));
+        // Malformed PDUs
+        auto reject = [&](const char *name, Bytes pdu, MediaError expected) {
+            check(std::string("reject-") + name, decodeMediaPdu(pdu).error == expected);
+        };
+        Bytes bad = wire; bad[16] = 0x05;               // AES3
+        reject("aaf-aes3", bad, MediaError::AAF_FORMAT_NOT_PCM);
+        bad = wire; bad[17] = 0x50; bad[18] = 0x00;     // 0 channels
+        reject("aaf-no-channels", bad, MediaError::AAF_CHANNELS_ZERO);
+        bad = wire; bad[19] = 17;                       // 17 bits in a 16-bit container
+        reject("aaf-bit-depth", bad, MediaError::AAF_BIT_DEPTH_INVALID);
+        bad = wire; bad[21] = 3; bad.pop_back();         // 3 bytes: not a whole frame
+        reject("aaf-partial-frame", bad, MediaError::AAF_PARTIAL_FRAME);
+        bad = wire; bad[21] = 8;
+        reject("aaf-length", bad, MediaError::DATA_LENGTH_EXCEEDS_PDU);
+        bad = wire; bad[1] = 0x01;
+        reject("aaf-sv0", bad, MediaError::STREAM_ID_NOT_VALID);
+        bad = wire; bad[1] = 0x91;
+        reject("aaf-version1", bad, MediaError::UNSUPPORTED_VERSION);
+        bad = wire; bad[0] = 0x03;                      // CVF
+        reject("cvf-subtype", bad, MediaError::UNSUPPORTED_SUBTYPE);
+        reject("aaf-truncated", Bytes(wire.begin(), wire.begin() + 20), MediaError::PDU_TOO_SHORT);
+        // Ethernet padding beyond stream_data_length is ignored.
+        bad = wire; bad.resize(46, 0);
+        check("aaf-ethernet-padding", decodeMediaPdu(bad).samples == samples);
+    }
+
+    void testCrf()
+    {
+        auto c = makeShared<AvtpCrfPdu>();
+        c->setSequenceNum(7);
+        c->setType(CRF_AUDIO_SAMPLE);
+        c->setStreamId(STREAM + 2);
+        c->setBaseFrequency(48000);
+        c->setTimestampInterval(160);
+        c->setCrfTimestampArraySize(2);
+        c->setCrfTimestamp(0, 0x0000000100000000ull);
+        c->setCrfTimestamp(1, 0x0000000100000d05ull);  // + 3333 ns
+        c->setCrfDataLength(16);
+        c->setChunkLength(B(AVTP_CRF_HEADER_BYTES + 16));
+        const Bytes wire = serialize({c});
+        check("crf-golden", wire == hex("04 80 07 01 0200000001010003 0000bb80 0010 00a0 0000000100000000 0000000100000d05"));
+        const DecodedMediaPdu d = decodeMediaPdu(wire);
+        check("crf-decode", d.error == MediaError::NONE && d.crfType == 1 && d.baseFrequency == 48000 && d.pull == 0
+                && d.timestampInterval == 160 && d.crfTimestamps == std::vector<uint64_t>({0x100000000ull, 0x100000d05ull}));
+        auto flags = makeShared<AvtpCrfPdu>(*c);
+        flags->setMr(true);
+        flags->setFs(true);
+        flags->setTu(true);
+        flags->setPull(4);
+        flags->setBaseFrequency(0x1fffffff);
+        check("crf-flags", serialize({flags}) == hex("04 8b 07 01 0200000001010003 9fffffff 0010 00a0 0000000100000000 0000000100000d05"));
+        Packet packet("roundtrip", makeShared<BytesChunk>(wire));
+        const auto& back = packet.peekAtFront<AvtpCrfPdu>();
+        check("crf-deserialize", back->getCrfTimestampArraySize() == 2 && back->getCrfTimestamp(1) == 0x100000d05ull
+                && back->getBaseFrequency() == 48000 && back->getChunkLength() == B(36));
+        Bytes bad = wire; bad[17] = 12;
+        check("reject-crf-length-not-multiple-of-8", decodeMediaPdu(bad).error == MediaError::CRF_DATA_LENGTH_INVALID);
+        bad = wire; bad[17] = 0;
+        check("reject-crf-no-data", decodeMediaPdu(bad).error == MediaError::CRF_DATA_LENGTH_INVALID);
+        bad = wire; bad[14] = 0; bad[15] = 0;
+        check("reject-crf-base-frequency-0", decodeMediaPdu(bad).error == MediaError::CRF_BASE_FREQUENCY_ZERO);
+        bad = wire; bad[12] = 0xc0;
+        check("reject-crf-pull-reserved", decodeMediaPdu(bad).error == MediaError::CRF_PULL_RESERVED);
+        bad = wire; bad[17] = 24;
+        check("reject-crf-length", decodeMediaPdu(bad).error == MediaError::DATA_LENGTH_EXCEEDS_PDU);
+    }
+
+    void test61883()
+    {
+        TsGeneratorConfig config;
+        TsGenerator generator(config);
+        Bytes ts;
+        for (uint64_t i = 0; i <= 5; ++i)
+            ts = generator.packet(i, 0);       // index 5: video without PCR, 4th video packet (CC 3)
+        auto h = makeShared<Avtp61883Header>();
+        h->setSequenceNum(3);
+        h->setStreamId(STREAM + 1);
+        h->setAvtpTimestamp(0xaabbccdd);
+        h->setStreamDataLength(8 + 192);
+        h->setDbc(0x10);
+        Bytes sp = hex("aabbccdd");
+        sp.insert(sp.end(), ts.begin(), ts.end());
+        const Bytes wire = serialize({h, makeShared<BytesChunk>(sp)});
+        Bytes expected = hex("00 81 03 00 0200000001010002 aabbccdd 00000000 00c8 5f a0 3f 06 c4 10 a0 00 00 00");
+        expected.insert(expected.end(), sp.begin(), sp.end());
+        check("61883-4-golden", wire == expected);
+        check("61883-4-ts-packet", ts.size() == 188 && ts[0] == 0x47 && ts[1] == 0x01 && ts[2] == 0x00 && ts[3] == 0x13
+                && ts[4] == 0 && ts[7] == 5 && ts[8] == uint8_t(5 + 8));
+        const DecodedMediaPdu d = decodeMediaPdu(wire);
+        check("61883-4-decode", d.error == MediaError::NONE && d.subtype == 0 && d.tv && d.avtpTimestamp == 0xaabbccdd
+                && d.sid == 63 && d.dbs == 6 && d.fn == 3 && d.qpc == 0 && d.sph && d.dbc == 0x10 && d.fmt == 0x20 && !d.tsf
+                && d.sourcePackets.size() == 1 && d.sourcePackets[0].timestamp == 0xaabbccdd && d.sourcePackets[0].tsPacket == ts);
+        Packet packet("roundtrip", makeShared<BytesChunk>(wire));
+        const auto& back = packet.peekAtFront<Avtp61883Header>();
+        check("61883-4-deserialize", back->isCorrect() && back->getTag() == 1 && back->getChannel() == 31 && back->getTcode() == 0x0a
+                && back->getSid() == 63 && back->getDbs() == 6 && back->getFn() == 3 && back->getSph() && back->getDbc() == 0x10
+                && back->getFmt() == 0x20 && back->getStreamDataLength() == 200);
+        auto flags = makeShared<Avtp61883Header>(*h);
+        flags->setMr(true);
+        flags->setGv(true);
+        flags->setTu(true);
+        flags->setGatewayInfo(0x01020304);
+        flags->setTsf(true);
+        Bytes flagged = hex("00 8b 03 01 0200000001010002 aabbccdd 01020304 00c8 5f a0 3f 06 c4 10 a0 80 00 00");
+        flagged.insert(flagged.end(), sp.begin(), sp.end());
+        check("61883-4-flags", serialize({flags, makeShared<BytesChunk>(sp)}) == flagged);
+        auto reject = [&](const char *name, size_t index, uint8_t value, MediaError error) {
+            Bytes bad = wire;
+            bad[index] = value;
+            check(std::string("reject-61883-") + name, decodeMediaPdu(bad).error == error);
+        };
+        reject("no-cip", 22, 0x1f, MediaError::IEC61883_NO_CIP);
+        reject("channel", 22, 0x5e, MediaError::IEC61883_CHANNEL_NOT_AVTP);
+        reject("tcode", 23, 0x90, MediaError::IEC61883_TCODE);
+        reject("qi1", 24, 0x7f, MediaError::IEC61883_CIP_QUADLET_INDICATOR);
+        reject("qi2", 28, 0x20, MediaError::IEC61883_CIP_QUADLET_INDICATOR);
+        reject("sid", 24, 0x05, MediaError::IEC61883_SID_NOT_AVTP);
+        reject("61883-6-format", 28, 0x90, MediaError::IEC61883_FORMAT_UNSUPPORTED);
+        reject("dbs", 25, 8, MediaError::IEC61883_4_CIP_PARAMETERS);
+        reject("fn", 26, 0x84, MediaError::IEC61883_4_CIP_PARAMETERS);
+        reject("no-sph", 26, 0xc0, MediaError::IEC61883_4_CIP_PARAMETERS);
+        reject("data-length", 21, 0xc4, MediaError::IEC61883_4_DATA_LENGTH);
+        reject("length-exceeds", 21, 0xd0, MediaError::DATA_LENGTH_EXCEEDS_PDU);
+    }
+
+    void testMpegTs()
+    {
+        const Bytes s = {'1', '2', '3', '4', '5', '6', '7', '8', '9'};
+        check("crc32-mpeg2-check", crc32Mpeg2(s.data(), s.size()) == 0x0376E6E7u);
+        TsGeneratorConfig config;
+        const Bytes pat = TsGenerator::patSection(config), pmt = TsGenerator::pmtSection(config);
+        check("pat-section", pat.size() == 16 && Bytes(pat.begin(), pat.begin() + 12) == hex("00 b00d 0001 c1 00 00 0001 f000")
+                && crc32Mpeg2(pat.data(), pat.size()) == 0);
+        check("pmt-section", pmt.size() == 26 && Bytes(pmt.begin(), pmt.begin() + 22) == hex("02 b017 0001 c1 00 00 e100 f000 1b e100 f000 0f e110 f000")
+                && crc32Mpeg2(pmt.data(), pmt.size()) == 0);
+        TsGenerator generator(config);
+        const uint64_t pcr = 0x1FFFFFFFFull * 300 + 299;    // largest PCR value
+        Bytes packet;
+        bool ccOk = true;
+        TsPacketInfo last;
+        for (uint64_t i = 0; i <= 400; ++i) {
+            packet = generator.packet(i, pcr);
+            const TsPacketInfo info = parseTsPacket(packet.data());
+            if (i >= 2 && info.pid == config.videoPid && last.pid == config.videoPid)
+                ccOk &= info.continuityCounter == ((last.continuityCounter + 1) & 0x0f);
+            if (info.pid == config.videoPid)
+                last = info;
+        }
+        const TsPacketInfo info = parseTsPacket(packet.data());   // PCR due at 399 (audio slot) moves to video packet 400
+        check("ts-pcr-roundtrip", info.syncOk && info.hasPcr && info.pcr27 == pcr && info.pid == config.videoPid
+                && info.adaptationFieldControl == 3 && info.payloadOffset == 12 && packet[5] == 0x10);
+        check("ts-continuity", ccOk);
+        // Small extension (< 256) and the PCR field bytes written out by hand.
+        TsGenerator small(config);
+        for (uint64_t i = 0; i < 2; ++i)
+            small.packet(i, 0);
+        const Bytes pcrPacket = small.packet(2, 1234567ull * 300 + 17);
+        check("ts-pcr-bytes", Bytes(pcrPacket.begin() + 4, pcrPacket.begin() + 12) == hex("07 10 00 09 6b 43 fe 11")
+                && parseTsPacket(pcrPacket.data()).pcr27 == 1234567ull * 300 + 17);
+        check("ts-pat-packet", generator.packet(1000, 0)[1] == 0x40 && parseTsPacket(generator.packet(2000, 0).data()).pusi);
+        bool pcmOk = true;
+        for (unsigned depth : {8u, 16u, 20u, 24u, 32u})
+            for (size_t container : {size_t(2), size_t(3), size_t(4)}) {
+                if (depth > 8 * container)
+                    continue;
+                for (uint64_t n : {0ull, 1ull, 12345ull, 65535ull, 1ull << 20}) {
+                    const int32_t v = pcmPatternSample(n, 1, depth, 331);
+                    Bytes b;
+                    putPcmSample(b, v, container, depth);
+                    pcmOk &= b.size() == container && getPcmSample(b.data(), container, depth) == v;
+                    pcmOk &= pcmPatternIndex(pcmPatternSample(n, 0, depth, 331), depth, 331) == (n & ((1ull << depth) - 1));
+                }
+            }
+        check("pcm-pattern-roundtrip", pcmOk);
+        Bytes b;
+        putPcmSample(b, -2, 4, 24);      // 24 valid bits left-justified in a 32-bit container
+        check("pcm-24-in-32", b == hex("fffffe00"));
+        check("nsr-codes", nsrToHz(5) == 48000 && nsrToHz(4) == 44100 && nsrToHz(0x0a) == 24000 && hzToNsr(96000) == 7 && hzToNsr(22050) == 0);
+    }
+
+  protected:
+    virtual void initialize() override
+    {
+        testAaf();
+        testCrf();
+        test61883();
+        testMpegTs();
+        std::cout << "AVTP media self-test: " << passed << " passed, " << failed << " failed" << endl;
+    }
+
+    virtual void finish() override
+    {
+        recordScalar("checksPassed", passed);
+        recordScalar("checksFailed", failed);
+    }
+};
+
+Define_Module(AvtpMediaSelfTest);
+
+} // namespace SignalsAndGateways
diff --git a/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSerializer.cc b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSerializer.cc
new file mode 100644
index 0000000..1d0e9de
--- /dev/null
+++ b/src-inet4/signalsandgateways/inet4/avtp/media/AvtpMediaSerializer.cc
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// Byte-exact serializers for the IEEE 1722 media chunks in AvtpMedia.msg.
+#include "inet/common/packet/serializer/ChunkSerializerRegistry.h"
+#include "inet/common/packet/serializer/FieldsChunkSerializer.h"
+#include "signalsandgateways/inet4/avtp/media/AvtpMedia_m.h"
+
+using namespace inet;
+
+namespace SignalsAndGateways {
+
+class AvtpAafPcmHeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& h = staticPtrCast<const AvtpAafPcmHeader>(chunk);
+        if (h->getNsr() > 0x0f || h->getChannelsPerFrame() > 0x3ff || h->getEvt() > 0x0f)
+            throw cRuntimeError("AAF nsr/channels_per_frame/evt exceed their field widths");
+        stream.writeUint8(h->getSubtype());
+        stream.writeUint8((h->getSv() ? 0x80 : 0) | ((h->getVersion() & 7) << 4) | (h->getMr() ? 0x08 : 0) | (h->getTv() ? 0x01 : 0));
+        stream.writeUint8(h->getSequenceNum());
+        stream.writeUint8(h->getTu() ? 0x01 : 0);
+        stream.writeUint64Be(h->getStreamId());
+        stream.writeUint32Be(h->getAvtpTimestamp());
+        stream.writeUint8(h->getFormat());
+        stream.writeUint16Be((h->getNsr() << 12) | h->getChannelsPerFrame());
+        stream.writeUint8(h->getBitDepth());
+        stream.writeUint16Be(h->getStreamDataLength());
+        stream.writeUint8((h->getSp() ? 0x10 : 0) | h->getEvt());
+        stream.writeUint8(0);
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto h = makeShared<AvtpAafPcmHeader>();
+        h->setSubtype(stream.readUint8());
+        const uint8_t flags = stream.readUint8();
+        h->setSv(flags & 0x80);
+        h->setVersion((flags >> 4) & 7);
+        h->setMr(flags & 0x08);
+        h->setTv(flags & 0x01);
+        h->setSequenceNum(stream.readUint8());
+        h->setTu(stream.readUint8() & 0x01);
+        h->setStreamId(stream.readUint64Be());
+        h->setAvtpTimestamp(stream.readUint32Be());
+        h->setFormat(stream.readUint8());
+        const uint16_t word = stream.readUint16Be();
+        h->setNsr(word >> 12);
+        h->setChannelsPerFrame(word & 0x3ff);
+        h->setBitDepth(stream.readUint8());
+        h->setStreamDataLength(stream.readUint16Be());
+        const uint8_t spEvt = stream.readUint8();
+        h->setSp(spEvt & 0x10);
+        h->setEvt(spEvt & 0x0f);
+        stream.readUint8();
+        return h;
+    }
+};
+
+class AvtpCrfPduSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& h = staticPtrCast<const AvtpCrfPdu>(chunk);
+        if (h->getPull() > 7 || h->getBaseFrequency() > 0x1fffffff)
+            throw cRuntimeError("CRF pull/base_frequency exceed their field widths");
+        stream.writeUint8(h->getSubtype());
+        stream.writeUint8((h->getSv() ? 0x80 : 0) | ((h->getVersion() & 7) << 4) | (h->getMr() ? 0x08 : 0)
+                          | (h->getFs() ? 0x02 : 0) | (h->getTu() ? 0x01 : 0));
+        stream.writeUint8(h->getSequenceNum());
+        stream.writeUint8(h->getType());
+        stream.writeUint64Be(h->getStreamId());
+        stream.writeUint32Be((uint32_t(h->getPull()) << 29) | h->getBaseFrequency());
+        stream.writeUint16Be(h->getCrfDataLength());
+        stream.writeUint16Be(h->getTimestampInterval());
+        for (size_t i = 0; i < h->getCrfTimestampArraySize(); ++i)
+            stream.writeUint64Be(h->getCrfTimestamp(i));
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto h = makeShared<AvtpCrfPdu>();
+        h->setSubtype(stream.readUint8());
+        const uint8_t flags = stream.readUint8();
+        h->setSv(flags & 0x80);
+        h->setVersion((flags >> 4) & 7);
+        h->setMr(flags & 0x08);
+        h->setFs(flags & 0x02);
+        h->setTu(flags & 0x01);
+        h->setSequenceNum(stream.readUint8());
+        h->setType(stream.readUint8());
+        h->setStreamId(stream.readUint64Be());
+        const uint32_t word = stream.readUint32Be();
+        h->setPull(word >> 29);
+        h->setBaseFrequency(word & 0x1fffffff);
+        h->setCrfDataLength(stream.readUint16Be());
+        h->setTimestampInterval(stream.readUint16Be());
+        const size_t count = h->getCrfDataLength() / 8;
+        h->setCrfTimestampArraySize(count);
+        for (size_t i = 0; i < count && stream.getRemainingLength() >= B(8); ++i)
+            h->setCrfTimestamp(i, stream.readUint64Be());
+        h->setChunkLength(B(AVTP_CRF_HEADER_BYTES + 8 * count));
+        return h;
+    }
+};
+
+class Avtp61883HeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& h = staticPtrCast<const Avtp61883Header>(chunk);
+        if (h->getTag() > 3 || h->getChannel() > 0x3f || h->getTcode() > 0x0f || h->getSy() > 0x0f
+                || h->getSid() > 0x3f || h->getFn() > 3 || h->getQpc() > 7 || h->getFmt() > 0x3f)
+            throw cRuntimeError("61883/CIP header fields exceed their widths");
+        stream.writeUint8(h->getSubtype());
+        stream.writeUint8((h->getSv() ? 0x80 : 0) | ((h->getVersion() & 7) << 4) | (h->getMr() ? 0x08 : 0)
+                          | (h->getGv() ? 0x02 : 0) | (h->getTv() ? 0x01 : 0));
+        stream.writeUint8(h->getSequenceNum());
+        stream.writeUint8(h->getTu() ? 0x01 : 0);
+        stream.writeUint64Be(h->getStreamId());
+        stream.writeUint32Be(h->getAvtpTimestamp());
+        stream.writeUint32Be(h->getGatewayInfo());
+        stream.writeUint16Be(h->getStreamDataLength());
+        stream.writeUint8((h->getTag() << 6) | h->getChannel());
+        stream.writeUint8((h->getTcode() << 4) | h->getSy());
+        // CIP header (IEC 61883-1)
+        stream.writeUint8(h->getSid());                      // qi1 = 00
+        stream.writeUint8(h->getDbs());
+        stream.writeUint8((h->getFn() << 6) | (h->getQpc() << 3) | (h->getSph() ? 0x04 : 0));
+        stream.writeUint8(h->getDbc());
+        stream.writeUint8(0x80 | h->getFmt());               // qi2 = 10
+        stream.writeUint8(h->getTsf() ? 0x80 : 0);           // FDF: TSF + 23 reserved bits
+        stream.writeUint16Be(0);
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto h = makeShared<Avtp61883Header>();
+        h->setSubtype(stream.readUint8());
+        const uint8_t flags = stream.readUint8();
+        h->setSv(flags & 0x80);
+        h->setVersion((flags >> 4) & 7);
+        h->setMr(flags & 0x08);
+        h->setGv(flags & 0x02);
+        h->setTv(flags & 0x01);
+        h->setSequenceNum(stream.readUint8());
+        h->setTu(stream.readUint8() & 0x01);
+        h->setStreamId(stream.readUint64Be());
+        h->setAvtpTimestamp(stream.readUint32Be());
+        h->setGatewayInfo(stream.readUint32Be());
+        h->setStreamDataLength(stream.readUint16Be());
+        const uint8_t tagChannel = stream.readUint8();
+        h->setTag(tagChannel >> 6);
+        h->setChannel(tagChannel & 0x3f);
+        const uint8_t tcodeSy = stream.readUint8();
+        h->setTcode(tcodeSy >> 4);
+        h->setSy(tcodeSy & 0x0f);
+        const uint8_t sid = stream.readUint8();
+        if (sid >> 6)
+            h->markIncorrect();
+        h->setSid(sid & 0x3f);
+        h->setDbs(stream.readUint8());
+        const uint8_t fnQpcSph = stream.readUint8();
+        h->setFn(fnQpcSph >> 6);
+        h->setQpc((fnQpcSph >> 3) & 7);
+        h->setSph(fnQpcSph & 0x04);
+        h->setDbc(stream.readUint8());
+        const uint8_t fmt = stream.readUint8();
+        if ((fmt >> 6) != 2)
+            h->markIncorrect();
+        h->setFmt(fmt & 0x3f);
+        h->setTsf(stream.readUint8() & 0x80);
+        stream.readUint16Be();
+        return h;
+    }
+};
+
+Register_Serializer(AvtpAafPcmHeader, AvtpAafPcmHeaderSerializer);
+Register_Serializer(AvtpCrfPdu, AvtpCrfPduSerializer);
+Register_Serializer(Avtp61883Header, Avtp61883HeaderSerializer);
+
+} // namespace SignalsAndGateways

+        case MediaError::NONE: return "NONE";
+        case MediaError::PDU_TOO_SHORT: return "PDU_TOO_SHORT";
+        case MediaError::UNSUPPORTED_SUBTYPE: return "UNSUPPORTED_SUBTYPE";
+        case MediaError::UNSUPPORTED_VERSION: return "UNSUPPORTED_VERSION";
+        case MediaError::STREAM_ID_NOT_VALID: return "STREAM_ID_NOT_VALID";
+        case MediaError::DATA_LENGTH_EXCEEDS_PDU: return "DATA_LENGTH_EXCEEDS_PDU";
+        case MediaError::AAF_FORMAT_NOT_PCM: return "AAF_FORMAT_NOT_PCM";
+        case MediaError::AAF_CHANNELS_ZERO: return "AAF_CHANNELS_ZERO";
+        case MediaError::AAF_BIT_DEPTH_INVALID: return "AAF_BIT_DEPTH_INVALID";
+        case MediaError::AAF_PARTIAL_FRAME: return "AAF_PARTIAL_FRAME";
+        case MediaError::CRF_DATA_LENGTH_INVALID: return "CRF_DATA_LENGTH_INVALID";
+        case MediaError::CRF_BASE_FREQUENCY_ZERO: return "CRF_BASE_FREQUENCY_ZERO";
+        case MediaError::CRF_PULL_RESERVED: return "CRF_PULL_RESERVED";
+        case MediaError::IEC61883_NO_CIP: return "IEC61883_NO_CIP";

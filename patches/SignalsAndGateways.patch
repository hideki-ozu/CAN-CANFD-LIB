+namespace {
+const uint8_t SUBTYPE_61883 = 0x00, SUBTYPE_AAF = 0x02, SUBTYPE_CRF = 0x04;
+const size_t AAF_HEADER = 24, CRF_HEADER = 20, IEC61883_HEADER = 24, CIP_HEADER = 8, SOURCE_PACKET = 192, TS = 188;
+
+uint16_t be16(const uint8_t *p) { return uint16_t((p[0] << 8) | p[1]); }
+uint32_t be32(const uint8_t *p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3]; }
+uint64_t be64(const uint8_t *p) { return (uint64_t(be32(p)) << 32) | be32(p + 4); }
+
+void decodeAaf(const uint8_t *p, size_t size, DecodedMediaPdu& out)
+{
+    if (size < AAF_HEADER) {
+        out.error = MediaError::PDU_TOO_SHORT;
+        return;
+    }
+    out.tv = p[1] & 0x01;
+    out.avtpTimestamp = be32(p + 12);
+    out.format = p[16];
+    out.nsr = p[17] >> 4;
+    out.channelsPerFrame = be16(p + 17) & 0x3ff;
+    out.bitDepth = p[19];
+    const uint16_t length = be16(p + 20);
+    out.sp = p[22] & 0x10;
+    out.evt = p[22] & 0x0f;
+    if (AAF_HEADER + length > size)
+        out.error = MediaError::DATA_LENGTH_EXCEEDS_PDU;
+    else if (out.format > AAF_INT_16BIT)
+        out.error = MediaError::AAF_FORMAT_NOT_PCM;
+    else if (out.channelsPerFrame == 0)
+        out.error = MediaError::AAF_CHANNELS_ZERO;
+    else if (out.bitDepth == 0 || (out.format == AAF_FLOAT_32BIT && out.bitDepth != 32)
+             || (out.format != AAF_USER && out.bitDepth > 8 * aafContainerBytes(out.format)))
+        out.error = MediaError::AAF_BIT_DEPTH_INVALID;
+    else if (out.format != AAF_USER && length % (out.channelsPerFrame * aafContainerBytes(out.format)) != 0)
+        out.error = MediaError::AAF_PARTIAL_FRAME;
+    else
+        out.samples.assign(p + AAF_HEADER, p + AAF_HEADER + length);
+}
+
+void decodeCrf(const uint8_t *p, size_t size, DecodedMediaPdu& out)
+{
+    if (size < CRF_HEADER) {
+        out.error = MediaError::PDU_TOO_SHORT;
+        return;
+    }
+    out.fs = p[1] & 0x02;
+    out.crfType = p[3];
+    const uint32_t word = be32(p + 12);
+    out.pull = word >> 29;
+    out.baseFrequency = word & 0x1fffffff;
+    const uint16_t length = be16(p + 16);
+    out.timestampInterval = be16(p + 18);
+    if (length == 0 || length % 8 != 0)
+        out.error = MediaError::CRF_DATA_LENGTH_INVALID;
+    else if (CRF_HEADER + length > size)
+        out.error = MediaError::DATA_LENGTH_EXCEEDS_PDU;
+    else if (out.baseFrequency == 0)
+        out.error = MediaError::CRF_BASE_FREQUENCY_ZERO;
+    else if (out.pull > 5)
+        out.error = MediaError::CRF_PULL_RESERVED;
+    else
+        for (size_t i = 0; i < length / 8; ++i)
+            out.crfTimestamps.push_back(be64(p + CRF_HEADER + 8 * i));
+}
+
+void decode61883(const uint8_t *p, size_t size, DecodedMediaPdu& out)
+{
+    if (size < IEC61883_HEADER) {
+        out.error = MediaError::PDU_TOO_SHORT;
+        return;
+    }
+    out.gv = p[1] & 0x02;
+    out.tv = p[1] & 0x01;
+    out.avtpTimestamp = be32(p + 12);
+    out.gatewayInfo = be32(p + 16);
+    const uint16_t length = be16(p + 20);
+    const uint8_t tag = p[22] >> 6, channel = p[22] & 0x3f, tcode = p[23] >> 4;
+    if (IEC61883_HEADER + length > size) {
+        out.error = MediaError::DATA_LENGTH_EXCEEDS_PDU;
+        return;
+    }
+    if (tag != 1) {
+        out.error = MediaError::IEC61883_NO_CIP;
+        return;
+    }
+    if (channel != 31) {
+        out.error = MediaError::IEC61883_CHANNEL_NOT_AVTP;
+        return;
+    }
+    if (tcode != 0x0A) {
+        out.error = MediaError::IEC61883_TCODE;
+        return;
+    }
+    if (length < CIP_HEADER) {
+        out.error = MediaError::PDU_TOO_SHORT;
+        return;
+    }
+    const uint8_t *cip = p + IEC61883_HEADER;
+    out.sid = cip[0] & 0x3f;
+    out.dbs = cip[1];
+    out.fn = cip[2] >> 6;
+    out.qpc = (cip[2] >> 3) & 7;
+    out.sph = cip[2] & 0x04;
+    out.dbc = cip[3];
+    out.fmt = cip[4] & 0x3f;
+    out.tsf = cip[5] & 0x80;
+    if ((cip[0] >> 6) != 0 || (cip[4] >> 6) != 2)
+        out.error = MediaError::IEC61883_CIP_QUADLET_INDICATOR;
+    else if (out.sid != 63)
+        out.error = MediaError::IEC61883_SID_NOT_AVTP;
+    else if (out.fmt != 0x20)
+        out.error = MediaError::IEC61883_FORMAT_UNSUPPORTED;
+    else if (out.dbs != 6 || out.fn != 3 || out.qpc != 0 || !out.sph)
+        out.error = MediaError::IEC61883_4_CIP_PARAMETERS;
+    else if ((length - CIP_HEADER) % SOURCE_PACKET != 0)
+        out.error = MediaError::IEC61883_4_DATA_LENGTH;
+    if (out.error != MediaError::NONE)
+        return;
+    for (size_t offset = IEC61883_HEADER + CIP_HEADER; offset < IEC61883_HEADER + length; offset += SOURCE_PACKET) {
+        SourcePacket sp;
+        sp.timestamp = be32(p + offset);
+        sp.tsPacket.assign(p + offset + 4, p + offset + 4 + TS);
+        out.sourcePackets.push_back(std::move(sp));
+    }
+}
+
+void putSection(Bytes& packet, const Bytes& section)
+{
+    packet.push_back(0x00);     // pointer_field
+    packet.insert(packet.end(), section.begin(), section.end());
+    packet.resize(TS, 0xFF);    // stuffing
+}
+
+void appendCrc(Bytes& section)
+{
+    const uint32_t crc = crc32Mpeg2(section.data(), section.size());
+    for (int shift = 24; shift >= 0; shift -= 8)
+        section.push_back((crc >> shift) & 0xFF);
+}

+        case MediaError::IEC61883_TCODE: return "IEC61883_TCODE";
+        case MediaError::IEC61883_CIP_QUADLET_INDICATOR: return "IEC61883_CIP_QUADLET_INDICATOR";
+        case MediaError::IEC61883_SID_NOT_AVTP: return "IEC61883_SID_NOT_AVTP";
+        case MediaError::IEC61883_FORMAT_UNSUPPORTED: return "IEC61883_FORMAT_UNSUPPORTED";
+        case MediaError::IEC61883_4_CIP_PARAMETERS: return "IEC61883_4_CIP_PARAMETERS";
+        case MediaError::IEC61883_4_DATA_LENGTH: return "IEC61883_4_DATA_LENGTH";
+    }
+    return "?";
+}
+
+size_t aafContainerBytes(uint8_t format)
+{
+    switch (format) {
+        case AAF_FLOAT_32BIT:
+        case AAF_INT_32BIT: return 4;
+        case AAF_INT_24BIT: return 3;
+        case AAF_INT_16BIT: return 2;
+        default: return 0;
+    }
+}
+
+uint32_t nsrToHz(uint8_t nsr)
+{
+    static const uint32_t rates[] = {0, 8000, 16000, 32000, 44100, 48000, 88200, 96000, 176400, 192000, 24000};
+    return nsr < sizeof(rates) / sizeof(rates[0]) ? rates[nsr] : 0;
+}
+
+uint8_t hzToNsr(uint32_t hz)
+{
+    for (uint8_t nsr = 1; nsr <= 0x0A; ++nsr)
+        if (nsrToHz(nsr) == hz)
+            return nsr;
+    return 0;
+}
+
+DecodedMediaPdu decodeMediaPdu(const uint8_t *p, size_t size)
+{
+    DecodedMediaPdu out;
+    if (size < 12) {
+        out.error = MediaError::PDU_TOO_SHORT;
+        return out;
+    }
+    out.subtype = p[0];
+    out.mr = p[1] & 0x08;
+    out.sequenceNum = p[2];
+    out.tu = p[3] & 0x01;
+    out.streamId = be64(p + 4);
+    if (out.subtype != SUBTYPE_AAF && out.subtype != SUBTYPE_CRF && out.subtype != SUBTYPE_61883)
+        out.error = MediaError::UNSUPPORTED_SUBTYPE;
+    else if (((p[1] >> 4) & 7) != 0)
+        out.error = MediaError::UNSUPPORTED_VERSION;
+    else if (!(p[1] & 0x80))
+        out.error = MediaError::STREAM_ID_NOT_VALID;
+    if (out.error != MediaError::NONE)
+        return out;
+    if (out.subtype == SUBTYPE_AAF)
+        decodeAaf(p, size, out);
+    else if (out.subtype == SUBTYPE_CRF)
+        decodeCrf(p, size, out);
+    else
+        decode61883(p, size, out);
+    return out;
+}
+
+int32_t pcmPatternSample(uint64_t n, unsigned channel, unsigned bitDepth, uint32_t step)
+{
+    const uint64_t modulus = 1ull << bitDepth;
+    const uint64_t raw = ((n + 1000ull * channel) * step) & (modulus - 1);
+    return int32_t(int64_t(raw) - (raw >= modulus / 2 ? int64_t(modulus) : 0));
+}
+
+void putPcmSample(Bytes& out, int32_t value, size_t containerBytes, unsigned bitDepth)
+{
+    const uint32_t word = uint32_t(value) << (8 * containerBytes - bitDepth);
+    for (int i = int(containerBytes) - 1; i >= 0; --i)
+        out.push_back((word >> (8 * i)) & 0xFF);
+}
+
+int32_t getPcmSample(const uint8_t *in, size_t containerBytes, unsigned bitDepth)
+{
+    uint32_t word = 0;
+    for (size_t i = 0; i < containerBytes; ++i)
+        word = (word << 8) | in[i];
+    const unsigned shift = 32 - 8 * containerBytes;
+    // Sign-extend the container, then drop the unused low bits.
+    return (int32_t(word << shift) >> shift) >> (8 * containerBytes - bitDepth);
+}
+
+uint64_t pcmPatternIndex(int32_t value, unsigned bitDepth, uint32_t step)
+{
+    const uint64_t modulus = 1ull << bitDepth;
+    // Inverse of the odd step modulo 2^bitDepth (Newton iteration).
+    uint64_t inverse = step;
+    for (int i = 0; i < 6; ++i)
+        inverse = (inverse * (2 - step * inverse)) & (modulus - 1);
+    return (uint64_t(uint32_t(value)) * inverse) & (modulus - 1);
+}
+
+uint32_t crc32Mpeg2(const uint8_t *data, size_t length)
+{
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < length; ++i) {
+        crc ^= uint32_t(data[i]) << 24;
+        for (int bit = 0; bit < 8; ++bit)
+            crc = (crc & 0x80000000u) ? (crc << 1) ^ 0x04C11DB7u : crc << 1;
+    }
+    return crc;
+}
+
+TsPacketInfo parseTsPacket(const uint8_t *p)
+{
+    TsPacketInfo info;
+    info.syncOk = p[0] == 0x47;
+    info.tei = p[1] & 0x80;
+    info.pusi = p[1] & 0x40;
+    info.pid = uint16_t(((p[1] & 0x1f) << 8) | p[2]);
+    info.scrambling = p[3] >> 6;
+    info.adaptationFieldControl = (p[3] >> 4) & 3;
+    info.continuityCounter = p[3] & 0x0f;
+    size_t offset = 4;
+    if (info.adaptationFieldControl & 2) {
+        const uint8_t length = p[4];
+        if (length > 183)
+            return info;
+        if (length > 0) {
+            info.discontinuity = p[5] & 0x80;
+            if ((p[5] & 0x10) && length >= 7) {
+                const uint8_t *pcr = p + 6;
+                const uint64_t base = (uint64_t(pcr[0]) << 25) | (uint64_t(pcr[1]) << 17) | (uint64_t(pcr[2]) << 9)
+                        | (uint64_t(pcr[3]) << 1) | (pcr[4] >> 7);
+                const uint64_t extension = (uint64_t(pcr[4] & 1) << 8) | pcr[5];
+                info.hasPcr = true;
+                info.pcr27 = base * 300 + extension;
+            }
+        }
+        offset += 1 + length;
+    }
+    info.payloadOffset = (info.adaptationFieldControl & 1) ? offset : 188;
+    return info;
+}
+
+Bytes TsGenerator::patSection(const TsGeneratorConfig& c)
+{
+    Bytes s = {0x00, 0xB0, 0x0D, uint8_t(c.transportStreamId >> 8), uint8_t(c.transportStreamId), 0xC1, 0x00, 0x00,
+               uint8_t(c.programNumber >> 8), uint8_t(c.programNumber), uint8_t(0xE0 | (c.pmtPid >> 8)), uint8_t(c.pmtPid)};
+    appendCrc(s);
+    return s;
+}
+
+Bytes TsGenerator::pmtSection(const TsGeneratorConfig& c)
+{
+    // table_id 2, section_length 23 = 9 fixed + 2 x 5 stream entries + 4 CRC
+    Bytes s = {0x02, 0xB0, 0x17, uint8_t(c.programNumber >> 8), uint8_t(c.programNumber), 0xC1, 0x00, 0x00,
+               uint8_t(0xE0 | (c.videoPid >> 8)), uint8_t(c.videoPid), 0xF0, 0x00,
+               c.videoStreamType, uint8_t(0xE0 | (c.videoPid >> 8)), uint8_t(c.videoPid), 0xF0, 0x00,
+               c.audioStreamType, uint8_t(0xE0 | (c.audioPid >> 8)), uint8_t(c.audioPid), 0xF0, 0x00};
+    appendCrc(s);
+    return s;
+}
+
+Bytes TsGenerator::packet(uint64_t index, uint64_t pcr27)
+{
+    uint16_t pid;
+    bool psi = false, withPcr = false;
+    Bytes section;
+    if (index % config.psiIntervalPackets == 0) {
+        pid = 0x0000;
+        section = patSection(config);
+        psi = true;
+    }
+    else if (index % config.psiIntervalPackets == 1) {
+        pid = config.pmtPid;
+        section = pmtSection(config);
+        psi = true;
+    }
+    else if (index % config.audioEveryPackets == config.audioEveryPackets - 1)
+        pid = config.audioPid;
+    else {
+        pid = config.videoPid;
+        withPcr = index >= nextPcr;
+        if (withPcr)
+            nextPcr += config.pcrIntervalPackets;
+    }
+    uint8_t& cc = continuity[pid];
+    Bytes p = {0x47, uint8_t((psi ? 0x40 : 0) | (pid >> 8)), uint8_t(pid), uint8_t((withPcr ? 0x30 : 0x10) | cc)};
+    cc = (cc + 1) & 0x0f;
+    if (withPcr) {
+        const uint64_t base = (pcr27 / 300) & ((1ull << 33) - 1), extension = pcr27 % 300;
+        p.push_back(7);         // adaptation_field_length
+        p.push_back(0x10);      // PCR_flag
+        p.push_back(uint8_t(base >> 25));
+        p.push_back(uint8_t(base >> 17));
+        p.push_back(uint8_t(base >> 9));
+        p.push_back(uint8_t(base >> 1));
+        p.push_back(uint8_t(((base & 1) << 7) | 0x7E | (extension >> 8)));
+        p.push_back(uint8_t(extension));
+    }
+    if (psi) {
+        putSection(p, section);
+        return p;
+    }
+    for (int shift = 24; shift >= 0; shift -= 8)
+        p.push_back(uint8_t(index >> shift));
+    for (size_t j = p.size(); j < TS; ++j)
+        p.push_back(uint8_t(index + j));
+    return p;
+}
+
+} // namespace media
+} // namespace avtp
+} // namespace SignalsAndGateways

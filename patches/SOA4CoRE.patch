+namespace SOA4CoRE {
+
+class ServiceBase;
+
+// INET4 port: events are sent as SOME/IP NOTIFICATION messages (PRS_SOMEIP_00925):
+// message ID = service ID | event ID (MSB set), client ID 0x0000, session ID
+// counting 1..0xFFFF and wrapping to 1 (session handling active). The Publisher's
+// e2e*/secoc* parameters enable AUTOSAR E2E and SecOC (see SomeIpProtection.h).
+class SOMEIPPublisherEndpointBase
+{
+protected:
+    void prependSomeIpHeader(inet::Packet* packet, ServiceBase* application);
+    void recordProtectionStatistics(omnetpp::cComponent* owner) const { _protector.record(owner); }
+    std::string getMessageName(int serviceId) const {
+        return "SOME/IP Service " + std::to_string(serviceId);
+    }
+
+private:
+    uint16_t _sessionId = 0;
+    SomeIpProtector _protector;
+};
+
+} /*end namespace SOA4CoRE*/

+//
+
+#ifndef __SOA4CORE_SOMEIPPROTECTION_H_
+#define __SOA4CORE_SOMEIPPROTECTION_H_
+
+#include <memory>
+
+#include "autosar/protection/ProtectionParams.h"
+#include "inet/common/packet/Packet.h"
+#include "soa4core/messages/someip/SomeIp_m.h"
+
+namespace SOA4CoRE {
+
+// INET4 port: AUTOSAR E2E and SecOC for SOME/IP event notifications (not for SD).
+//
+//   E2E area  = SOME/IP header from Request ID to Return Code (8 bytes) | payload,
+//               E2E header at e2eOffset of this area (default 8 = start of payload),
+//               as done by the E2E transformer on top of the SOME/IP transformer.
+//   Authentic I-PDU = Message ID (4 bytes) | E2E area   (the Length field is excluded
+//               because it changes with the SecOC trailer)
+//   Wire payload = E2E protected payload | SecOC FV | SecOC MAC
+//
+// Application data bytes carry the pattern (session ID + index) & 0xFF.
+constexpr size_t SOMEIP_E2E_UPPER_HEADER_BYTES = 8;
+
+autosar::ProtectionConfig readSomeIpProtection(omnetpp::cComponent *application, uint16_t serviceId, uint16_t eventId);
+
+// Publisher endpoint side, one instance per endpoint (one counter/FV sequence).
+class SomeIpProtector
+{
+public:
+    // Reads the Publisher's parameters on first use.
+    void configure(omnetpp::cComponent *application, uint16_t serviceId, uint16_t eventId);
+    bool isEnabled() const { return _enabled; }
+    // Fault injection: true when the next message is a replay of the previous one.
+    bool replayNext();
+    // Replaces packet's payload by the previous protected payload; returns its header.
+    const SomeIpHeader& replay(inet::Packet* packet);
+    // Replaces the payload by the protected payload for 'header' (length not yet final).
+    void protect(inet::Packet* packet, const SomeIpHeader& header);
+    void record(omnetpp::cComponent *owner) const;
+
+private:
+    bool _configured = false, _enabled = false;
+    autosar::ProtectionConfig _config;
+    std::unique_ptr<autosar::E2EProtector> _e2e;
+    std::unique_ptr<autosar::SecOcSender> _secoc;
+    std::set<long> _corruptAt, _replayAt, _skipAt;
+    long _skipCount = 0, _sent = 0, _corrupted = 0, _replayed = 0;
+    autosar::Bytes _lastPayload;
+    SomeIpHeader _lastHeader;
+};
+
+// Subscriber endpoint side: SecOC verification, then E2E check and state machine.
+class SomeIpVerifier
+{
+public:
+    void configure(omnetpp::cComponent *application, uint16_t serviceId, uint16_t eventId);
+    bool isEnabled() const { return _enabled; }
+    // 'packet' holds the payload after the SOME/IP header. On true, it holds the
+    // application data only (E2E header and SecOC trailer removed).
+    bool accept(inet::Packet* packet, const SomeIpHeader& header);
+    void record(omnetpp::cComponent *owner) const;
+
+private:
+    bool _configured = false, _enabled = false;
+    autosar::ProtectionConfig _config;
+    std::unique_ptr<autosar::E2EChecker> _e2e;
+    std::unique_ptr<autosar::E2EStateMachine> _sm;
+    std::unique_ptr<autosar::SecOcReceiver> _secoc;
+    autosar::ProtectionStatistics _stats;
+    long _delivered = 0, _patternErrors = 0;
+};
+
+} /*end namespace SOA4CoRE*/
+
+#endif

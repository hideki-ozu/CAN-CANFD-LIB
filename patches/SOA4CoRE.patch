+package soa4core.nodes;
+
+import inet.node.inet.StandardHost;
+import inet.node.tsn.TsnDevice;
+import soa4core.nodes.Middleware;
+import soa4core.applications.base.IService;
+
+//
+// INET4 port: host with SOA4CoRE middleware on INET's StandardHost (IPv4, UDP,
+// TCP). The SOME/IP-SD socket and the dynamically created endpoints attach to the
+// application-layer dispatcher "at". (Previously CoRE4INET RTIPHost.)
+//
+module MiddlewareHost extends StandardHost
+{
+    parameters:
+        hasUdp = true;
+        hasTcp = true;
+        bool hasQoSNP = default(false);
+        *.hasQoSNP = this.hasQoSNP;
+        int numServices = default(0);
+        string localAddress = default("");
+        *.localAddress = this.localAddress;
+        @display("i=device/device");
+    submodules:
+        services[numServices]: <> like IService {
+            @display("p=1071,65,m,5,50,50");
+        }
+        middleware: Middleware {
+            @display("p=966,65");
+        }
+    connections allowunconnected:
+        middleware.sdUDPOut --> at.in++;
+        middleware.sdUDPIn <-- at.out++;
+}
+
+//
+// Same middleware on INET's TsnDevice: PCP/VLAN request tags of UDP endpoints are
+// encoded as IEEE 802.1Q C-tags when hasOutgoingStreams is enabled; gPTP and
+// shaping are available through the usual TsnDevice parameters.
+//
+module MiddlewareTsnHost extends TsnDevice
+{
+    parameters:
+        hasUdp = true;
+        hasTcp = true;
+        bool hasQoSNP = default(false);
+        *.hasQoSNP = this.hasQoSNP;
+        int numServices = default(0);
+        string localAddress = default("");
+        *.localAddress = this.localAddress;
+        @display("i=device/device");
+    submodules:
+        services[numServices]: <> like IService {
+            @display("p=1071,65,m,5,50,50");
+        }
+        middleware: Middleware {
+            @display("p=966,65");
+        }
+    connections allowunconnected:
+        middleware.sdUDPOut --> at.in++;
+        middleware.sdUDPIn <-- at.out++;
+}

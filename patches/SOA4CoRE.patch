+
+Define_Module(SOMEIPUDPMcastPublisherEndpoint);
+
+ConnectionSpecificInformation* SOMEIPUDPMcastPublisherEndpoint::getConnectionSpecificInformation() {
+    CSI_SOMEIP_UDP_MCAST* connection = new CSI_SOMEIP_UDP_MCAST();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    connection->setDestAddress(_mcastDestAddress.c_str());
+    connection->setDestPort(_mcastDestPort);
+    return connection;
+}
+
+Packet* SOMEIPUDPMcastPublisherEndpoint::createTransportPacket(cPacket* msg) {
+    Packet* packet = createPayloadPacket(msg);
+    prependSomeIpHeader(packet, _publisherConnector->getApplication());
+    if (*(msg->getName()))
+        packet->setName(msg->getName());
+    return packet;
+}
+
+size_t SOMEIPUDPMcastPublisherEndpoint::getHeaderBytes() {
+    return UDPMcastPublisherEndpoint::getHeaderBytes() + SOMEIP_HEADER_BYTES;
+}
+
+uint64_t SOMEIPUDPMcastPublisherEndpoint::createStreamId(Ipv4Address destAddress) {
+    ServiceBase* app = _publisherConnector->getApplication();
+    return buildStreamIDForService(app->getServiceId(), app->getInstanceId(), destAddress);
+}
+
+void SOMEIPUDPMcastPublisherEndpoint::finish() {
+    UDPMcastPublisherEndpoint::finish();
+    recordProtectionStatistics(this);
+}
+
+} /*end namespace SOA4CoRE*/

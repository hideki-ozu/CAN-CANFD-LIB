+
+using namespace inet;
+
+namespace SOA4CoRE {
+
+Define_Module(TCPSubscriberEndpoint);
+
+ConnectionSpecificInformation* TCPSubscriberEndpoint::getConnectionSpecificInformation() {
+    CSI_TCP* connection = new CSI_TCP();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    return connection;
+}
+
+void TCPSubscriberEndpoint::initializeTransportConnection() {
+    connectToTransportGate();
+    _socket.setOutputGate(gate(TRANSPORT_OUT_GATE_NAME));
+    _socket.setCallback(this);
+    _socket.bind(!_localAddress.empty() ? L3AddressResolver().resolve(_localAddress.c_str()) : L3Address(), _localPort);
+    _socket.connect(L3AddressResolver().resolve(_remoteAddress.c_str()), _remotePort);
+}
+
+void TCPSubscriberEndpoint::handleTransportIn(cMessage* msg) {
+    if (_socket.belongsToSocket(msg))
+        _socket.processMessage(msg);
+    else
+        delete msg;
+}
+
+void TCPSubscriberEndpoint::socketEstablished(TcpSocket *socket) {
+    _isConnected = true;
+}
+
+void TCPSubscriberEndpoint::socketDataArrived(TcpSocket *socket, Packet *packet, bool urgent) {
+    handleStreamData(packet);
+}
+
+void TCPSubscriberEndpoint::handleStreamData(Packet *packet) {
+    deliverToConnector(packet);
+}
+
+void TCPSubscriberEndpoint::socketPeerClosed(TcpSocket *socket) {
+    socket->close();
+}
+
+void TCPSubscriberEndpoint::socketFailure(TcpSocket *socket, int code) {
+    EV_WARN << "TCP connection failure " << code << endl;
+}
+
+void TCPSubscriberEndpoint::handleParameterChange(const char* parname) {
+    IPSubscriberEndpointBase::handleParameterChange(parname);
+    if (!parname || !strcmp(parname, "remoteAddress"))
+    {
+        _remoteAddress = par("remoteAddress").stdstringValue();
+    }
+    if (!parname || !strcmp(parname, "remotePort"))
+    {
+        _remotePort = par("remotePort");
+    }
+}
+
+} /*end namespace SOA4CoRE*/

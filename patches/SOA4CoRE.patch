+namespace SOA4CoRE {
+
+// INET4 port: validation of received SOME/IP notifications. The header is removed;
+// invalid messages (version, type, length, service, non-event method ID) are counted
+// and dropped. Session IDs are tracked per event to count missing notifications.
+// With the Subscriber's e2e*/secoc* parameters set, SecOC and E2E are verified next;
+// only messages with SecOC OK and E2E status OK/OKSOMELOST are delivered.
+class ServiceBase;
+class SOMEIPSubscriberEndpointBase
+{
+protected:
+    // Returns true when packet (header removed) should be delivered to 'application'.
+    bool acceptSomeIpMessage(inet::Packet* packet, ServiceBase* application);
+    void recordSomeIpStatistics(omnetpp::cComponent* owner) const;
+    bool isValidHeader(const SomeIpHeader& header, inet::b dataAfterHeader, int expectedServiceId) const;
+
+protected:
+    long _someIpReceived = 0;
+    long _someIpInvalid = 0;
+    long _someIpSessionGaps = 0;
+    std::map<uint32_t, uint16_t> _nextSession;
+    SomeIpVerifier _verifier;
+};
+
+} /*end namespace SOA4CoRE*/

+
+//
+// The Subscriber provides a subscriber implementation of the middleware application base.
+// These modules realize a data subscriber service.
+//
+// @author Timo Haeckel and Mehmet Mueller for HAW Hamburg
+//
+simple Subscriber extends ServiceBase
+{
+    parameters:
+        @class(SOA4CoRE::Subscriber);
+        @display("i=block/sink,blue");
+        
+        //Signal emitted when a frame is received, contains received EtherFrame
+        @signal[rxPk](type=omnetpp::cPacket);
+        //Statistic of the amount of packets that were received by the application
+        @statistic[rxPk](title="Received Packets"; source=rxPk; record=count; unit=packets);
+        //Statistic of the amount of bytes that were received by the application
+        @statistic[rxBytes](title="Received Bytes"; source=rxPk; unit=B; record="sum(packetBytes)","vector(packetBytes)", "histogram(packetBytes)?","floatingIntervalSumVector(packetBytes)?"; interpolationmode=none); //possible parameter e.g.: **.floatingintervalvectorrecorder-measure-interval = 20ms for floatingIntervalRecorders
+        //End-to-end latency
+        @signal[e2eDelay](type=simtime_t); // INET4 port: publisher creation time restored by the endpoint
+        @statistic[rxLatency](title="End-to-end latency"; source=e2eDelay; unit=s; record=stats,histogram?,vector; interpolationmode=none);
+        
+        //Requested instance id, 0xFFFF is any instance
+        instanceID = default(0xFFFF);
+        
+        //Subscriber name
+        serviceName = default("SubscriberService");
+        
+        //The QoS group which is requestes/subscribed
+        string qosGroup = default("IP_TCP");
+        // The UDP mcast address to use for static subscribers with qos (SOMEIP_)UDP_MCAST otherwise it will be ignored
+        string mcastDestAddress = default(""); // Requires a valid IP Mcast address (prefix 224/4), format "XXX.XXX.XXX.XXX", 
+        // Multicast destination port for UDP mcast
+        int eventgroupId = default(1); // INET4 port: SOME/IP-SD eventgroup to subscribe
+        int mcastDestPort = default(-1); // Requires a valid UDP port, if -1 no udp mcast is supported by publisher 
+        // INET4 port: AUTOSAR E2E and SecOC (autosar/protection/package.ned). The E2E area
+        // starts at the SOME/IP Request ID; e2eOffset 8 places the E2E header in front of
+        // the event data. Default DataIDs: E2E P04/P07 service ID << 16 | event ID, other
+        // profiles the event ID; SecOC the event ID.
+        string e2eProfile @enum("none", "P01", "P02", "P04", "P05", "P07") = default("none");
+        int e2eDataId = default(-1);
+        string e2eDataIdMode @enum("both", "alt", "low", "nibble") = default("both");
+        string e2eDataIdList = default("");
+        int e2eOffset = default(8);
+        int e2eMaxDeltaCounter = default(1);
+        int e2eSmWindowSize = default(3);
+        int e2eSmMinOkStateInit = default(1);
+        int e2eSmMaxErrorStateInit = default(1);
+        int e2eSmMinOkStateValid = default(1);
+        int e2eSmMaxErrorStateValid = default(1);
+        int e2eSmMinOkStateInvalid = default(2);
+        int e2eSmMaxErrorStateInvalid = default(0);
+        bool secocEnabled = default(false);
+        int secocDataId = default(-1);
+        string secocKey = default("000102030405060708090a0b0c0d0e0f");
+        int secocFreshnessBits = default(64);
+        int secocFreshnessTxBits = default(8);
+        int secocMacTxBits = default(24);
+        int secocAcceptanceWindow = default(0);
+}

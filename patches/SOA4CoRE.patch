+class UDPPublisherEndpoint : public IPPublisherEndpointBase, public inet::UdpSocket::ICallback
+{
+public:
+    virtual ConnectionSpecificInformation* getConnectionSpecificInformation() override;
+    virtual void addRemote(ConnectionSpecificInformation* csi);
+
+protected:
+    virtual void handleTransportIn(cMessage *msg) override;
+    virtual void initializeTransportConnection() override;
+    virtual void publish(cPacket* msg) override;
+    // Builds the UDP payload for one application message (SOME/IP variants add their header).
+    virtual inet::Packet* createTransportPacket(cPacket* msg);
+    virtual size_t getHeaderBytes() override;
+
+    virtual void socketDataArrived(inet::UdpSocket *socket, inet::Packet *packet) override;
+    virtual void socketErrorArrived(inet::UdpSocket *socket, inet::Indication *indication) override;
+    virtual void socketClosed(inet::UdpSocket *socket) override {}
+
+protected:
+    inet::UdpSocket _serverSocket;
+    std::vector<std::pair<inet::L3Address, int>> _remotes;
+};

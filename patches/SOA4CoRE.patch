+}
+
+void IPSubscriberEndpointBase::deliverToConnector(inet::Packet* packet) {
+    cPacket* message = new cPacket(packet->getName());
+    message->setByteLength(inet::B(packet->getDataLength()).get());
+    simtime_t creationTime = simTime();
+    if (packet->getDataLength() > inet::b(0)) {
+        for (const auto& region : packet->peekData()->getAllTags<inet::CreationTimeTag>())
+            creationTime = std::min(creationTime, region.getTag()->getCreationTime());
+    }
+    message->setTimestamp(creationTime);
+    delete packet;
+    SubscriberEndpointBase::handleTransportIn(message);
+}
+
+} /*end namespace SOA4CoRE*/

+# INET4 port of SOA4CoRE (SOME/IP, SOME/IP-SD, UDP/TCP endpoints); see src-inet4.
+# The legacy src/ tree (INET 3.x + CoRE4INET) is not built.
+INET_ROOT ?= $(abspath ../inet)
+AUTOSAR_ROOT ?= $(abspath ../../autosar)
+.PHONY: all makefiles
+all: makefiles
+	$(MAKE) -C src-inet4 MODE=release
+makefiles:
+	cd src-inet4 && opp_makemake -f --deep --make-so -o SOA4CoRE_INET4 -O out -I. -I$(INET_ROOT)/src -I$(AUTOSAR_ROOT)/src -L$(INET_ROOT)/src -lINET -L$(AUTOSAR_ROOT)/src -lAutosarProtection

+#include "soa4core/endpoints/publisher/ip/udp/UDPPublisherEndpoint.h"
+
+#include "inet/networklayer/common/L3AddressResolver.h"
+
+using namespace inet;
+using namespace std;
+
+namespace SOA4CoRE {
+
+Define_Module(UDPPublisherEndpoint);
+
+namespace {
+const size_t UDP_HEADER_BYTES = 8;
+}
+
+ConnectionSpecificInformation* UDPPublisherEndpoint::getConnectionSpecificInformation() {
+    CSI_UDP* connection = new CSI_UDP();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    return connection;
+}
+
+void UDPPublisherEndpoint::handleTransportIn(cMessage* msg) {
+    if (_serverSocket.belongsToSocket(msg))
+        _serverSocket.processMessage(msg);
+    else
+        delete msg;
+}
+
+void UDPPublisherEndpoint::socketDataArrived(UdpSocket *socket, Packet *packet) {
+    EV << "Publisher endpoint ignores incoming datagram " << packet->getName() << endl;
+    delete packet;
+}
+
+void UDPPublisherEndpoint::socketErrorArrived(UdpSocket *socket, Indication *indication) {
+    EV_WARN << "Ignoring UDP error report " << indication->getName() << endl;
+    delete indication;
+}
+
+void UDPPublisherEndpoint::initializeTransportConnection() {
+    connectToTransportGate();
+    _serverSocket.setOutputGate(gate(TRANSPORT_OUT_GATE_NAME));
+    _serverSocket.setCallback(this);
+    _serverSocket.setReuseAddress(true);
+    _serverSocket.bind(!_localAddress.empty() ? L3AddressResolver().resolve(_localAddress.c_str()) : L3Address(), _localPort);
+    _isConnected = true;
+}
+
+void UDPPublisherEndpoint::addRemote(ConnectionSpecificInformation* csi) {
+    if (CSI_UDP* csiUdp = dynamic_cast<CSI_UDP*>(csi)) {
+        const L3Address address = L3AddressResolver().resolve(csiUdp->getAddress());
+        for (const auto& remote : _remotes) {
+            if (remote.first == address && remote.second == csiUdp->getPort())
+                return;
+        }
+        _remotes.push_back(make_pair(address, csiUdp->getPort()));
+        checkStreamReservation();
+        emit(_remotesSignal, (unsigned long)_remotes.size());
+    }
+}
+
+Packet* UDPPublisherEndpoint::createTransportPacket(cPacket* msg) {
+    return createPayloadPacket(msg);
+}
+
+void UDPPublisherEndpoint::publish(cPacket* msg) {
+    if (_isConnected && !_remotes.empty()) {
+        Packet* packet = createTransportPacket(msg);
+        for (const auto& remote : _remotes)
+            _serverSocket.sendTo(packet->dup(), remote.first, remote.second);
+        delete packet;
+    }
+}
+
+size_t UDPPublisherEndpoint::getHeaderBytes() {
+    return IPPublisherEndpointBase::getHeaderBytes() + UDP_HEADER_BYTES;
+}
+
+} /*end namespace SOA4CoRE*/

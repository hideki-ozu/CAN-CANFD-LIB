diff --git a/src-inet4/soa4core/messages/someip/SomeIpSerializer.cc b/src-inet4/soa4core/messages/someip/SomeIpSerializer.cc
new file mode 100644
index 0000000..efdf05c
--- /dev/null
+++ b/src-inet4/soa4core/messages/someip/SomeIpSerializer.cc
@@ -0,0 +1,218 @@
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// INET4 port: byte-exact serializers (network byte order) for SOME/IP and SOME/IP-SD.
+//
+#include "inet/common/packet/serializer/ChunkSerializerRegistry.h"
+#include "inet/common/packet/serializer/FieldsChunkSerializer.h"
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+namespace {
+
+void writeSomeIpHeader(MemoryOutputStream& stream, const SomeIpHeader& header)
+{
+    stream.writeUint16Be(header.getServiceId());
+    stream.writeUint16Be(header.getMethodId());
+    stream.writeUint32Be(header.getLength());
+    stream.writeUint16Be(header.getClientId());
+    stream.writeUint16Be(header.getSessionId());
+    stream.writeUint8(header.getProtocolVersion());
+    stream.writeUint8(header.getInterfaceVersion());
+    stream.writeUint8(header.getMessageType());
+    stream.writeUint8(header.getReturnCode());
+}
+
+void readSomeIpHeader(MemoryInputStream& stream, SomeIpHeader& header)
+{
+    header.setServiceId(stream.readUint16Be());
+    header.setMethodId(stream.readUint16Be());
+    header.setLength(stream.readUint32Be());
+    header.setClientId(stream.readUint16Be());
+    header.setSessionId(stream.readUint16Be());
+    header.setProtocolVersion(stream.readUint8());
+    header.setInterfaceVersion(stream.readUint8());
+    header.setMessageType(stream.readUint8());
+    header.setReturnCode(stream.readUint8());
+}
+
+} // namespace
+
+class SomeIpHeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        writeSomeIpHeader(stream, *staticPtrCast<const SomeIpHeader>(chunk));
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto header = makeShared<SomeIpHeader>();
+        readSomeIpHeader(stream, *header);
+        if (header->getLength() < ADDITIONAL_BYTES_TO_PAYLOADLENGTH)
+            header->markIncorrect();
+        return header;
+    }
+};
+
+class SomeIpSDHeaderSerializer : public FieldsChunkSerializer
+{
+  protected:
+    virtual void serialize(MemoryOutputStream& stream, const Ptr<const Chunk>& chunk) const override
+    {
+        const auto& header = staticPtrCast<const SomeIpSDHeader>(chunk);
+        writeSomeIpHeader(stream, *header);
+        stream.writeUint8(header->getFlags());
+        stream.writeUint8(0);
+        stream.writeUint16Be(0);
+        stream.writeUint32Be(SOMEIP_SD_ENTRY_BYTES * header->getEntriesArraySize());
+        for (size_t i = 0; i < header->getEntriesArraySize(); ++i) {
+            const SomeIpSDEntry& entry = header->getEntries(i);
+            if (entry.getNum1stOptions() > 15 || entry.getNum2ndOptions() > 15 || entry.getTtl() > 0xffffff)
+                throw cRuntimeError("SOME/IP-SD entry field out of range");
+            stream.writeUint8(entry.getType());
+            stream.writeUint8(entry.getIndex1stOptions());
+            stream.writeUint8(entry.getIndex2ndOptions());
+            stream.writeUint8((entry.getNum1stOptions() << 4) | entry.getNum2ndOptions());
+            stream.writeUint16Be(entry.getServiceId());
+            stream.writeUint16Be(entry.getInstanceId());
+            stream.writeUint8(entry.getMajorVersion());
+            stream.writeUint24Be(entry.getTtl());
+            if (isServiceEntry(entry))
+                stream.writeUint32Be(entry.getMinorVersion());
+            else {
+                stream.writeUint8(0);                          // reserved (upper 8 of 12 bits)
+                stream.writeUint8(entry.getCounter() & 0x0f);  // reserved (4 bits) + counter
+                stream.writeUint16Be(entry.getEventgroupId());
+            }
+        }
+        size_t optionsBytes = 0;
+        for (size_t i = 0; i < header->getOptionsArraySize(); ++i)
+            optionsBytes += someIpSdOptionBytes(header->getOptions(i));
+        stream.writeUint32Be(optionsBytes);
+        for (size_t i = 0; i < header->getOptionsArraySize(); ++i) {
+            const SomeIpSDOption& option = header->getOptions(i);
+            const uint16_t length = someIpSdOptionLengthField(option);
+            stream.writeUint16Be(length);
+            stream.writeUint8(option.getType());
+            stream.writeUint8(option.getDiscardable() ? 0x80 : 0x00);
+            if (isIpv4EndpointLikeOption(option)) {
+                stream.writeIpv4Address(option.getIpv4Address());
+                stream.writeUint8(0);
+                stream.writeUint8(option.getL4Protocol());
+                stream.writeUint16Be(option.getPort());
+            }
+            else if (option.getType() == LOADBALANCING) {
+                stream.writeUint16Be(option.getPriority());
+                stream.writeUint16Be(option.getWeight());
+            }
+            else if (option.getType() == CONFIGURATION) {
+                const char *configuration = option.getConfiguration();
+                stream.writeBytes(reinterpret_cast<const uint8_t *>(configuration), B(strlen(configuration)));
+                stream.writeUint8(0);
+            }
+            else
+                stream.writeByteRepeatedly(0, length - 1);
+        }
+    }
+
+    virtual const Ptr<Chunk> deserialize(MemoryInputStream& stream) const override
+    {
+        auto header = makeShared<SomeIpSDHeader>();
+        readSomeIpHeader(stream, *header);
+        header->setFlags(stream.readUint8());
+        stream.readUint8();
+        stream.readUint16Be();
+        const uint32_t entriesLength = stream.readUint32Be();
+        if (entriesLength % SOMEIP_SD_ENTRY_BYTES != 0 || B(entriesLength) > stream.getRemainingLength()) {
+            header->markIncorrect();
+            return header;
+        }
+        header->setEntriesArraySize(entriesLength / SOMEIP_SD_ENTRY_BYTES);
+        for (size_t i = 0; i < header->getEntriesArraySize(); ++i) {
+            SomeIpSDEntry entry;
+            entry.setType(stream.readUint8());
+            entry.setIndex1stOptions(stream.readUint8());
+            entry.setIndex2ndOptions(stream.readUint8());
+            const uint8_t counts = stream.readUint8();
+            entry.setNum1stOptions(counts >> 4);
+            entry.setNum2ndOptions(counts & 0x0f);
+            entry.setServiceId(stream.readUint16Be());
+            entry.setInstanceId(stream.readUint16Be());
+            entry.setMajorVersion(stream.readUint8());
+            entry.setTtl(stream.readUint24Be());
+            if (isServiceEntry(entry))
+                entry.setMinorVersion(stream.readUint32Be());
+            else {
+                stream.readUint8();
+                entry.setCounter(stream.readUint8() & 0x0f);
+                entry.setEventgroupId(stream.readUint16Be());
+            }
+            header->setEntries(i, entry);
+        }
+        uint32_t optionsLength = stream.readUint32Be();
+        if (B(optionsLength) > stream.getRemainingLength()) {
+            header->markIncorrect();
+            return header;
+        }
+        std::vector<SomeIpSDOption> options;
+        while (optionsLength >= 4) {
+            SomeIpSDOption option;
+            const uint16_t length = stream.readUint16Be();
+            option.setType(stream.readUint8());
+            option.setDiscardable(stream.readUint8() & 0x80);
+            if (length < 1 || 3u + length > optionsLength) {
+                header->markIncorrect();
+                break;
+            }
+            if (isIpv4EndpointLikeOption(option) && length == 9) {
+                option.setIpv4Address(stream.readIpv4Address());
+                stream.readUint8();
+                option.setL4Protocol(stream.readUint8());
+                option.setPort(stream.readUint16Be());
+            }
+            else if (option.getType() == LOADBALANCING && length == 5) {
+                option.setPriority(stream.readUint16Be());
+                option.setWeight(stream.readUint16Be());
+            }
+            else if (option.getType() == CONFIGURATION) {
+                std::vector<uint8_t> bytes;
+                stream.readBytes(bytes, B(length - 1));
+                if (!bytes.empty() && bytes.back() == 0)
+                    bytes.pop_back();
+                else
+                    header->markIncorrect();
+                option.setConfiguration(std::string(bytes.begin(), bytes.end()).c_str());
+            }
+            else {
+                if (isIpv4EndpointLikeOption(option) || option.getType() == LOADBALANCING)
+                    header->markIncorrect();
+                option.setUnknownLength(length);
+                stream.readByteRepeatedly(0, length - 1);
+            }
+            options.push_back(option);
+            optionsLength -= 3 + length;
+        }
+        if (optionsLength != 0)
+            header->markIncorrect();
+        header->setOptionsArraySize(options.size());
+        for (size_t i = 0; i < options.size(); ++i)
+            header->setOptions(i, options[i]);
+        // Keep the received length field; the chunk length is set from the consumed bytes so that
+        // receivers can detect a length field that disagrees with the parsed structure.
+        return header;
+    }
+};
+
+Register_Serializer(SomeIpHeader, SomeIpHeaderSerializer);
+Register_Serializer(SomeIpSDHeader, SomeIpSDHeaderSerializer);
+
+} // namespace SOA4CoRE

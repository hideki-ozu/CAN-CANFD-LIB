+#include "soa4core/endpoints/publisher/someip/base/SOMEIPPublisherEndpointBase.h"
+#include "soa4core/applications/publisher/base/Publisher.h"
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+using namespace inet;
+
+namespace SOA4CoRE {
+
+void SOMEIPPublisherEndpointBase::prependSomeIpHeader(Packet* packet, ServiceBase* application)
+{
+    Publisher* publisher = dynamic_cast<Publisher*>(application);
+    if (!publisher)
+        throw omnetpp::cRuntimeError("SOME/IP publisher endpoint requires a Publisher application");
+    _protector.configure(publisher, publisher->getServiceId(), publisher->getEventId());
+    if (_protector.replayNext()) {
+        // Fault injection: the previous message (header and payload) is sent again.
+        auto header = makeShared<SomeIpHeader>(_protector.replay(packet));
+        finalizeSomeIpHeader(*header, B(packet->getDataLength()).get());
+        packet->insertAtFront(header);
+        packet->setName(getMessageName(publisher->getServiceId()).c_str());
+        return;
+    }
+    _sessionId = _sessionId == 0xFFFF ? 1 : _sessionId + 1;
+    auto header = makeShared<SomeIpHeader>();
+    header->setServiceId(publisher->getServiceId());
+    header->setMethodId(publisher->getEventId());
+    header->setClientId(0);
+    header->setSessionId(_sessionId);
+    header->setMessageType(NOTIFICATION);
+    header->setReturnCode(E_OK);
+    _protector.protect(packet, *header);
+    finalizeSomeIpHeader(*header, B(packet->getDataLength()).get());
+    packet->insertAtFront(header);
+    packet->setName(getMessageName(publisher->getServiceId()).c_str());
+}
+
+} /*end namespace SOA4CoRE*/

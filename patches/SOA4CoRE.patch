+
+// Bytes an option occupies on the wire (length + type fields included).
+size_t someIpSdOptionBytes(const SomeIpSDOption& option);
+// Value of the option's length field (bytes after the type field).
+uint16_t someIpSdOptionLengthField(const SomeIpSDOption& option);
+
+// Recomputes the SOME/IP length field and chunk length after entries/options changed.
+void finalizeSomeIpSd(SomeIpSDHeader& header);

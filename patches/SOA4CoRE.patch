diff --git a/src-inet4/soa4core/messages/someip/SomeIp.msg b/src-inet4/soa4core/messages/someip/SomeIp.msg
new file mode 100644
index 0000000..0948a48
--- /dev/null
+++ b/src-inet4/soa4core/messages/someip/SomeIp.msg
@@ -0,0 +1,142 @@
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// INET4 port: SOME/IP and SOME/IP-SD as byte-exact INET chunks
+// (AUTOSAR PRS_SOMEIPProtocol / PRS_SOMEIPServiceDiscoveryProtocol).
+// Serializers: SomeIpSerializer.cc. Helpers: SomeIpSd.h.
+//
+import inet.common.INETDefs;
+import inet.common.packet.chunk.Chunk;
+import inet.networklayer.contract.ipv4.Ipv4Address;
+
+namespace SOA4CoRE;
+
+cplusplus {{
+#define SOMEIP_HEADER_BYTES 16
+#define ADDITIONAL_BYTES_TO_PAYLOADLENGTH 8   // request ID .. return code are covered by the length field
+#define SOMEIP_SD_SERVICE_ID 0xFFFF
+#define SOMEIP_SD_METHOD_ID 0x8100
+#define SOMEIP_SD_FLAG_REBOOT 0x80
+#define SOMEIP_SD_FLAG_UNICAST 0x40
+#define SOMEIP_SD_ENTRY_BYTES 16
+}}
+
+enum MessageType {
+    REQUEST              = 0x00;
+    REQUEST_NO_RETURN    = 0x01;
+    NOTIFICATION         = 0x02;
+    RESPONSE             = 0x80;
+    ERROR                = 0x81;
+    TP_REQUEST           = 0x20;
+    TP_REQUEST_NO_RETURN = 0x21;
+    TP_NOTIFICATION      = 0x22;
+    TP_RESPONSE          = 0xa0;
+    TP_ERROR             = 0xa1;
+}
+
+enum ReturnCode {
+    E_OK                      = 0x00;
+    E_NOT_OK                  = 0x01;
+    E_UNKNOWN_SERVICE         = 0x02;
+    E_UNKNOWN_METHOD          = 0x03;
+    E_NOT_READY               = 0x04;
+    E_NOT_REACHABLE           = 0x05;
+    E_TIMEOUT                 = 0x06;
+    E_WRONG_PROTOCOL_VERSION  = 0x07;
+    E_WRONG_INTERFACE_VERSION = 0x08;
+    E_MALFORMED_MESSAGE       = 0x09;
+    E_WRONG_MESSAGE_TYPE      = 0x0a;
+}
+
+enum ProtocolVersion {
+    PV_1 = 0x01;
+}
+
+enum InterfaceVersion {
+    IV_1 = 0x01;
+}
+
+// SOME/IP header (16 bytes). Message ID = service ID | method/event ID,
+// Request ID = client ID | session ID. length = 8 + payload bytes.
+class SomeIpHeader extends inet::FieldsChunk
+{
+    chunkLength = inet::B(SOMEIP_HEADER_BYTES);
+    uint16_t serviceId;
+    uint16_t methodId;
+    uint32_t length = ADDITIONAL_BYTES_TO_PAYLOADLENGTH;
+    uint16_t clientId;
+    uint16_t sessionId;
+    uint8_t protocolVersion = PV_1;
+    uint8_t interfaceVersion = IV_1;
+    uint8_t messageType @enum(MessageType) = NOTIFICATION;
+    uint8_t returnCode @enum(ReturnCode) = E_OK;
+}
+
+enum SomeIpSDEntryType {
+    FIND                  = 0x00;
+    OFFER                 = 0x01;   // also StopOffer with TTL 0
+    SUBSCRIBEVENTGROUP    = 0x06;   // also StopSubscribe with TTL 0
+    SUBSCRIBEVENTGROUPACK = 0x07;   // also Nack with TTL 0
+}
+
+enum SomeIpSDOptionType {
+    CONFIGURATION  = 0x01;
+    LOADBALANCING  = 0x02;
+    IPV4ENDPOINT   = 0x04;
+    IPV6ENDPOINT   = 0x06;
+    IPV4MULTICAST  = 0x14;
+    IPV6MULTICAST  = 0x16;
+    IPV4SDENDPOINT = 0x24;
+    IPV6SDENDPOINT = 0x26;
+}
+
+// One 16-byte SD entry. Service entries (FIND/OFFER) use minorVersion;
+// eventgroup entries use counter (4 bit) and eventgroupId.
+class SomeIpSDEntry extends cObject
+{
+    uint8_t type @enum(SomeIpSDEntryType);
+    uint8_t index1stOptions;
+    uint8_t index2ndOptions;
+    uint8_t num1stOptions;      // 4 bit
+    uint8_t num2ndOptions;      // 4 bit
+    uint16_t serviceId;
+    uint16_t instanceId;
+    uint8_t majorVersion;
+    uint32_t ttl;               // 24 bit, seconds; 0xFFFFFF = until next reboot
+    uint32_t minorVersion;
+    uint8_t counter;            // 4 bit
+    uint16_t eventgroupId;
+}
+
+// One SD option. The wire length is derived from the type:
+// IPv4 endpoint/multicast/SD endpoint = 12 bytes, load balancing = 8,
+// configuration = 4 + configuration string. Unknown types keep their length
+// and are skipped (their content is not preserved).
+class SomeIpSDOption extends cObject
+{
+    uint8_t type @enum(SomeIpSDOptionType);
+    bool discardable;           // most significant bit of the reserved byte
+    inet::Ipv4Address ipv4Address;
+    uint8_t l4Protocol;         // 0x06 TCP, 0x11 UDP
+    uint16_t port;
+    uint16_t priority;
+    uint16_t weight;
+    string configuration;       // DNS-TXT style items: <len>key=value ... <0>
+    uint16_t unknownLength;     // wire length field of an unsupported option type
+}
+
+// SOME/IP-SD message: SOME/IP header (service 0xFFFF, method 0x8100,
+// client 0x0000, NOTIFICATION) + flags + entries array + options array.
+class SomeIpSDHeader extends SomeIpHeader
+{
+    serviceId = SOMEIP_SD_SERVICE_ID;
+    methodId = SOMEIP_SD_METHOD_ID;
+    clientId = 0;
+    messageType = NOTIFICATION;
+    uint8_t flags = SOMEIP_SD_FLAG_REBOOT | SOMEIP_SD_FLAG_UNICAST;
+    SomeIpSDEntry entries[];
+    SomeIpSDOption options[];
+}
diff --git a/src-inet4/soa4core/messages/someip/SomeIpSd.cc b/src-inet4/soa4core/messages/someip/SomeIpSd.cc
new file mode 100644
index 0000000..cbdbf50
--- /dev/null
+++ b/src-inet4/soa4core/messages/someip/SomeIpSd.cc
@@ -0,0 +1,106 @@
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+uint16_t someIpSdOptionLengthField(const SomeIpSDOption& option)
+{
+    switch (option.getType()) {
+        case IPV4ENDPOINT:
+        case IPV4MULTICAST:
+        case IPV4SDENDPOINT:
+            return 0x0009;
+        case LOADBALANCING:
+            return 0x0005;
+        case CONFIGURATION:
+            // reserved byte + items + terminating zero-length item
+            return 1 + strlen(option.getConfiguration()) + 1;
+        default:
+            return option.getUnknownLength();
+    }
+}
+
+size_t someIpSdOptionBytes(const SomeIpSDOption& option)
+{
+    return 3 + someIpSdOptionLengthField(option);
+}
+
+void finalizeSomeIpSd(SomeIpSDHeader& header)
+{
+    size_t optionsBytes = 0;
+    for (size_t i = 0; i < header.getOptionsArraySize(); ++i)
+        optionsBytes += someIpSdOptionBytes(header.getOptions(i));
+    const size_t total = SOMEIP_HEADER_BYTES + 4 + 4 + SOMEIP_SD_ENTRY_BYTES * header.getEntriesArraySize() + 4 + optionsBytes;
+    header.setLength(total - 8);
+    header.setChunkLength(B(total));
+}
+
+void finalizeSomeIpHeader(SomeIpHeader& header, size_t payloadBytes)
+{
+    header.setLength(ADDITIONAL_BYTES_TO_PAYLOADLENGTH + payloadBytes);
+}
+
+SomeIpSDOption makeIpv4Option(SomeIpSDOptionType type, const Ipv4Address& address, uint8_t l4Protocol, uint16_t port)
+{
+    SomeIpSDOption option;
+    option.setType(type);
+    option.setIpv4Address(address);
+    option.setL4Protocol(l4Protocol);
+    option.setPort(port);
+    return option;
+}
+
+SomeIpSDOption makeConfigurationOption(const ConfigurationItems& items)
+{
+    std::string configuration;
+    for (const auto& item : items) {
+        const std::string text = item.first + "=" + item.second;
+        if (text.empty() || text.size() > 255 || item.first.empty())
+            throw cRuntimeError("SOME/IP-SD configuration item '%s' must have a key and at most 255 bytes", text.c_str());
+        configuration.push_back(static_cast<char>(text.size()));
+        configuration += text;
+    }
+    SomeIpSDOption option;
+    option.setType(CONFIGURATION);
+    option.setConfiguration(configuration.c_str());
+    return option;
+}
+
+ConfigurationItems parseConfiguration(const std::string& configuration)
+{
+    ConfigurationItems items;
+    size_t offset = 0;
+    while (offset < configuration.size()) {
+        const size_t length = static_cast<uint8_t>(configuration[offset++]);
+        if (length == 0 || offset + length > configuration.size())
+            break;
+        const std::string text = configuration.substr(offset, length);
+        offset += length;
+        const size_t equals = text.find('=');
+        if (equals == std::string::npos)
+            items.emplace_back(text, "");
+        else
+            items.emplace_back(text.substr(0, equals), text.substr(equals + 1));
+    }
+    return items;
+}
+
+bool isServiceEntry(const SomeIpSDEntry& entry)
+{
+    return entry.getType() == FIND || entry.getType() == OFFER;
+}
+
+bool isIpv4EndpointLikeOption(const SomeIpSDOption& option)
+{
+    return option.getType() == IPV4ENDPOINT || option.getType() == IPV4MULTICAST || option.getType() == IPV4SDENDPOINT;
+}
+
+} // namespace SOA4CoRE

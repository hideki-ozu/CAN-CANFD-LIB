+//
+// INET4 port: SOME/IP-SD on an INET4 UdpSocket (previously derived from the INET3
+// UDPBasicApp). Messages are byte-exact SomeIpSDHeader chunks. Session handling
+// follows PRS_SOMEIPSD: separate session ID counters for multicast and for each
+// unicast peer, starting at 1, reboot flag set until the counter wraps.
+//
+
+#ifndef SOA4CORE_DISCOVERY_SOMEIP_SOMEIPSD_H_
+#define SOA4CORE_DISCOVERY_SOMEIP_SOMEIPSD_H_
+
+#include <map>
+
+#include "soa4core/discovery/base/IServiceDiscovery.h"
+#include "soa4core/discovery/SomeIpDiscoveryNotification.h"
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+#include "inet/networklayer/common/L3Address.h"
+#include "inet/transportlayer/contract/udp/UdpSocket.h"
+
+namespace SOA4CoRE {
+
+class SomeIpSD : public IServiceDiscovery, public cSimpleModule, public cListener, public inet::UdpSocket::ICallback
+{
+  public:
+    void discover(ServiceIdentifier serviceIdentifier) override;
+    virtual void receiveSignal(cComponent *source, simsignal_t signalID, cObject *obj, cObject *details) override;
+
+  protected:
+    virtual int numInitStages() const override { return inet::NUM_INIT_STAGES; }
+    virtual void initialize(int stage) override;
+    virtual void handleMessage(cMessage *msg) override;
+    virtual void finish() override;
+
+    virtual void socketDataArrived(inet::UdpSocket *socket, inet::Packet *packet) override;
+    virtual void socketErrorArrived(inet::UdpSocket *socket, inet::Indication *indication) override;
+    virtual void socketClosed(inet::UdpSocket *socket) override {}
+
+  private:
+    void find(uint16_t serviceID, uint16_t instanceID);
+    void offer(SomeIpDiscoveryNotification* someIpDiscoveryNotification);
+    void subscribeEventgroup(SomeIpDiscoveryNotification* someIpDiscoveryNotification);
+    void subscribeEventgroupAck(SomeIpDiscoveryNotification* someIpDiscoveryNotification);
+    void processSomeIpSDHeader(const SomeIpSDHeader& header, const inet::L3Address& source);
+    void processFindEntry(const SomeIpSDEntry& entry, const inet::L3Address& source);
+    void processFindResult(cObject* obj);
+    void processOfferEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const inet::L3Address& source);
+    void processSubscription(cObject* obj);
+    void processAcknowledgment(cObject *obj);
+    void processSubscribeEventGroupEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const inet::L3Address& source);
+    void processSubscribeEventGroupAckEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const inet::L3Address& source);
+    // Options referenced by both option runs of an entry; false if either reference is out of range.
+    bool getReferencedOptions(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, std::vector<const SomeIpSDOption*>& options);
+    SomeIpSDEntry createEntry(SomeIpSDEntryType type, uint16_t serviceId, uint16_t instanceId, int numOptions);
+    SomeIpSDOption createIpv4Endpoint(SomeIpDiscoveryNotification* someIpDiscoveryNotification, QoSGroup qosGroup = QoSGroup::UNDEFINED);
+    void sendTo(inet::Ptr<SomeIpSDHeader> header, const char *name, inet::L3Address destIp = inet::L3Address(), int destPort = -1);
+
+  protected:
+    omnetpp::simsignal_t _serviceFindSignal;
+    omnetpp::simsignal_t _subscribeEventGroupSignal;
+    omnetpp::simsignal_t _subscribeEventGroupAckSignal;
+
+  private:
+    struct SessionCounter {
+        uint16_t sessionId = 0;
+        bool reboot = true;
+    };
+    inet::UdpSocket _socket;
+    inet::L3Address _localAddress;
+    inet::L3Address _mcastDestAddress;
+    int _localPort = 30490;
+    int _destPort = 30490;
+    uint32_t _ttl = 0xFFFFFF;
+    bool _hasQoSNP = false;
+    bool _includeIEEE8021QConfig = false;
+    bool _includeRessourceConfig = false;
+    bool _includeRealTimeConfig = false;
+    SessionCounter _multicastSession;
+    std::map<inet::L3Address, SessionCounter> _unicastSessions;
+    long _numSent = 0, _numReceived = 0, _numInvalid = 0, _numInvalidOptionReferences = 0;
+    std::map<int, long> _entriesSent, _entriesReceived;
+};
+
+} /* end namespace SOA4CoRE */
+
+#endif

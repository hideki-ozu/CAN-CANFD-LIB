+// along with this program.  If not, see http://www.gnu.org/licenses/.
+//
+
+#include "soa4core/endpoints/publisher/ip/base/IPPublisherEndpointBase.h"
+#include "soa4core/applications/publisher/base/Publisher.h"
+#include "soa4core/connector/publisher/PublisherConnector.h"
+
+#include "inet/common/Protocol.h"
+#include "inet/common/ProtocolUtils.h"
+#include "inet/common/TimeTag_m.h"
+#include "inet/common/packet/chunk/ByteCountChunk.h"
+#include "inet/linklayer/common/PcpTag_m.h"
+#include "inet/linklayer/common/VlanTag_m.h"
+
+using namespace std;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+namespace {
+const size_t ETHER_MAC_FRAME_BYTES = 18;      // MAC header + FCS
+const size_t ETHER_8021Q_TAG_BYTES = 4;
+const size_t IPV4_HEADER_BYTES = 20;
+const size_t MAX_ETHERNET_FRAME_BYTES = 1522; // with 802.1Q tag
+}
+
+bool IPPublisherEndpointBase::has8021QInformation() {
+    return _pcp >= 0 && _vlanID >= 0;
+}
+
+void IPPublisherEndpointBase::initialize()
+{
+    PublisherEndpointBase::initialize();
+}
+
+void IPPublisherEndpointBase::handleParameterChange(const char* parname)
+{
+    PublisherEndpointBase::handleParameterChange(parname);
+    if (!parname || !strcmp(parname, "localAddress"))
+    {
+        _localAddress = par("localAddress").stdstringValue();
+    }
+    if (!parname || !strcmp(parname, "localPort"))
+    {
+        _localPort = par("localPort");
+    }
+    if (!parname || !strcmp(parname, "vlan_id"))
+    {
+        const int vlan = par("vlan_id").intValue();
+        if (vlan != -1 && (vlan < 0 || vlan > 4094))
+            throw cRuntimeError("vlan_id must be -1 (untagged) or 0..4094");
+        _vlanID = vlan;
+    }
+    if (!parname || !strcmp(parname, "pcp"))
+    {
+        const int pcp = par("pcp").intValue();
+        if (pcp != -1 && (pcp < 0 || pcp > 7))
+            throw cRuntimeError("pcp must be -1 (none) or 0..7");
+        _pcp = pcp;
+    }
+    if (!parname || !strcmp(parname, "registerStream"))
+    {
+        _registerStream = par("registerStream").boolValue();
+    }
+    if (!parname || !strcmp(parname, "advertiseStreamRegistration"))
+    {
+        _advertiseStreamRegistration = par("advertiseStreamRegistration").boolValue();
+    }
+}
+
+void IPPublisherEndpointBase::checkStreamReservation()
+{
+    Publisher* app = dynamic_cast<Publisher*>(_publisherConnector->getApplication());
+    if (has8021QInformation() && _registerStream && app && !app->getPreventReservation())
+        throw cRuntimeError("registerStream=true needs CoRE4INET SRP, which is not part of the INET4 port. "
+                "Use PCP/VLAN tags with statically configured INET TSN shapers instead.");
+}
+
+Packet* IPPublisherEndpointBase::createPayloadPacket(cPacket* applicationMessage)
+{
+    Packet* packet = new Packet(applicationMessage->getName());
+    if (applicationMessage->getByteLength() > 0) {
+        // Chunk-level tag (INET convention) survives UDP, TCP stream queues and reassembly.
+        auto payload = makeShared<ByteCountChunk>(B(applicationMessage->getByteLength()), 0);  // zero-filled when serialized
+        payload->addTag<CreationTimeTag>()->setCreationTime(applicationMessage->getTimestamp());
+        packet->insertAtBack(payload);
+    }
+    addStreamTags(packet);
+    return packet;
+}
+
+void IPPublisherEndpointBase::addStreamTags(Packet* packet)
+{
+    if (_pcp >= 0)
+        packet->addTagIfAbsent<PcpReq>()->setPcp(_pcp);
+    if (_vlanID >= 0)
+        packet->addTagIfAbsent<VlanReq>()->setVlanId(_vlanID);
+    // Same request INET's StreamEncoder issues: route the frame through the 802.1Q layer.
+    if (_pcp >= 0 || _vlanID >= 0)
+        ensureEncapsulationProtocolReq(packet, &Protocol::ieee8021qCTag);
+}
+
+uint16_t IPPublisherEndpointBase::calculateL2Framesize(uint16_t payload)
+{
+    return getHeaderBytes() + payload;
+}
+
+size_t IPPublisherEndpointBase::getHeaderBytes()
+{
+    return ETHER_MAC_FRAME_BYTES + (has8021QInformation() ? ETHER_8021Q_TAG_BYTES : 0) + IPV4_HEADER_BYTES;
+}
+
+size_t IPPublisherEndpointBase::getMaxPhysicalFrameSize()
+{
+    return has8021QInformation() ? MAX_ETHERNET_FRAME_BYTES : MAX_ETHERNET_FRAME_BYTES - ETHER_8021Q_TAG_BYTES;
+}
+
+uint64_t IPPublisherEndpointBase::createStreamId(Ipv4Address destAddress)
+{
+    Publisher* app = dynamic_cast<Publisher*>(_publisherConnector->getApplication());
+    if (!app) {
+        throw cRuntimeError("Publisher could not be resolved.");
+    }
+    return app->getStreamId();
+}
+
+} /*end namespace SOA4CoRE*/

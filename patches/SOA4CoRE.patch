+// 
+
+
+package soa4core.discovery.someip;
+
+import soa4core.discovery.base.IServiceDiscovery;
+
+//
+// SOME/IP Service Discovery (INET4 port).
+//
+// Uses an INET4 UdpSocket on port 30490 and the SD multicast group. Messages are
+// byte-exact SOME/IP-SD (service 0xFFFF, method 0x8100) with Find, Offer,
+// SubscribeEventgroup and SubscribeEventgroupAck entries and IPv4 endpoint /
+// IPv4 multicast / configuration options.
+//
+simple SomeIpSD like IServiceDiscovery
+{
+    parameters:
+        @class(SOA4CoRE::SomeIpSD);
+        @display("i=block/network2");
+        @signal[serviceFindSignal];
+        @signal[serviceOfferSignal];
+        @signal[subscribeEventGroupSignal];
+        @signal[subscribeEventGroupAckSignal];
+        string localAddress;                      // own IPv4 address (module path or address)
+        int localPort = default(30490);
+        int destPort = default(30490);
+        string multicastInterface = default("eth0");
+        string mcastDestAddress = default("224.0.2.254"); // SOA4CoRE default; AUTOSAR examples often use 224.224.224.245
+        int ttl = default(0xFFFFFF);              // entry TTL in seconds, 0xFFFFFF = until next reboot
+        bool includeIEEE8021QConfig = default(false);
+        bool includeRessourceConfig = default(false);
+        bool includeRealTimeConfig = default(false);
+    gates:
+        input udpIn @loose;
+        output udpOut @loose;
+}

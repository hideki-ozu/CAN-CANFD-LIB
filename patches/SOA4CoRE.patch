+#include "soa4core/endpoints/subscriber/someip/base/SOMEIPSubscriberEndpointBase.h"
+#include "soa4core/applications/base/ServiceBase.h"
+
+using namespace inet;
+
+namespace SOA4CoRE {
+
+bool SOMEIPSubscriberEndpointBase::isValidHeader(const SomeIpHeader& header, b dataAfterHeader, int expectedServiceId) const
+{
+    return header.isCorrect()
+            && header.getProtocolVersion() == PV_1
+            && header.getMessageType() == NOTIFICATION
+            && (header.getMethodId() & 0x8000)
+            && B(header.getLength()) == B(ADDITIONAL_BYTES_TO_PAYLOADLENGTH) + dataAfterHeader
+            && (expectedServiceId < 0 || header.getServiceId() == expectedServiceId);
+}
+
+bool SOMEIPSubscriberEndpointBase::acceptSomeIpMessage(Packet* packet, ServiceBase* application)
+{
+    const int expectedServiceId = application ? application->getServiceId() : -1;
+    if (packet->getDataLength() < B(SOMEIP_HEADER_BYTES)) {
+        ++_someIpInvalid;
+        return false;
+    }
+    const auto& header = packet->popAtFront<SomeIpHeader>(B(SOMEIP_HEADER_BYTES), Chunk::PF_ALLOW_INCORRECT);
+    if (!isValidHeader(*header, packet->getDataLength(), expectedServiceId)) {
+        ++_someIpInvalid;
+        return false;
+    }
+    ++_someIpReceived;
+    if (header->getSessionId() != 0) {  // 0 = session handling inactive
+        const uint32_t key = (uint32_t(header->getServiceId()) << 16) | header->getMethodId();
+        auto it = _nextSession.find(key);
+        if (it != _nextSession.end() && header->getSessionId() != it->second) {
+            const int delta = (int(header->getSessionId()) - int(it->second) + 0xFFFF) % 0xFFFF;
+            if (delta < 0x8000)
+                _someIpSessionGaps += delta;
+        }
+        _nextSession[key] = header->getSessionId() == 0xFFFF ? 1 : header->getSessionId() + 1;
+    }
+    if (application)
+        _verifier.configure(application, header->getServiceId(), header->getMethodId());
+    return _verifier.accept(packet, *header);
+}
+
+void SOMEIPSubscriberEndpointBase::recordSomeIpStatistics(omnetpp::cComponent* owner) const
+{
+    owner->recordScalar("someipReceived", _someIpReceived);
+    owner->recordScalar("someipInvalid", _someIpInvalid);
+    owner->recordScalar("someipSessionGaps", _someIpSessionGaps);
+    _verifier.record(owner);
+}
+
+} /*end namespace SOA4CoRE*/

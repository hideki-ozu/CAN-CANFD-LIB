+ConnectionSpecificInformation* SOMEIPTCPPublisherEndpoint::getConnectionSpecificInformation() {
+    CSI_SOMEIP_TCP* connection = new CSI_SOMEIP_TCP();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    return connection;
+}
+
+Packet* SOMEIPTCPPublisherEndpoint::createTransportPacket(cPacket* msg) {
+    Packet* packet = createPayloadPacket(msg);
+    prependSomeIpHeader(packet, _publisherConnector->getApplication());
+    if (*(msg->getName()))
+        packet->setName(msg->getName());
+    return packet;
+}
+
+size_t SOMEIPTCPPublisherEndpoint::getHeaderBytes() {
+    return TCPPublisherEndpoint::getHeaderBytes() + SOMEIP_HEADER_BYTES;
+}
+
+uint64_t SOMEIPTCPPublisherEndpoint::createStreamId(Ipv4Address destAddress) {
+    ServiceBase* app = _publisherConnector->getApplication();
+    return buildStreamIDForService(app->getServiceId(), app->getInstanceId(), destAddress);
+}
+
+void SOMEIPTCPPublisherEndpoint::finish() {
+    TCPPublisherEndpoint::finish();
+    recordProtectionStatistics(this);
+}

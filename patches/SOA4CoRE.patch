+// along with this program.  If not, see http://www.gnu.org/licenses/.
+//
+
+#include "soa4core/protection/SomeIpProtection.h"
+
+#include <algorithm>
+
+#include "inet/common/TimeTag_m.h"
+#include "inet/common/packet/chunk/BytesChunk.h"
+
+using namespace inet;
+using namespace autosar;
+
+namespace SOA4CoRE {
+namespace {
+
+// Serialized SOME/IP header bytes 8..15 (Request ID .. Return Code).
+Bytes upperHeader(const SomeIpHeader& h)
+{
+    return {uint8_t(h.getClientId() >> 8), uint8_t(h.getClientId()), uint8_t(h.getSessionId() >> 8),
+            uint8_t(h.getSessionId()), h.getProtocolVersion(), h.getInterfaceVersion(), h.getMessageType(),
+            h.getReturnCode()};
+}
+
+Bytes messageId(const SomeIpHeader& h)
+{
+    return {uint8_t(h.getServiceId() >> 8), uint8_t(h.getServiceId()), uint8_t(h.getMethodId() >> 8),
+            uint8_t(h.getMethodId())};
+}
+
+simtime_t creationTimeOf(const Packet* packet)
+{
+    simtime_t creation = simTime();
+    if (packet->getDataLength() > b(0))
+        for (const auto& region : packet->peekData()->getAllTags<CreationTimeTag>())
+            creation = std::min(creation, region.getTag()->getCreationTime());
+    return creation;
+}
+
+void replacePayload(Packet* packet, const Bytes& bytes, simtime_t creation)
+{
+    packet->eraseData();
+    if (bytes.empty())
+        return;
+    auto chunk = makeShared<BytesChunk>(bytes);
+    chunk->addTag<CreationTimeTag>()->setCreationTime(creation);
+    packet->insertAtBack(chunk);
+}
+
+} // namespace
+
+ProtectionConfig readSomeIpProtection(cComponent *application, uint16_t serviceId, uint16_t eventId)
+{
+    // Default DataIDs: service ID | event ID for the 32 bit profiles, else the event ID.
+    const E2EProfile profile = parseE2EProfile(application->par("e2eProfile").stdstringValue());
+    const bool wide = profile == E2EProfile::P04 || profile == E2EProfile::P07;
+    ProtectionConfig config = readProtectionConfig(application, wide ? (uint32_t(serviceId) << 16) | eventId : eventId, eventId);
+    if (config.e2e.profile != E2EProfile::None && config.e2e.offset < SOMEIP_E2E_UPPER_HEADER_BYTES)
+        throw cRuntimeError(application, "SOME/IP e2eOffset must be at least 8 (the E2E header follows the SOME/IP header)");
+    return config;
+}
+
+void SomeIpProtector::configure(cComponent *application, uint16_t serviceId, uint16_t eventId)
+{
+    if (_configured)
+        return;
+    _configured = true;
+    _config = readSomeIpProtection(application, serviceId, eventId);
+    _enabled = _config.e2e.profile != E2EProfile::None || _config.secocEnabled;
+    _e2e = std::make_unique<E2EProtector>(_config.e2e);
+    if (_config.secocEnabled)
+        _secoc = std::make_unique<SecOcSender>(_config.secoc);
+    _corruptAt = parseIndexList(application->par("faultCorruptAt").stringValue());
+    _replayAt = parseIndexList(application->par("faultReplayAt").stringValue());
+    _skipAt = parseIndexList(application->par("faultSkipAt").stringValue());
+    _skipCount = application->par("faultSkipCount").intValue();
+}
+
+bool SomeIpProtector::replayNext()
+{
+    return _enabled && !_lastPayload.empty() && _replayAt.count(_sent + 1);
+}
+
+const SomeIpHeader& SomeIpProtector::replay(Packet* packet)
+{
+    ++_sent;
+    ++_replayed;
+    replacePayload(packet, _lastPayload, creationTimeOf(packet));
+    return _lastHeader;
+}
+
+void SomeIpProtector::protect(Packet* packet, const SomeIpHeader& header)
+{
+    if (!_enabled)
+        return;
+    ++_sent;
+    if (_skipAt.count(_sent)) {
+        _e2e->skip(_skipCount);
+        if (_secoc)
+            _secoc->skip(_skipCount);
+    }
+    const simtime_t creation = creationTimeOf(packet);
+    const size_t dataBytes = B(packet->getDataLength()).get();
+    const size_t e2eBytes = e2eHeaderBytes(_config.e2e.profile);
+    const size_t position = _config.e2e.profile == E2EProfile::None ? 0 : _config.e2e.offset - SOMEIP_E2E_UPPER_HEADER_BYTES;
+    if (position > dataBytes)
+        throw cRuntimeError("SOME/IP e2eOffset %zu lies behind the %zu byte payload", _config.e2e.offset, dataBytes);
+    Bytes area = upperHeader(header);
+    for (size_t i = 0; i < dataBytes; ++i) {
+        if (i == position)
+            area.insert(area.end(), e2eBytes, 0);
+        area.push_back(uint8_t(header.getSessionId() + i));
+    }
+    if (position == dataBytes)
+        area.insert(area.end(), e2eBytes, 0);
+    _e2e->protect(area.data(), area.size());
+    Bytes payload(area.begin() + SOMEIP_E2E_UPPER_HEADER_BYTES, area.end());
+    if (_secoc) {
+        Bytes authentic = messageId(header);
+        authentic.insert(authentic.end(), area.begin(), area.end());
+        const Bytes secured = _secoc->secure(authentic.data(), authentic.size());
+        payload.insert(payload.end(), secured.begin() + authentic.size(), secured.end());
+    }
+    _lastPayload = payload;
+    _lastHeader = header;
+    if (_corruptAt.count(_sent)) {
+        payload[payload.size() / 2] ^= 0x10;   // one bit error after protection
+        ++_corrupted;
+    }
+    replacePayload(packet, payload, creation);
+}
+
+void SomeIpProtector::record(cComponent *owner) const
+{
+    if (!_enabled)
+        return;
+    owner->recordScalar("protectedMessages", _sent);
+    owner->recordScalar("faultCorrupted", _corrupted);
+    owner->recordScalar("faultReplayed", _replayed);
+}
+
+void SomeIpVerifier::configure(cComponent *application, uint16_t serviceId, uint16_t eventId)
+{
+    if (_configured)
+        return;
+    _configured = true;
+    _config = readSomeIpProtection(application, serviceId, eventId);
+    _enabled = _config.e2e.profile != E2EProfile::None || _config.secocEnabled;
+    _e2e = std::make_unique<E2EChecker>(_config.e2e);
+    _sm = std::make_unique<E2EStateMachine>(_config.sm);
+    if (_config.secocEnabled)
+        _secoc = std::make_unique<SecOcReceiver>(_config.secoc);
+}
+
+bool SomeIpVerifier::accept(Packet* packet, const SomeIpHeader& header)
+{
+    if (!_enabled)
+        return true;
+    const simtime_t creation = creationTimeOf(packet);
+    const Bytes wire = packet->getDataLength() > b(0) ? packet->peekDataAsBytes()->getBytes() : Bytes();
+    Bytes area = upperHeader(header);
+    if (_secoc) {
+        Bytes secured = messageId(header);
+        secured.insert(secured.end(), area.begin(), area.end());
+        secured.insert(secured.end(), wire.begin(), wire.end());
+        Bytes authentic;
+        const SecOcVerifyResult result = _secoc->verify(secured.data(), secured.size(), authentic);
+        _stats.count(result);
+        if (result != SecOcVerifyResult::Ok)
+            return false;
+        area.assign(authentic.begin() + 4, authentic.end());
+    }
+    else
+        area.insert(area.end(), wire.begin(), wire.end());
+    E2ECheckStatus status = E2ECheckStatus::Ok;
+    if (_config.e2e.profile != E2EProfile::None) {
+        status = _e2e->check(area.data(), area.size());
+        _stats.count(status);
+        const E2ESmState state = _sm->check(status);
+        (state == E2ESmState::Valid ? _stats.smValid : _stats.smInvalid)++;
+    }
+    if (status != E2ECheckStatus::Ok && status != E2ECheckStatus::OkSomeLost)
+        return false;
+    // Application data: the E2E area without the upper header and the E2E header.
+    const size_t first = _config.e2e.profile == E2EProfile::None ? SOMEIP_E2E_UPPER_HEADER_BYTES : _config.e2e.offset;
+    const size_t last = first + e2eHeaderBytes(_config.e2e.profile);
+    Bytes data(area.begin() + SOMEIP_E2E_UPPER_HEADER_BYTES, area.begin() + first);
+    data.insert(data.end(), area.begin() + last, area.end());
+    for (size_t i = 0; i < data.size(); ++i)
+        if (data[i] != uint8_t(header.getSessionId() + i)) {
+            ++_patternErrors;
+            break;
+        }
+    ++_delivered;
+    replacePayload(packet, data, creation);
+    return true;
+}
+
+void SomeIpVerifier::record(cComponent *owner) const
+{
+    if (!_enabled)
+        return;
+    _stats.record(owner, "");
+    owner->recordScalar("protectionDelivered", _delivered);
+    owner->recordScalar("patternErrors", _patternErrors);
+    owner->recordScalar("e2eSmFinalState", int(_sm->state()));
+}
+
+} /*end namespace SOA4CoRE*/

+// along with this program.  If not, see http://www.gnu.org/licenses/.
+//
+
+#include "soa4core/endpoints/publisher/ip/tcp/TCPPublisherEndpoint.h"
+
+#include "inet/networklayer/common/L3AddressResolver.h"
+
+using namespace inet;
+
+namespace SOA4CoRE {
+
+Define_Module(TCPPublisherEndpoint);
+
+namespace {
+const size_t TCP_HEADER_BYTES = 20;
+}
+
+TCPPublisherEndpoint::~TCPPublisherEndpoint() {
+    _socketMap.deleteSockets();
+}
+
+ConnectionSpecificInformation* TCPPublisherEndpoint::getConnectionSpecificInformation() {
+    CSI_TCP* connection = new CSI_TCP();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    return connection;
+}
+
+void TCPPublisherEndpoint::initializeTransportConnection() {
+    connectToTransportGate();
+    _serverSocket.setOutputGate(gate(TRANSPORT_OUT_GATE_NAME));
+    _serverSocket.setCallback(this);
+    _serverSocket.bind(!_localAddress.empty() ? L3AddressResolver().resolve(_localAddress.c_str()) : L3Address(), _localPort);
+    _serverSocket.listen();
+}
+
+void TCPPublisherEndpoint::handleTransportIn(cMessage* msg) {
+    if (_serverSocket.belongsToSocket(msg))
+        _serverSocket.processMessage(msg);
+    else if (ISocket *socket = _socketMap.findSocketFor(msg))
+        socket->processMessage(msg);
+    else {
+        EV_WARN << "Message for unknown TCP connection ignored: " << msg->getName() << endl;
+        delete msg;
+    }
+}
+
+void TCPPublisherEndpoint::socketAvailable(TcpSocket *socket, TcpAvailableInfo *availableInfo) {
+    TcpSocket *connection = new TcpSocket(availableInfo);
+    connection->setOutputGate(gate(TRANSPORT_OUT_GATE_NAME));
+    connection->setCallback(this);
+    _socketMap.addSocket(connection);
+    socket->accept(availableInfo->getNewSocketId());
+}
+
+void TCPPublisherEndpoint::socketEstablished(TcpSocket *socket) {
+    checkStreamReservation();
+    _isConnected = true;
+    emit(_remotesSignal, (unsigned long)_socketMap.size());
+}
+
+void TCPPublisherEndpoint::socketDataArrived(TcpSocket *socket, Packet *packet, bool urgent) {
+    delete packet;
+}
+
+void TCPPublisherEndpoint::socketPeerClosed(TcpSocket *socket) {
+    socket->close();
+}
+
+void TCPPublisherEndpoint::socketFailure(TcpSocket *socket, int code) {
+    EV_WARN << "TCP connection failure " << code << endl;
+}
+
+Packet* TCPPublisherEndpoint::createTransportPacket(cPacket* msg) {
+    return createPayloadPacket(msg);
+}
+
+void TCPPublisherEndpoint::publish(cPacket* msg) {
+    if (!_isConnected)
+        return;
+    Packet* packet = createTransportPacket(msg);
+    for (auto& entry : _socketMap.getMap()) {
+        auto socket = check_and_cast<TcpSocket *>(entry.second);
+        if (socket->getState() == TcpSocket::CONNECTED)
+            socket->send(packet->dup());
+    }
+    delete packet;
+}
+
+size_t TCPPublisherEndpoint::getHeaderBytes() {
+    return IPPublisherEndpointBase::getHeaderBytes() + TCP_HEADER_BYTES;
+}
+
+} /*end namespace SOA4CoRE*/

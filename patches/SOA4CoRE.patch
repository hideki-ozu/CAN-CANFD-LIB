+}
diff --git a/src-inet4/soa4core/test/someip/SomeIpSdInjector.cc b/src-inet4/soa4core/test/someip/SomeIpSdInjector.cc
new file mode 100644
index 0000000..db0a8dc
--- /dev/null
+++ b/src-inet4/soa4core/test/someip/SomeIpSdInjector.cc
@@ -0,0 +1,86 @@
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// INET4 port, test only: injects a SOME/IP-SD message that uses the second option run.
+//
+#include "inet/common/packet/Packet.h"
+#include "inet/networklayer/common/IpProtocolId_m.h"
+#include "inet/networklayer/common/L3AddressResolver.h"
+#include "inet/transportlayer/contract/udp/UdpSocket.h"
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+class SomeIpSdInjector : public cSimpleModule
+{
+    UdpSocket socket;
+    cMessage *timer = nullptr;
+
+    static SomeIpSDEntry offerEntry(uint16_t serviceId, uint16_t instanceId)
+    {
+        SomeIpSDEntry entry;
+        entry.setType(OFFER);
+        entry.setServiceId(serviceId);
+        entry.setInstanceId(instanceId);
+        entry.setMajorVersion(0xff);
+        entry.setTtl(0xffffff);
+        entry.setMinorVersion(0xffffffff);
+        return entry;
+    }
+
+  protected:
+    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
+
+    virtual void initialize(int stage) override
+    {
+        if (stage == INITSTAGE_APPLICATION_LAYER) {
+            socket.setOutputGate(gate("socketOut"));
+            socket.bind(par("localPort").intValue());
+            timer = new cMessage("inject");
+            scheduleAt(par("sendTime"), timer);
+        }
+    }
+
+    virtual void handleMessage(cMessage *message) override
+    {
+        if (message != timer) {
+            delete message;
+            return;
+        }
+        const uint16_t serviceId = par("serviceId").intValue();
+        auto header = makeShared<SomeIpSDHeader>();
+        header->setSessionId(1);
+        header->appendOptions(makeConfigurationOption({{"soa4core.test", "second-run"}}));
+        header->appendOptions(makeIpv4Option(IPV4ENDPOINT, L3AddressResolver().resolve(par("endpointAddress")).toIpv4(),
+                IP_PROT_UDP, par("endpointPort").intValue()));
+
+        SomeIpSDEntry valid = offerEntry(serviceId, par("instanceId").intValue());
+        valid.setIndex1stOptions(0);
+        valid.setNum1stOptions(1);
+        valid.setIndex2ndOptions(1);
+        valid.setNum2ndOptions(1);
+        header->appendEntries(valid);
+
+        SomeIpSDEntry outOfRange = offerEntry(serviceId + 1, par("instanceId").intValue());
+        outOfRange.setIndex2ndOptions(header->getOptionsArraySize());
+        outOfRange.setNum2ndOptions(1);
+        header->appendEntries(outOfRange);
+
+        finalizeSomeIpSd(*header);
+        auto packet = new Packet("SOME/IP SD - injected OFFER", header);
+        socket.sendTo(packet, L3AddressResolver().resolve(par("destAddress")), par("destPort").intValue());
+    }
+
+  public:
+    virtual ~SomeIpSdInjector() { cancelAndDelete(timer); }
+};
+
+Define_Module(SomeIpSdInjector);
+

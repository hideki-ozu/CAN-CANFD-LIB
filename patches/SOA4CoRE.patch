+#include "soa4core/endpoints/subscriber/someip/tcp/SOMEIPTCPSubscriberEndpoint.h"
+#include "soa4core/applications/base/ServiceBase.h"
+#include "soa4core/connector/subscriber/SubscriberConnector.h"
+
+using namespace inet;
+
+namespace SOA4CoRE {
+
+Define_Module(SOMEIPTCPSubscriberEndpoint);
+
+ConnectionSpecificInformation* SOMEIPTCPSubscriberEndpoint::getConnectionSpecificInformation() {
+    CSI_SOMEIP_TCP* connection = new CSI_SOMEIP_TCP();
+    connection->setAddress(_localAddress.c_str());
+    connection->setPort(_localPort);
+    return connection;
+}
+
+ServiceBase* SOMEIPTCPSubscriberEndpoint::subscriberApplication() const {
+    if (_subscriberConnector && !_subscriberConnector->getApplications().empty())
+        return _subscriberConnector->getApplications()[0];
+    return nullptr;
+}
+
+// SOME/IP over TCP: messages may span or share TCP segments; reassemble by the length field.
+void SOMEIPTCPSubscriberEndpoint::handleStreamData(Packet *packet) {
+    _streamQueue.push(packet->peekData());
+    delete packet;
+    while (_streamQueue.getLength() >= B(SOMEIP_HEADER_BYTES)) {
+        const auto& header = _streamQueue.peek<SomeIpHeader>(B(SOMEIP_HEADER_BYTES), Chunk::PF_ALLOW_INCORRECT);
+        const b messageLength = B(SOMEIP_HEADER_BYTES - ADDITIONAL_BYTES_TO_PAYLOADLENGTH + header->getLength());
+        if (header->getLength() < ADDITIONAL_BYTES_TO_PAYLOADLENGTH || !header->isCorrect()) {
+            ++_someIpInvalid;  // stream framing is lost; drop the buffered data
+            _streamQueue.clear();
+            return;
+        }
+        if (_streamQueue.getLength() < messageLength)
+            return;
+        Packet* message = new Packet("SOME/IP", _streamQueue.pop(messageLength));
+        if (acceptSomeIpMessage(message, subscriberApplication()))
+            deliverToConnector(message);
+        else
+            delete message;
+    }
+}
+
+void SOMEIPTCPSubscriberEndpoint::finish() {
+    recordSomeIpStatistics(this);
+}
+
+} /*end namespace SOA4CoRE*/

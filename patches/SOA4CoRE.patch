+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// INET4 port: interface lookup shared by multicast endpoints and SOME/IP-SD.
+//
+#ifndef SOA4CORE_UTILITY_NETWORKINTERFACES_H_
+#define SOA4CORE_UTILITY_NETWORKINTERFACES_H_
+
+#include "inet/common/ModuleAccess.h"
+#include "inet/networklayer/common/NetworkInterface.h"
+#include "inet/networklayer/contract/IInterfaceTable.h"
+
+namespace SOA4CoRE {
+
+// Interface used for multicast: "eth0" if present, otherwise the first
+// non-loopback interface of the containing network node.
+inline inet::NetworkInterface* findMulticastInterface(omnetpp::cModule* context, const char* preferredName = "eth0")
+{
+    omnetpp::cModule* host = inet::getContainingNode(context);
+    auto interfaceTable = dynamic_cast<inet::IInterfaceTable*>(host->getSubmodule("interfaceTable"));
+    if (!interfaceTable)
+        throw omnetpp::cRuntimeError("No interfaceTable in %s", host->getFullPath().c_str());
+    if (preferredName && *preferredName) {
+        if (auto networkInterface = interfaceTable->findInterfaceByName(preferredName))
+            return networkInterface;
+    }
+    for (int i = 0; i < interfaceTable->getNumInterfaces(); ++i) {
+        auto networkInterface = interfaceTable->getInterface(i);
+        if (!networkInterface->isLoopback())
+            return networkInterface;
+    }
+    throw omnetpp::cRuntimeError("No multicast capable interface in %s", host->getFullPath().c_str());
+}
+
+} // namespace SOA4CoRE
+
+#endif

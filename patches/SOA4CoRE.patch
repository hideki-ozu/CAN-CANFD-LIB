diff --git a/src-inet4/soa4core/test/someip/SomeIpCodecSelfTest.cc b/src-inet4/soa4core/test/someip/SomeIpCodecSelfTest.cc
new file mode 100644
index 0000000..2801285
--- /dev/null
+++ b/src-inet4/soa4core/test/someip/SomeIpCodecSelfTest.cc
@@ -0,0 +1,275 @@
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Lesser General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// INET4 port: SOME/IP codec self-test. Golden vectors were written by hand from the
+// AUTOSAR PRS_SOMEIP / PRS_SOMEIPSD field tables, independent of the serializer code.
+//
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "inet/common/packet/Packet.h"
+#include "inet/common/packet/chunk/BytesChunk.h"
+#include "soa4core/messages/someip/SomeIpSd.h"
+
+using namespace omnetpp;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+using Bytes = std::vector<uint8_t>;
+
+class SomeIpCodecSelfTest : public cSimpleModule
+{
+    int passed = 0, failed = 0;
+
+    void check(const std::string& name, bool condition)
+    {
+        condition ? ++passed : ++failed;
+        EV_INFO << "CHECK " << name << (condition ? " PASS" : " FAIL") << endl;
+        if (!condition)
+            std::cout << "SOME/IP self-test FAILED: " << name << endl;
+    }
+
+    static Bytes serialize(const std::vector<Ptr<const Chunk>>& chunks)
+    {
+        Packet packet("golden");
+        for (const auto& chunk : chunks)
+            packet.insertAtBack(chunk);
+        return packet.peekAllAsBytes()->getBytes();
+    }
+
+    static Ptr<const SomeIpSDHeader> deserializeSd(const Bytes& bytes)
+    {
+        Packet packet("rx", makeShared<BytesChunk>(bytes));
+        return packet.peekAtFront<SomeIpSDHeader>(b(-1), Chunk::PF_ALLOW_INCORRECT);
+    }
+
+    static Bytes concat(std::initializer_list<Bytes> parts)
+    {
+        Bytes result;
+        for (const auto& part : parts)
+            result.insert(result.end(), part.begin(), part.end());
+        return result;
+    }
+
+    // Find service 1 instance 1, session 1, reboot+unicast.
+    static Bytes goldenFind()
+    {
+        return {0xff, 0xff, 0x81, 0x00, 0x00, 0x00, 0x00, 0x24, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x02, 0x00,
+                0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
+                0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+                0x00, 0x00, 0x00, 0x00};
+    }
+
+    // Offer service 1 instance 1 with UDP endpoint 10.0.0.1:3171, multicast 225.0.1.42:13171
+    // and configuration "soa4core.pcp=3"; session 0x0102, unicast flag only.
+    static Bytes goldenOffer()
+    {
+        Bytes config = {0x00, 0x11, 0x01, 0x00, 0x0e};
+        const std::string item = "soa4core.pcp=3";
+        config.insert(config.end(), item.begin(), item.end());
+        config.push_back(0x00);
+        return concat({
+            {0xff, 0xff, 0x81, 0x00, 0x00, 0x00, 0x00, 0x50, 0x00, 0x00, 0x01, 0x02, 0x01, 0x01, 0x02, 0x00,
+             0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
+             0x01, 0x00, 0x00, 0x30, 0x00, 0x01, 0x00, 0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+             0x00, 0x00, 0x00, 0x2c,
+             0x00, 0x09, 0x04, 0x00, 0x0a, 0x00, 0x00, 0x01, 0x00, 0x11, 0x0c, 0x63,
+             0x00, 0x09, 0x14, 0x00, 0xe1, 0x00, 0x01, 0x2a, 0x00, 0x11, 0x33, 0x73},
+            config});
+    }
+
+    // SubscribeEventgroup service 1 instance 1, TTL 3, eventgroup 1, TCP endpoint 10.0.0.2:3172.
+    static Bytes goldenSubscribe()
+    {
+        return {0xff, 0xff, 0x81, 0x00, 0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x00, 0x03, 0x01, 0x01, 0x02, 0x00,
+                0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
+                0x06, 0x00, 0x00, 0x10, 0x00, 0x01, 0x00, 0x01, 0xff, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x01,
+                0x00, 0x00, 0x00, 0x0c,
+                0x00, 0x09, 0x04, 0x00, 0x0a, 0x00, 0x00, 0x02, 0x00, 0x06, 0x0c, 0x64};
+    }
+
+    // SubscribeEventgroupAck (Nack: TTL 0) service 0x1234 instance 0xabcd, counter 5,
+    // eventgroup 0x0102, no options; distinguishes the counter nibble from the reserved bits.
+    static Bytes goldenNackWithCounter()
+    {
+        return {0xff, 0xff, 0x81, 0x00, 0x00, 0x00, 0x00, 0x24, 0x00, 0x00, 0xff, 0xfe, 0x01, 0x01, 0x02, 0x00,
+                0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
+                0x07, 0x00, 0x00, 0x00, 0x12, 0x34, 0xab, 0xcd, 0x01, 0x00, 0x00, 0x00, 0x00, 0x05, 0x01, 0x02,
+                0x00, 0x00, 0x00, 0x00};
+    }
+
+    // Notification service 1 event 0x8001, session 0x2a, 4 payload bytes.
+    static Bytes goldenNotification()
+    {
+        return {0x00, 0x01, 0x80, 0x01, 0x00, 0x00, 0x00, 0x0c, 0x00, 0x00, 0x00, 0x2a, 0x01, 0x01, 0x02, 0x00,
+                0xde, 0xad, 0xbe, 0xef};
+    }
+
+    static SomeIpSDEntry serviceEntry(SomeIpSDEntryType type, int numOptions)
+    {
+        SomeIpSDEntry entry;
+        entry.setType(type);
+        entry.setNum1stOptions(numOptions);
+        entry.setServiceId(1);
+        entry.setInstanceId(1);
+        entry.setMajorVersion(0xff);
+        entry.setTtl(0xffffff);
+        entry.setMinorVersion(0xffffffff);
+        return entry;
+    }
+
+    void checkEncoding()
+    {
+        auto find = makeShared<SomeIpSDHeader>();
+        find->setSessionId(1);
+        find->appendEntries(serviceEntry(FIND, 0));
+        finalizeSomeIpSd(*find);
+        check("encode-sd-find-golden", serialize({find}) == goldenFind());
+
+        auto offer = makeShared<SomeIpSDHeader>();
+        offer->setSessionId(0x0102);
+        offer->setFlags(SOMEIP_SD_FLAG_UNICAST);
+        offer->appendOptions(makeIpv4Option(IPV4ENDPOINT, Ipv4Address("10.0.0.1"), 0x11, 3171));
+        offer->appendOptions(makeIpv4Option(IPV4MULTICAST, Ipv4Address("225.0.1.42"), 0x11, 13171));
+        offer->appendOptions(makeConfigurationOption({{"soa4core.pcp", "3"}}));
+        offer->appendEntries(serviceEntry(OFFER, 3));
+        finalizeSomeIpSd(*offer);
+        check("encode-sd-offer-options-golden", serialize({offer}) == goldenOffer());
+        check("sd-offer-chunk-length", offer->getChunkLength() == B(goldenOffer().size()));
+
+        auto subscribe = makeShared<SomeIpSDHeader>();
+        subscribe->setSessionId(3);
+        SomeIpSDEntry entry;
+        entry.setType(SUBSCRIBEVENTGROUP);
+        entry.setNum1stOptions(1);
+        entry.setServiceId(1);
+        entry.setInstanceId(1);
+        entry.setMajorVersion(0xff);
+        entry.setTtl(3);
+        entry.setEventgroupId(1);
+        subscribe->appendEntries(entry);
+        subscribe->appendOptions(makeIpv4Option(IPV4ENDPOINT, Ipv4Address("10.0.0.2"), 0x06, 3172));
+        finalizeSomeIpSd(*subscribe);
+        check("encode-sd-subscribe-eventgroup-golden", serialize({subscribe}) == goldenSubscribe());
+
+        auto nack = makeShared<SomeIpSDHeader>();
+        nack->setSessionId(0xfffe);
+        nack->setFlags(SOMEIP_SD_FLAG_UNICAST);
+        SomeIpSDEntry nackEntry;
+        nackEntry.setType(SUBSCRIBEVENTGROUPACK);
+        nackEntry.setServiceId(0x1234);
+        nackEntry.setInstanceId(0xabcd);
+        nackEntry.setMajorVersion(1);
+        nackEntry.setTtl(0);
+        nackEntry.setCounter(5);
+        nackEntry.setEventgroupId(0x0102);
+        nack->appendEntries(nackEntry);
+        finalizeSomeIpSd(*nack);
+        check("encode-sd-nack-counter-golden", serialize({nack}) == goldenNackWithCounter());
+
+        auto header = makeShared<SomeIpHeader>();
+        header->setServiceId(1);
+        header->setMethodId(0x8001);
+        header->setSessionId(0x2a);
+        finalizeSomeIpHeader(*header, 4);
+        check("encode-someip-notification-golden",
+              serialize({header, makeShared<BytesChunk>(Bytes{0xde, 0xad, 0xbe, 0xef})}) == goldenNotification());
+    }
+
+    void checkDecoding()
+    {
+        auto find = deserializeSd(goldenFind());
+        check("decode-sd-find", find->isCorrect() && find->getServiceId() == 0xffff && find->getMethodId() == 0x8100
+                && find->getSessionId() == 1 && find->getFlags() == 0xc0 && find->getEntriesArraySize() == 1
+                && find->getOptionsArraySize() == 0 && find->getEntries(0).getType() == FIND
+                && find->getEntries(0).getMinorVersion() == 0xffffffff && find->getEntries(0).getTtl() == 0xffffff);
+
+        auto offer = deserializeSd(goldenOffer());
+        bool ok = offer->isCorrect() && offer->getFlags() == 0x40 && offer->getEntriesArraySize() == 1
+                && offer->getOptionsArraySize() == 3 && offer->getEntries(0).getNum1stOptions() == 3
+                && offer->getOptions(0).getType() == IPV4ENDPOINT && offer->getOptions(0).getIpv4Address() == Ipv4Address("10.0.0.1")
+                && offer->getOptions(0).getL4Protocol() == 0x11 && offer->getOptions(0).getPort() == 3171
+                && offer->getOptions(1).getType() == IPV4MULTICAST && offer->getOptions(1).getIpv4Address() == Ipv4Address("225.0.1.42")
+                && offer->getOptions(1).getPort() == 13171 && offer->getOptions(2).getType() == CONFIGURATION;
+        const ConfigurationItems items = parseConfiguration(offer->getOptions(2).getConfiguration());
+        check("decode-sd-offer-options", ok && items.size() == 1 && items[0].first == "soa4core.pcp" && items[0].second == "3");
+
+        auto subscribe = deserializeSd(goldenSubscribe());
+        check("decode-sd-subscribe-eventgroup", subscribe->isCorrect() && subscribe->getEntries(0).getType() == SUBSCRIBEVENTGROUP
+                && subscribe->getEntries(0).getEventgroupId() == 1 && subscribe->getEntries(0).getTtl() == 3
+                && subscribe->getEntries(0).getCounter() == 0 && subscribe->getOptions(0).getL4Protocol() == 0x06
+                && subscribe->getOptions(0).getPort() == 3172);
+        check("decode-sd-length-field", subscribe->getLength() == 0x30 && subscribe->getChunkLength() == B(goldenSubscribe().size()));
+
+        // A length field that disagrees with the parsed structure must survive decoding so the receiver can reject it.
+        Bytes wrongLength = goldenSubscribe();
+        wrongLength[7] = 0x34;
+        auto mismatched = deserializeSd(wrongLength);
+        check("decode-sd-keeps-received-length", mismatched->getLength() == 0x34
+                && mismatched->getChunkLength() == B(goldenSubscribe().size()));
+
+        auto nack = deserializeSd(goldenNackWithCounter());
+        check("decode-sd-nack-counter", nack->isCorrect() && nack->getSessionId() == 0xfffe && nack->getEntries(0).getType() == SUBSCRIBEVENTGROUPACK
+                && nack->getEntries(0).getTtl() == 0 && nack->getEntries(0).getCounter() == 5
+                && nack->getEntries(0).getEventgroupId() == 0x0102 && nack->getEntries(0).getServiceId() == 0x1234
+                && nack->getEntries(0).getInstanceId() == 0xabcd && nack->getEntries(0).getMajorVersion() == 1);
+
+        Packet notification("rx", makeShared<BytesChunk>(goldenNotification()));
+        const auto& header = notification.popAtFront<SomeIpHeader>(b(-1), Chunk::PF_ALLOW_INCORRECT);
+        check("decode-someip-notification", header->isCorrect() && header->getServiceId() == 1 && header->getMethodId() == 0x8001
+                && header->getLength() == 12 && header->getClientId() == 0 && header->getSessionId() == 0x2a
+                && header->getMessageType() == NOTIFICATION && header->getReturnCode() == E_OK
+                && notification.getDataLength() == B(4));
+
+        // Two concatenated options of unknown type (0x42, length 5) are skipped, not rejected.
+        Bytes unknown = goldenFind();
+        unknown[7] = 0x24 + 8;
+        unknown.resize(40);
+        unknown.insert(unknown.end(), {0x00, 0x00, 0x00, 0x08, 0x00, 0x05, 0x42, 0x80, 0x01, 0x02, 0x03, 0x04});
+        auto withUnknown = deserializeSd(unknown);
+        check("decode-unknown-option-skipped", withUnknown->isCorrect() && withUnknown->getOptionsArraySize() == 1
+                && withUnknown->getOptions(0).getType() == 0x42 && withUnknown->getOptions(0).getUnknownLength() == 5
+                && withUnknown->getOptions(0).getDiscardable());
+    }
+
+    void expectIncorrect(const std::string& name, const Bytes& bytes)
+    {
+        auto header = deserializeSd(bytes);
+        check(name, header->isIncorrect());
+    }
+
+    void checkRejection()
+    {
+        auto mutate = [](Bytes b, std::function<void(Bytes&)> change) { change(b); return b; };
+        expectIncorrect("reject-entries-length-not-multiple-of-16", mutate(goldenFind(), [](Bytes& b) { b[23] = 0x0f; }));
+        expectIncorrect("reject-entries-length-overrun", mutate(goldenFind(), [](Bytes& b) { b[23] = 0x20; }));
+        expectIncorrect("reject-options-length-overrun", mutate(goldenSubscribe(), [](Bytes& b) { b[43] = 0x20; }));
+        expectIncorrect("reject-option-length-overrun", mutate(goldenSubscribe(), [](Bytes& b) { b[45] = 0x10; }));
+        expectIncorrect("reject-ipv4-option-wrong-length", mutate(goldenSubscribe(), [](Bytes& b) { b[45] = 0x08; b[43] = 0x0b; b.pop_back(); }));
+        expectIncorrect("reject-configuration-without-terminator", mutate(goldenOffer(), [](Bytes& b) { b.back() = 0x41; }));
+        Packet shortHeader("rx", makeShared<BytesChunk>(Bytes{0x00, 0x01, 0x80, 0x01, 0x00, 0x00, 0x00, 0x04,
+                                                             0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x02, 0x00}));
+        check("reject-someip-length-below-8", shortHeader.peekAtFront<SomeIpHeader>(b(-1), Chunk::PF_ALLOW_INCORRECT)->isIncorrect());
+    }
+
+    virtual void initialize() override
+    {
+        checkEncoding();
+        checkDecoding();
+        checkRejection();
+        recordScalar("checksPassed", passed);
+        recordScalar("checksFailed", failed);
+        std::cout << "SOME/IP self-test: " << passed << " passed, " << failed << " failed" << endl;
+    }
+
+    virtual void handleMessage(cMessage *message) override { delete message; }
+};
+
+Define_Module(SomeIpCodecSelfTest);
+
+} // namespace SOA4CoRE
diff --git a/src-inet4/soa4core/test/someip/SomeIpCodecSelfTest.ned b/src-inet4/soa4core/test/someip/SomeIpCodecSelfTest.ned

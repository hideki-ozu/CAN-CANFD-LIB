+// along with this program.  If not, see http://www.gnu.org/licenses/.
+//
+// INET4 port: the CoRE4INET real-time IP stack (IPv4oREBase filters, SRP talker
+// registration) is replaced by INET4 request tags. With pcp/vlan_id set, every
+// packet carries PcpReq/VlanReq, which an INET4 802.1Q layer (e.g. TsnDevice with
+// hasOutgoingStreams) turns into a C-tag. Dynamic SRP reservation is not supported.
+//
+
+#ifndef __SOA4CORE_IPPUBLISHERENDPOINTBASE_H_
+#define __SOA4CORE_IPPUBLISHERENDPOINTBASE_H_
+
+#include "soa4core/endpoints/publisher/base/PublisherEndpointBase.h"
+
+#include "inet/common/packet/Packet.h"
+#include "inet/networklayer/contract/ipv4/Ipv4Address.h"
+
+namespace SOA4CoRE {
+
+class IPPublisherEndpointBase : public PublisherEndpointBase
+{
+public:
+    bool has8021QInformation();
+
+protected:
+    virtual void initialize() override;
+    virtual void handleParameterChange(const char* parname) override;
+
+    // Payload packet for one application message: byte-count payload whose
+    // CreationTimeTag carries the publisher's timestamp, plus PCP/VLAN request tags.
+    inet::Packet* createPayloadPacket(cPacket* applicationMessage);
+    void addStreamTags(inet::Packet* packet);
+    // Legacy SRP reservation hook: rejects registerStream=true (not portable to INET4).
+    void checkStreamReservation();
+
+    virtual uint16_t calculateL2Framesize(uint16_t payload);
+    virtual size_t getHeaderBytes();
+    size_t getMaxPhysicalFrameSize();
+    virtual uint64_t createStreamId(inet::Ipv4Address destAddress);
+
+protected:
+    std::string _localAddress;
+    int _localPort;
+    int _vlanID = -1;
+    int _pcp = -1;
+    bool _registerStream = false;
+    bool _advertiseStreamRegistration = false;
+};
+
+} /*end namespace SOA4CoRE*/
+
+#endif
diff --git a/src-inet4/soa4core/endpoints/publisher/ip/base/IPPublisherEndpointBase.ned b/src-inet4/soa4core/endpoints/publisher/ip/base/IPPublisherEndpointBase.ned

+// along with this program.  If not, see http://www.gnu.org/licenses/.
+//
+
+#include "soa4core/discovery/someip/SomeIpSD.h"
+#include "soa4core/manager/someip/SomeIpManager.h"
+#include "soa4core/serviceidentifier/ServiceIdentifier.h"
+#include "soa4core/utility/networkInterfaces.h"
+
+#include "inet/common/ModuleAccess.h"
+#include "inet/networklayer/common/IpProtocolId_m.h"
+#include "inet/networklayer/common/L3AddressResolver.h"
+#include "inet/networklayer/common/L3AddressTag_m.h"
+
+#include <sstream>
+
+using namespace std;
+using namespace inet;
+
+namespace SOA4CoRE {
+
+#define MAJOR_VERSION 0xFF       // any version, see [PRS_SOMEIPSD_00351],[PRS_SOMEIPSD_00356]
+#define MINOR_VERSION 0xFFFFFFFF // any version, see [PRS_SOMEIPSD_00351],[PRS_SOMEIPSD_00356]
+
+Define_Module(SomeIpSD);
+
+void SomeIpSD::initialize(int stage) {
+    if (stage == INITSTAGE_LOCAL) {
+        gate("udpOut")->connectTo(getParentModule()->gate("sdUDPOut"));
+        getParentModule()->gate("sdUDPIn")->connectTo(gate("udpIn"));
+        _localPort = par("localPort");
+        _destPort = par("destPort");
+        _mcastDestAddress = L3Address(par("mcastDestAddress").stringValue());
+        _ttl = par("ttl").intValue();
+        if (_ttl > 0xFFFFFF)
+            throw cRuntimeError("SOME/IP-SD TTL is a 24 bit value");
+        _includeIEEE8021QConfig = par("includeIEEE8021QConfig").boolValue();
+        _includeRessourceConfig = par("includeRessourceConfig").boolValue();
+        _includeRealTimeConfig = par("includeRealTimeConfig").boolValue();
+        IServiceDiscovery::_serviceOfferSignal = registerSignal("serviceOfferSignal");
+        _serviceFindSignal = registerSignal("serviceFindSignal");
+        _subscribeEventGroupSignal = registerSignal("subscribeEventGroupSignal");
+        _subscribeEventGroupAckSignal = registerSignal("subscribeEventGroupAckSignal");
+    }
+    else if (stage == INITSTAGE_ROUTING_PROTOCOLS) {
+        _hasQoSNP = getParentModule()->par("hasQoSNP");
+        if (_hasQoSNP)
+            throw cRuntimeError("The QoS negotiation protocol is not part of the INET4 port (set hasQoSNP = false).");
+        if (SomeIpManager* manager = dynamic_cast<SomeIpManager*>(getParentModule()->getSubmodule("sm"))) {
+            manager->subscribe("findResultSignal", this);
+            manager->subscribe("subscribeSignal", this);
+            manager->subscribe("subscribeAckSignal", this);
+        } else {
+            throw cRuntimeError("SomeIpManager is needed for SOME/IP Discovery.");
+        }
+    }
+    else if (stage == INITSTAGE_APPLICATION_LAYER) {
+        if (!(par("localAddress").stdstringValue().length())) {
+            throw cRuntimeError("Please define a local ip address");
+        }
+        _localAddress = L3AddressResolver().resolve(par("localAddress").stringValue());
+        _socket.setOutputGate(gate("udpOut"));
+        _socket.setCallback(this);
+        _socket.setReuseAddress(true);
+        _socket.bind(L3Address(), _localPort);
+        NetworkInterface* networkInterface = findMulticastInterface(this, par("multicastInterface").stringValue());
+        _socket.setMulticastOutputInterface(networkInterface->getInterfaceId());
+        _socket.setMulticastLoop(false);
+        _socket.joinMulticastGroup(_mcastDestAddress, networkInterface->getInterfaceId());
+    }
+}
+
+void SomeIpSD::handleMessage(cMessage *msg) {
+    if (_socket.belongsToSocket(msg))
+        _socket.processMessage(msg);
+    else
+        delete msg;
+}
+
+void SomeIpSD::socketDataArrived(UdpSocket *socket, Packet *packet) {
+    const L3Address source = packet->getTag<L3AddressInd>()->getSrcAddress();
+    if (source == _localAddress) {
+        delete packet;
+        return;
+    }
+    ++_numReceived;
+    const auto& header = packet->peekAtFront<SomeIpSDHeader>(b(-1), Chunk::PF_ALLOW_INCORRECT);
+    if (header->isIncorrect() || header->getServiceId() != SOMEIP_SD_SERVICE_ID || header->getMethodId() != SOMEIP_SD_METHOD_ID
+            || header->getProtocolVersion() != PV_1 || header->getMessageType() != NOTIFICATION || header->getClientId() != 0
+            || B(header->getLength() + 8) != B(header->getChunkLength())) {
+        EV_WARN << "Dropping malformed SOME/IP-SD message from " << source << endl;
+        ++_numInvalid;
+    }
+    else
+        processSomeIpSDHeader(*header, source);
+    delete packet;
+}
+
+void SomeIpSD::socketErrorArrived(UdpSocket *socket, Indication *indication) {
+    EV_WARN << "Ignoring UDP error report " << indication->getName() << endl;
+    delete indication;
+}
+
+SomeIpSDEntry SomeIpSD::createEntry(SomeIpSDEntryType type, uint16_t serviceId, uint16_t instanceId, int numOptions) {
+    SomeIpSDEntry entry;
+    entry.setType(type);
+    entry.setIndex1stOptions(0);
+    entry.setIndex2ndOptions(0);
+    entry.setNum1stOptions(numOptions);
+    entry.setNum2ndOptions(0);
+    entry.setServiceId(serviceId);
+    entry.setInstanceId(instanceId);
+    entry.setMajorVersion(MAJOR_VERSION);
+    entry.setTtl(_ttl);
+    entry.setMinorVersion(MINOR_VERSION);
+    return entry;
+}
+
+void SomeIpSD::find(uint16_t serviceID, uint16_t instanceID) {
+    Enter_Method("SomeIpSD::find");
+    auto header = makeShared<SomeIpSDHeader>();
+    header->appendEntries(createEntry(FIND, serviceID, instanceID, 0));
+    sendTo(header, "SOME/IP SD - FIND");
+}
+
+void SomeIpSD::offer(SomeIpDiscoveryNotification* notification) {
+    Enter_Method("SomeIpSD::offer");
+    auto header = makeShared<SomeIpSDHeader>();
+    for (QoSGroup qosGroup : notification->getQoSGroups())
+        header->appendOptions(createIpv4Endpoint(notification, qosGroup));
+    if (!notification->getPreventReservation()) {
+        // SOA4CoRE QoS attributes as AUTOSAR configuration option items (PRS_SOMEIPSD_00437).
+        if (_includeIEEE8021QConfig && notification->getPcp() >= 0 && notification->getVlanId() >= 0)
+            header->appendOptions(makeConfigurationOption({{"soa4core.pcp", to_string(notification->getPcp())},
+                                                          {"soa4core.vlan", to_string(notification->getVlanId())}}));
+        if (_includeRessourceConfig && notification->getIntervalMin() > 0) {
+            ostringstream interval;
+            interval << notification->getIntervalMin();
+            header->appendOptions(makeConfigurationOption({{"soa4core.maxPayload", to_string(notification->getPayloadMax())},
+                                                          {"soa4core.minInterval", interval.str()}}));
+        }
+        if (_includeRealTimeConfig && notification->getDeadline() > 0) {
+            ostringstream deadline;
+            deadline << notification->getDeadline();
+            header->appendOptions(makeConfigurationOption({{"soa4core.deadline", deadline.str()}}));
+        }
+    }
+    header->appendEntries(createEntry(OFFER, notification->getServiceId(), notification->getInstanceId(), header->getOptionsArraySize()));
+    sendTo(header, "SOME/IP SD - OFFER", notification->getAddress());
+}
+
+void SomeIpSD::subscribeEventgroup(SomeIpDiscoveryNotification* notification) {
+    Enter_Method("SomeIpSD::subscribeEventgroup");
+    auto header = makeShared<SomeIpSDHeader>();
+    header->appendOptions(createIpv4Endpoint(notification));
+    if (_includeRealTimeConfig && notification->getDeadline() > 0) {
+        ostringstream deadline;
+        deadline << notification->getDeadline();
+        header->appendOptions(makeConfigurationOption({{"soa4core.deadline", deadline.str()}}));
+    }
+    SomeIpSDEntry entry = createEntry(SUBSCRIBEVENTGROUP, notification->getServiceId(), notification->getInstanceId(), header->getOptionsArraySize());
+    entry.setEventgroupId(notification->getEventgroupId());
+    header->appendEntries(entry);
+    sendTo(header, "SOME/IP SD - SUBSCRIBEVENTGROUP", notification->getAddress());
+}
+
+void SomeIpSD::subscribeEventgroupAck(SomeIpDiscoveryNotification* notification) {
+    Enter_Method("SomeIpSD::subscribeEventgroupAck");
+    auto header = makeShared<SomeIpSDHeader>();
+    header->appendOptions(createIpv4Endpoint(notification));
+    SomeIpSDEntry entry = createEntry(SUBSCRIBEVENTGROUPACK, notification->getServiceId(), notification->getInstanceId(), 1);
+    entry.setEventgroupId(notification->getEventgroupId());
+    header->appendEntries(entry);
+    sendTo(header, "SOME/IP SD - SUBSCRIBEVENTGROUPACK", notification->getAddress());
+}
+
+void SomeIpSD::processSomeIpSDHeader(const SomeIpSDHeader& header, const L3Address& source) {
+    for (size_t i = 0; i < header.getEntriesArraySize(); ++i) {
+        const SomeIpSDEntry& entry = header.getEntries(i);
+        ++_entriesReceived[entry.getType()];
+        if (entry.getTtl() == 0 && entry.getType() != FIND) {
+            EV << "Ignoring stop/nack entry (TTL 0)" << endl;  // StopOffer/StopSubscribe/Nack are not modelled
+            continue;
+        }
+        switch (entry.getType()) {
+            case FIND:
+                processFindEntry(entry, source);
+                break;
+            case OFFER:
+                processOfferEntry(entry, header, source);
+                break;
+            case SUBSCRIBEVENTGROUP:
+                processSubscribeEventGroupEntry(entry, header, source);
+                break;
+            case SUBSCRIBEVENTGROUPACK:
+                processSubscribeEventGroupAckEntry(entry, header, source);
+                break;
+            default:
+                EV << "Unknown SOME/IP-SD entry type " << int(entry.getType()) << endl;
+        }
+    }
+}
+
+bool SomeIpSD::getReferencedOptions(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, vector<const SomeIpSDOption*>& options) {
+    // [PRS_SOMEIPSD_00341]: an entry references up to two option runs; a run with zero options has no index
+    const size_t runs[2][2] = {
+        { entry.getIndex1stOptions(), entry.getNum1stOptions() },
+        { entry.getIndex2ndOptions(), entry.getNum2ndOptions() },
+    };
+    for (const auto& run : runs) {
+        if (run[1] != 0 && run[0] + run[1] > header.getOptionsArraySize()) {
+            ++_numInvalidOptionReferences;
+            return false;
+        }
+    }
+    for (const auto& run : runs)
+        for (size_t i = run[0]; i < run[0] + run[1]; ++i)
+            options.push_back(&header.getOptions(i));
+    return true;
+}
+
+void SomeIpSD::processFindEntry(const SomeIpSDEntry& entry, const L3Address& source) {
+    SomeIpDiscoveryNotification* notification = new SomeIpDiscoveryNotification(entry.getServiceId(),
+            source, entry.getInstanceId(), set<QoSGroup>{}, QoSGroup::UNDEFINED, -1, -1);
+    emit(_serviceFindSignal, notification);
+}
+
+void SomeIpSD::processFindResult(cObject* obj) {
+    SomeIpDiscoveryNotification* notification = dynamic_cast<SomeIpDiscoveryNotification*>(obj);
+    if (!notification) {
+        throw cRuntimeError("The discovery notification must be of type SomeIpDiscoveryNotification.");
+    }
+    offer(notification);
+    delete obj;
+}
+
+void SomeIpSD::processOfferEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const L3Address& source) {
+    vector<const SomeIpSDOption*> options;
+    if (!getReferencedOptions(entry, header, options))
+        return;
+    SomeIpDiscoveryNotification* notification = new SomeIpDiscoveryNotification();
+    notification->setServiceId(entry.getServiceId());
+    notification->setInstanceId(entry.getInstanceId());
+    for (const SomeIpSDOption* option : options) {
+        if (isIpv4EndpointLikeOption(*option))
+            notification->updateFromEndpointOption(*option);
+        else if (option->getType() != CONFIGURATION && !option->getDiscardable())
+            EV_WARN << "Ignoring unsupported SOME/IP-SD option type " << int(option->getType()) << endl;
+    }
+    if (notification->getAddress().isUnspecified()) {
+        if (notification->getMcastDestAddr().isUnspecified()) {
+            EV_WARN << "Offer without endpoint option ignored" << endl;
+            delete notification;
+            return;
+        }
+        notification->setAddress(source);
+    }
+    emit(_serviceOfferSignal, notification);
+}
+
+void SomeIpSD::processSubscribeEventGroupEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const L3Address& source) {
+    vector<const SomeIpSDOption*> options;
+    if (!getReferencedOptions(entry, header, options))
+        return;
+    for (const SomeIpSDOption* option : options) {
+        if (!isIpv4EndpointLikeOption(*option))
+            continue;
+        SomeIpDiscoveryNotification* notification = new SomeIpDiscoveryNotification();
+        notification->setServiceId(entry.getServiceId());
+        notification->setInstanceId(entry.getInstanceId());
+        notification->setEventgroupId(entry.getEventgroupId());
+        notification->updateFromEndpointOption(*option);
+        notification->setQosGroup(*(notification->getQoSGroups().begin()));
+        if (notification->getAddress().isUnspecified())
+            notification->setAddress(source);
+        emit(_subscribeEventGroupSignal, notification);
+    }
+}
+
+void SomeIpSD::processSubscribeEventGroupAckEntry(const SomeIpSDEntry& entry, const SomeIpSDHeader& header, const L3Address& source) {
+    vector<const SomeIpSDOption*> options;
+    if (!getReferencedOptions(entry, header, options))
+        return;
+    SomeIpDiscoveryNotification* notification = new SomeIpDiscoveryNotification();
+    notification->setServiceId(entry.getServiceId());
+    notification->setInstanceId(entry.getInstanceId());
+    notification->setEventgroupId(entry.getEventgroupId());
+    for (const SomeIpSDOption* option : options) {
+        if (isIpv4EndpointLikeOption(*option))
+            notification->updateFromEndpointOption(*option);
+    }
+    if (notification->getAddress().isUnspecified())
+        notification->setAddress(source);
+    emit(_subscribeEventGroupAckSignal, notification);
+}
+
+void SomeIpSD::discover(ServiceIdentifier serviceIdentifier) {
+    find(serviceIdentifier.getServiceId(), serviceIdentifier.getInstanceId());
+}
+
+void SomeIpSD::processSubscription(cObject* obj) {
+    SomeIpDiscoveryNotification* notification = dynamic_cast<SomeIpDiscoveryNotification*>(obj);
+    if (!notification) {
+        throw cRuntimeError("The discovery notification must be of type SomeIpDiscoveryNotification");
+    }
+    subscribeEventgroup(notification);
+    delete obj;
+}
+
+void SomeIpSD::processAcknowledgment(cObject *obj) {
+    SomeIpDiscoveryNotification* notification = dynamic_cast<SomeIpDiscoveryNotification*>(obj);
+    if (!notification) {
+        throw cRuntimeError("The discovery notification must be of type SomeIpDiscoveryNotification");
+    }
+    subscribeEventgroupAck(notification);
+    delete obj;
+}
+
+void SomeIpSD::receiveSignal(cComponent *source, simsignal_t signalID, cObject *obj, cObject *details) {
+    if (!strcmp(getSignalName(signalID), "findResultSignal")) {
+        processFindResult(obj);
+    } else if (!strcmp(getSignalName(signalID), "subscribeSignal")) {
+        processSubscription(obj);
+    } else if (!strcmp(getSignalName(signalID), "subscribeAckSignal")) {
+        processAcknowledgment(obj);
+    } else {
+        throw cRuntimeError("Unknown signal.");
+    }
+}
+
+SomeIpSDOption SomeIpSD::createIpv4Endpoint(SomeIpDiscoveryNotification* notification, QoSGroup qosGroup) {
+    if (qosGroup == QoSGroup::UNDEFINED) {
+        qosGroup = notification->getQoSGroup();
+    }
+    switch (qosGroup) {
+        case QoSGroup::SOMEIP_TCP:
+            return makeIpv4Option(IPV4ENDPOINT, _localAddress.toIpv4(), IP_PROT_TCP, notification->getTcpPort());
+        case QoSGroup::SOMEIP_UDP:
+            return makeIpv4Option(IPV4ENDPOINT, _localAddress.toIpv4(), IP_PROT_UDP, notification->getUdpPort());
+        case QoSGroup::SOMEIP_UDP_MCAST:
+            if (notification->getMcastDestAddr().isUnspecified() || notification->getMcastDestPort() < 0) {
+                throw cRuntimeError("MCast QoS selected but no mcast endpoint information set.");
+            }
+            return makeIpv4Option(IPV4MULTICAST, notification->getMcastDestAddr().toIpv4(), IP_PROT_UDP, notification->getMcastDestPort());
+        default:
+            throw cRuntimeError("Unknown QoSGroup");
+    }
+}
+
+void SomeIpSD::sendTo(Ptr<SomeIpSDHeader> header, const char *name, L3Address destIp, int destPort) {
+    if (destIp.isUnspecified()) {
+        destIp = _mcastDestAddress;
+    }
+    if (destPort == -1) {
+        destPort = _destPort;
+    }
+    SessionCounter& session = destIp.isMulticast() ? _multicastSession : _unicastSessions[destIp];
+    if (session.sessionId == 0xFFFF) {
+        session.sessionId = 1;
+        session.reboot = false;  // [PRS_SOMEIPSD_00152]: reboot flag cleared after the first wrap
+    }
+    else
+        ++session.sessionId;
+    header->setSessionId(session.sessionId);
+    header->setFlags((session.reboot ? SOMEIP_SD_FLAG_REBOOT : 0) | SOMEIP_SD_FLAG_UNICAST);
+    for (size_t i = 0; i < header->getEntriesArraySize(); ++i)
+        ++_entriesSent[header->getEntries(i).getType()];
+    finalizeSomeIpSd(*header);
+    Packet *packet = new Packet(name, header);
+    ++_numSent;
+    _socket.sendTo(packet, destIp, destPort);
+}
+
+void SomeIpSD::finish() {
+    recordScalar("sdMessagesSent", _numSent);
+    recordScalar("sdMessagesReceived", _numReceived);
+    recordScalar("sdMessagesInvalid", _numInvalid);
+    recordScalar("sdInvalidOptionReferences", _numInvalidOptionReferences);
+    const pair<int, const char *> names[] = {{FIND, "Find"}, {OFFER, "Offer"}, {SUBSCRIBEVENTGROUP, "Subscribe"}, {SUBSCRIBEVENTGROUPACK, "SubscribeAck"}};
+    for (const auto& name : names) {
+        recordScalar((string("sdEntriesSent") + name.second).c_str(), _entriesSent[name.first]);
+        recordScalar((string("sdEntriesReceived") + name.second).c_str(), _entriesReceived[name.first]);
+    }
+}
+
+} /* end namespace SOA4CoRE */

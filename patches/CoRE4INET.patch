+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Selected INET4 port of CoRE4INET BGTrafficSourceApp and its source-base behavior.
+#ifndef CORE4INET_BGTRAFFICSOURCEAPP_INET4_H
+#define CORE4INET_BGTRAFFICSOURCEAPP_INET4_H
+#include <omnetpp.h>
+#include <cmath>
+namespace CoRE4INET {
+using namespace omnetpp;
+class BGTrafficSourceApp : public cSimpleModule {
+  private:
+    cMessage *timer = nullptr;
+    simtime_t startTime, stopTime, sendInterval;
+    simsignal_t payloadSignal, intervalSignal, sentSignal, receivedSignal;
+    long sent = 0, received = 0;
+    bool isEnabled() const;
+    simtime_t readInterval();
+    void sendMessage();
+  protected:
+    void initialize() override;
+    void handleMessage(cMessage *msg) override;
+    void finish() override;
+  public:
+    ~BGTrafficSourceApp() override;
+};
+}
+#endif

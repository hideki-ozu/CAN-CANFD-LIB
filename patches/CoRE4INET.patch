@@ -13,6 +13,95 @@
 // along with this program.  If not, see http://www.gnu.org/licenses/.
 // 
 
+// INET4 build: migrate this upstream application's scheduling and payload
+// semantics; Ethernet encapsulation and NIC queue selection belong to INET4.
+#ifdef CORE4INET_INET4
+#include "core4inet/applications/trafficsource/base/BGTrafficSourceAppInet4.h"
+#include "inet/common/packet/Packet.h"
+#include "inet/common/packet/chunk/ByteCountChunk.h"
+#include "inet/common/ProtocolTag_m.h"
+#include "inet/common/Protocol.h"
+
+namespace CoRE4INET {
+Define_Module(BGTrafficSourceApp);
+
+BGTrafficSourceApp::~BGTrafficSourceApp()
+{
+    cancelAndDelete(timer);
+}
+
+void BGTrafficSourceApp::initialize()
+{
+    payloadSignal = registerSignal("payloadSignal");
+    intervalSignal = registerSignal("intervalSignal");
+    sentSignal = registerSignal("packetSent");
+    receivedSignal = registerSignal("packetReceived");
+    startTime = par("startTime");
+    stopTime = par("stopTime");
+    if (startTime < SIMTIME_ZERO || (stopTime >= SIMTIME_ZERO && stopTime < startTime))
+        throw cRuntimeError("Invalid startTime/stopTime parameters");
+    timer = new cMessage("start");
+    sendInterval = readInterval();
+    if (isEnabled())
+        scheduleAt(simTime() + startTime, timer);
+}
+
+bool BGTrafficSourceApp::isEnabled() const
+{
+    return par("enabled").boolValue() && (stopTime < SIMTIME_ZERO || simTime() < stopTime);
+}
+
+simtime_t BGTrafficSourceApp::readInterval()
+{
+    const double value = par("sendInterval").doubleValue();
+    if (!std::isfinite(value) || value <= 0)
+        throw cRuntimeError("sendInterval must be finite and strictly positive");
+    return value;
+}
+
+void BGTrafficSourceApp::handleMessage(cMessage *msg)
+{
+    if (msg == timer) {
+        if (isEnabled()) {
+            sendMessage();
+            // Preserve upstream ordering: use the cached interval, then sample
+            // the volatile parameter for the next invocation.
+            const simtime_t next = simTime() + sendInterval;
+            emit(intervalSignal, sendInterval);
+            sendInterval = readInterval();
+            if (stopTime < SIMTIME_ZERO || next < stopTime)
+                scheduleAt(next, timer);
+        }
+    }
+    else {
+        auto packet = check_and_cast<inet::Packet *>(msg);
+        ++received;
+        emit(receivedSignal, packet);
+        delete packet;
+    }
+}
+
+void BGTrafficSourceApp::sendMessage()
+{
+    const auto payload = par("payload").intValue();
+    if (payload < 0 || payload > 1500)
+        throw cRuntimeError("Ethernet payload must be between 0 and 1500 bytes");
+    emit(payloadSignal, static_cast<unsigned long>(payload));
+    auto packet = new inet::Packet("Best-Effort Traffic");
+    packet->insertAtBack(inet::makeShared<inet::ByteCountChunk>(inet::B(payload)));
+    packet->addTag<inet::PacketProtocolTag>()->setProtocol(&inet::Protocol::unknown);
+    ++sent;
+    emit(sentSignal, packet);
+    send(packet, "trafficOut");
+}
+
+void BGTrafficSourceApp::finish()
+{
+    recordScalar("packets sent", sent);
+    recordScalar("packets received", received);
+}
+} // namespace CoRE4INET
+#else
 #include "core4inet/applications/trafficsource/base/BGTrafficSourceApp.h"
 
 //CoRE4INET
@@ -130,3 +219,5 @@ inet::MACAddress BGTrafficSourceApp::getDestAddress()
 
 }
 //namespace
+
+#endif // CORE4INET_INET4
diff --git a/Makefile.inet4 b/Makefile.inet4
new file mode 100644
index 0000000..9f47944
--- /dev/null
+++ b/Makefile.inet4
@@ -0,0 +1,14 @@
+# Focused INET4 build profile; the original makefiles still build the legacy tree.
+# Usage: source ../../scripts/env.sh; make -f Makefile.inet4
+MODE ?= release
+INET_ROOT ?= $(abspath ../inet)
+PORT_BUILD := $(CURDIR)/out-inet4
+.PHONY: all configure clean
+all: configure
+	$(MAKE) -C $(PORT_BUILD) MODE=$(MODE)
+configure:
+	mkdir -p $(PORT_BUILD)
+	ln -sfn ../src/core4inet/applications/trafficsource/base/BGTrafficSourceApp.cc $(PORT_BUILD)/BGTrafficSourceApp.cc
+	cd $(PORT_BUILD) && opp_makemake --make-so -f -o CoRE4INET_INET4 -DCORE4INET_INET4 -I$(CURDIR)/src -I$(INET_ROOT)/src -L$(INET_ROOT)/src -lINET
+clean:
+	@if test -f $(PORT_BUILD)/Makefile; then $(MAKE) -C $(PORT_BUILD) clean; fi

@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+import inet.node.inet.StandardHost;
+import inet.node.ethernet.EthernetLink;
+
+network BackgroundTraffic
+{
+    submodules:
+        sender: StandardHost {
+            parameters:
+                numApps = 1;
+                numEthInterfaces = 1;
+        }
+        receiver: StandardHost {
+            parameters:
+                numApps = 1;
+                numEthInterfaces = 1;
+        }
+    connections:
+        sender.ethg[0] <--> EthernetLink { datarate = 100Mbps; delay = 1us; } <--> receiver.ethg[0];
+}

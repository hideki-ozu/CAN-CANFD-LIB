diff --git a/src-inet4/core4inet/applications/trafficsource/base/BGTrafficSourceApp.ned b/src-inet4/core4inet/applications/trafficsource/base/BGTrafficSourceApp.ned
new file mode 100644
index 0000000..2f23494
--- /dev/null
+++ b/src-inet4/core4inet/applications/trafficsource/base/BGTrafficSourceApp.ned
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+// INET4 NED profile of upstream BGTrafficSourceApp (Till Steinbach).
+package core4inet.applications.trafficsource.base;
+import inet.applications.contract.IApp;
+import inet.applications.ethernet.EthernetSocketIo;
+
+simple BGTrafficSourceEngine
+{
+    parameters:
+        @class(CoRE4INET::BGTrafficSourceApp);
+        bool enabled;
+        double startTime @unit(s);
+        double stopTime @unit(s);
+        volatile int payload @unit(Byte);
+        volatile double sendInterval @unit(s);
+        @signal[payloadSignal](type=unsigned long);
+        @signal[intervalSignal](type=simtime_t);
+        @signal[packetSent](type=inet::Packet);
+        @signal[packetReceived](type=inet::Packet);
+        @statistic[payloadOverTime](source=payloadSignal; record=vector,stats);
+        @statistic[sendIntervalOverTime](source=intervalSignal; record=vector,stats);
+        @statistic[packetSent](source=packetSent; record=count);
+        @statistic[packetReceived](source=packetReceived; record=count);
+    gates:
+        input trafficIn;
+        output trafficOut;
+}
+
+// Selected port: original periodic source semantics, INET4 socket/NIC path.
+// Set enabled=false to use this application as a background Ethernet sink.
+module BGTrafficSourceApp like IApp
+{
+    parameters:
+        string interfaceTableModule = default("^.interfaceTable");
+        string interface = default("eth0");
+        string destAddress = default("ff:ff:ff:ff:ff:ff");
+        string localAddress = default("");
+        bool enabled = default(true);
+        double startTime @unit(s) = default(0s);
+        double stopTime @unit(s) = default(-1s);
+        volatile int payload @unit(Byte) = default(46Byte);
+        volatile double sendInterval @unit(s) = default(uniform(0s,1s));
+        @application;
+        @display("i=block/source,green");
+    gates:
+        input socketIn;
+        output socketOut;
+    submodules:
+        source: BGTrafficSourceEngine {
+            parameters:
+                enabled = parent.enabled;
+                startTime = parent.startTime;
+                stopTime = parent.stopTime;
+                payload = parent.payload;
+                sendInterval = parent.sendInterval;
+        }
+        io: EthernetSocketIo {
+            parameters:
+                interfaceTableModule = absPath(parent.interfaceTableModule);
+                interface = parent.interface;
+                localAddress = parent.localAddress;
+                remoteAddress = parent.destAddress;
+                protocol = "unknown";
+        }
+    connections:
+        source.trafficOut --> io.trafficIn;
+        io.trafficOut --> source.trafficIn;
+        socketIn --> io.socketIn;
+        io.socketOut --> socketOut;
+}
